@startuml CU41-exc-nombre-duplicado
title CU-41 — Crear bodega (excepcion: nombre duplicado en la empresa)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_CrearBodega" as view
participant "C_RolesGuard" as guard
participant "C_BodegasController" as ctrl
participant "C_BodegasService" as svc
participant "C_TypeORM" as orm
participant "bodega" as bent

user -> view : Ingresa nombre, id_empresa\ny direccion (opcional)
activate view

view -> guard : POST /bodegas\n{ nombre, id_empresa, direccion }
activate guard

guard -> guard : Verifica JWT y rol\n(ADMIN | SUPERUSUARIO)
activate guard
deactivate guard

guard --> ctrl : Solicitud autorizada
deactivate guard
activate ctrl

ctrl -> svc : create(dto, actorId)
activate svc

svc -> orm : findOne({ nombre: dto.nombre,\nid_empresa: dto.id_empresa })
activate orm

orm -> bent : SELECT bodega\nWHERE nombre AND id_empresa
activate bent
bent --> orm : Bodega existente
deactivate bent

orm --> svc : existing (no es null)
deactivate orm

svc --> ctrl : throw BadRequestException\n('Ya existe una bodega con ese\nnombre en esta empresa.')
deactivate svc

ctrl --> view : 400 Bad Request
deactivate ctrl

view --> user : Muestra "Ya existe una bodega\ncon ese nombre en esta empresa."
deactivate view

@enduml
