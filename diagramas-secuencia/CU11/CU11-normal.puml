@startuml CU11-normal
title CU-11 — Cerrando sesión automáticamente por inactividad (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Sistema" as view
participant "C_JwtAuthGuard" as guard
participant "C_AuthController" as ctrl
participant "C_JwtStrategy" as strat

user -> view : Interactúa con\nel sistema
activate view

view -> view : Monitorea actividad\n(clics, teclado, scroll)
activate view
deactivate view

view -> view : Detecta actividad —\nreinicia temporizador\nde inactividad
activate view
deactivate view

view -> guard : GET /recurso\nAuthorization: Bearer <token>
activate guard

guard -> strat : validate(payload)
activate strat

strat -> strat : Verifica firma y\nexpiración del JWT\n(ignoreExpiration: false)
activate strat
deactivate strat

strat --> guard : { id_usuario, nombre_usuario,\nid_empresa, roles }
deactivate strat

guard --> ctrl : Solicitud autorizada\n(usuario adjunto al request)
deactivate guard

activate ctrl
ctrl --> view : 200 OK\n{ datos solicitados }
deactivate ctrl

view --> user : Muestra contenido\nde la pantalla
deactivate view

@enduml
