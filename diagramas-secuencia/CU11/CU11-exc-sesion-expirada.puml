@startuml CU11-exc-sesion-expirada
title CU-11 — Cerrando sesión automáticamente por inactividad (excepción: sesión expirada por inactividad)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Sistema" as view
participant "C_JwtAuthGuard" as guard
participant "C_JwtStrategy" as strat

user -> view : Permanece inactivo\n(sin clics, teclado\nni scroll)
activate view

view -> view : Temporizador alcanza\númbral − 2 minutos:\nmuestra aviso emergente\n'Su sesión se cerrará en\n2 minutos por inactividad'
activate view
deactivate view

view -> view : Usuario no responde\nal aviso en 2 minutos
activate view
deactivate view

view -> view : Cierra sesión automáticamente:\ninvalida token local\ny redirige a login
activate view
deactivate view

view -> guard : Petición posterior con\ntoken expirado\nAuthorization: Bearer <token_expirado>
activate guard

guard -> strat : validate(payload)
activate strat

strat -> strat : Verifica expiración del JWT\n(ignoreExpiration: false) —\ntoken expirado
activate strat
deactivate strat

strat --> guard : throw UnauthorizedException\n(token expirado)
deactivate strat

guard --> view : 401 Unauthorized
deactivate guard

view --> user : Redirige al formulario\nde inicio de sesión
deactivate view

@enduml
