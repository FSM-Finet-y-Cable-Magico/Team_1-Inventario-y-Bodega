@startuml CU45-normal
title CU-45 — Consultar stock de bodega (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_StockBodega" as view
participant "C_RolesGuard" as guard
participant "C_BodegasController" as ctrl
participant "C_BodegasService" as svc
participant "C_TypeORM" as orm
participant "bodega" as bent
participant "unidad_equipo" as uent
participant "stock_consumible" as scent
participant "tipo_equipo" as tent

user -> view : Solicita ver\nstock de bodega (id)
activate view

view -> guard : GET /bodegas/:id/stock
activate guard

guard --> view : Autorizado\n(ADMIN / SUPERUSUARIO /\nADMIN_BODEGA / TECNICO_TERRENO)
deactivate guard

view -> ctrl : GET /bodegas/:id/stock
activate ctrl

ctrl -> svc : getStock(id, userEmpresaId, isSuperuser)
activate svc

svc -> orm : findOne(bodega WHERE id_bodega = id)
activate orm

orm -> bent : SELECT bodega\nWHERE id_bodega = id
activate bent
bent --> orm : Datos bodega
deactivate bent

orm --> svc : Bodega encontrada
deactivate orm

svc -> orm : find(unidad_equipo WHERE\nid_bodega_actual = id, relations: tipoEquipo)
activate orm

orm -> uent : SELECT unidad_equipo\nJOIN tipo_equipo\nWHERE id_bodega_actual = id
activate uent
uent --> orm : Lista unidades con tipo_equipo
deactivate uent

orm --> svc : Unidades de equipo
deactivate orm

svc -> orm : find(stock_consumible WHERE\nid_bodega = id, relations: tipoEquipo)
activate orm

orm -> scent : SELECT stock_consumible\nJOIN tipo_equipo\nWHERE id_bodega = id
activate scent
scent --> orm : Lista consumibles con tipo_equipo
deactivate scent

orm --> svc : Stock consumibles
deactivate orm

svc -> svc : Agrupa individualizables\npor tipo y estado\n(En bodega, Asignado a técnico,\nEn revisión, En préstamo externo)
activate svc
deactivate svc

svc -> svc : Agrega consumibles\npor tipo con cantidad_disponible
activate svc
deactivate svc

svc --> ctrl : stockPorTipo[ ]\n(individualizables + consumibles)
deactivate svc

ctrl --> view : 200 OK\n[ { tipo_equipo, categoria,\nrequiere_serie, stock } ]
deactivate ctrl

view --> user : Muestra stock de bodega\nagrupado por tipo de equipo
deactivate view

@enduml
