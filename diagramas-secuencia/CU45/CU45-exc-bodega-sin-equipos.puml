@startuml CU45-exc-bodega-sin-equipos
title CU-45 — Consultar stock de bodega (excepción: bodega no encontrada)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_StockBodega" as view
participant "C_RolesGuard" as guard
participant "C_BodegasController" as ctrl
participant "C_BodegasService" as svc
participant "C_TypeORM" as orm
participant "bodega" as bent

user -> view : Solicita ver stock\nde bodega (id inexistente)
activate view

view -> guard : GET /bodegas/:id/stock
activate guard

guard --> view : Autorizado
deactivate guard

view -> ctrl : GET /bodegas/:id/stock
activate ctrl

ctrl -> svc : getStock(id, userEmpresaId, isSuperuser)
activate svc

svc -> orm : findOne(bodega WHERE id_bodega = id)
activate orm

orm -> bent : SELECT bodega\nWHERE id_bodega = id
activate bent
bent --> orm : (sin resultados)
deactivate bent

orm --> svc : null
deactivate orm

svc --> ctrl : throw NotFoundException\n('Bodega no encontrada')
deactivate svc

ctrl --> view : 404 Not Found
deactivate ctrl

view --> user : Muestra "Bodega no encontrada"
deactivate view

@enduml
