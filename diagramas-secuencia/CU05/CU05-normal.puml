@startuml CU05-normal
title CU-05 — Consultando listado de usuarios (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_ListaUsuarios" as view
participant "C_RolesGuard" as guard
participant "C_UsuariosController" as ctrl
participant "C_UsuariosService" as svc
participant "C_TypeORM" as orm
participant "usuario" as ent

user -> view : Consulta listado de usuarios\n(con filtros opcionales:\nactivo, buscar)
activate view

view -> ctrl : GET /usuario\n?activo=&buscar=
activate ctrl

ctrl -> guard : Verifica JWT y roles\n(ADMIN | SUPERUSUARIO)
activate guard
guard --> ctrl : Acceso permitido
deactivate guard

ctrl -> svc : findAll(filtros, id_empresa)
activate svc

svc -> orm : find({ where: { id_empresa,\nactivo?, nombre_completo ILike? } })
activate orm

orm -> ent : SELECT usuario\nWHERE id_empresa\n[AND activo]\n[AND nombre_completo ILIKE]
activate ent
ent --> orm : Lista de usuarios
deactivate ent

orm --> svc : Usuario[]
deactivate orm

svc --> ctrl : Usuario[]
deactivate svc

ctrl --> view : 200 OK\n[ ...usuarios ]
deactivate ctrl

view --> user : Muestra listado de usuarios
deactivate view

@enduml
