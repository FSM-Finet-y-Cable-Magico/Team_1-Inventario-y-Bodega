@startuml CU31-normal
title CU-31 — Distinguir naturaleza de equipo: INDIVIDUALIZABLE o CONSUMIBLE (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

participant "C_UnitsService" as units
participant "C_CatalogService" as catalog
participant "C_TypeORM" as orm
participant "tipo_equipo" as tent

units -> catalog : determinarNaturalezaEquipo(\nidTipoEquipo, idEmpresaContexto)
activate catalog

catalog -> orm : findOne({ id_tipo_equipo,\nid_empresa })
activate orm

orm -> tent : SELECT tipo_equipo\nWHERE id_tipo_equipo\nAND id_empresa
activate tent
tent --> orm : Registro tipo_equipo\n(requiereSerialNumber definido)
deactivate tent

orm --> catalog : tipo (TipoEquipo)
deactivate orm

catalog -> catalog : Evalúa tipo.requiereSerialNumber
activate catalog
deactivate catalog

catalog --> units : { clasificacion: 'INDIVIDUALIZABLE',\ntablaDestino: 'unidad_equipo',\nobligaSerialNumber: true,\nobligaUbicacionBodega: true }
deactivate catalog

@enduml
