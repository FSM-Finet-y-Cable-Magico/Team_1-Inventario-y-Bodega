@startuml CU36-exc-error-historial
title CU-36 — Registrando automáticamente cambio de estado de equipo (excepción: error al registrar historial)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

participant "C_UnitsService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as uent
participant "historial_estado_equipo" as hent

svc -> orm : save(unidad\n{ estado: nuevoEstado })
activate orm

orm -> uent : UPDATE unidad_equipo\nSET estado = nuevoEstado\nWHERE id_unidad
activate uent
uent --> orm : Fila actualizada
deactivate uent

orm --> svc : unidad actualizada
deactivate orm

svc -> svc : create(HistorialEstado\n{ id_unidad, id_usuario,\nestadoAnterior, estadoNuevo,\nmotivo, fechaHora })
activate svc
deactivate svc

svc -> orm : save(nuevoHistorial)
activate orm

orm -> hent : INSERT historial_estado_equipo
activate hent
hent --> orm : Error de base de datos
deactivate hent

orm --> svc : throw Error
deactivate orm

svc -> orm : rollbackTransaction()
activate orm
orm --> svc : Transacción revertida\n(UPDATE deshecho)
deactivate orm

svc --> svc : throw error (propagado al llamante)
activate svc
deactivate svc

@enduml
