@startuml CU36-normal
title CU-36 — Registrando automáticamente cambio de estado de equipo (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

participant "C_UnitsService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as uent
participant "historial_estado_equipo" as hent

svc -> orm : save(unidad\n{ estado: nuevoEstado })
activate orm

orm -> uent : UPDATE unidad_equipo\nSET estado = nuevoEstado\nWHERE id_unidad
activate uent
uent --> orm : Fila actualizada
deactivate uent

orm --> svc : unidad actualizada
deactivate orm

svc -> svc : create(HistorialEstado\n{ id_unidad, id_usuario,\nestadoAnterior, estadoNuevo,\nmotivo, fechaHora })
activate svc
deactivate svc

svc -> orm : save(nuevoHistorial)
activate orm

orm -> hent : INSERT historial_estado_equipo\n(id_unidad, id_usuario,\nestado_anterior, estado_nuevo,\nmotivo, fecha_hora)
activate hent
hent --> orm : Registro insertado
deactivate hent

orm --> svc : historial guardado
deactivate orm

svc -> orm : commitTransaction()
activate orm
orm --> svc : Transacción confirmada
deactivate orm

svc --> svc : { success: true,\nestadoActual, diagnostico_registrado }
activate svc
deactivate svc

@enduml
