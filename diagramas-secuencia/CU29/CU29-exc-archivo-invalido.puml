@startuml CU29-exc-archivo-invalido
title CU-29 — Adjuntar ficha técnica PDF a tipo de equipo (excepción: archivo inválido)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_FichaTecnica" as view
participant "C_CatalogController" as ctrl
participant "C_CatalogService" as svc
participant "C_TypeORM" as orm
participant "tipo_equipo" as tent

user -> view : Selecciona tipo de equipo\ny adjunta archivo no PDF\no mayor a 5 MB
activate view

view -> ctrl : POST /catalogo/:id/ficha-tecnica\n{ file: archivo_invalido }
activate ctrl

ctrl -> ctrl : FileInterceptor detecta:\nmimetype != application/pdf\no fileSize > 5 MB
activate ctrl
deactivate ctrl

ctrl --> view : 400 Bad Request\n'El archivo debe estar en formato\nPDF y no superar los 5 MB.'
deactivate ctrl

view --> user : Muestra "El archivo debe estar en\nformato PDF y no superar los 5 MB."
deactivate view

@enduml
