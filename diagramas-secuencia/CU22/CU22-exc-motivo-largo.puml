@startuml CU22-exc-motivo-largo
title CU-22 — Rechazar transferencia inter-empresa (excepción: motivo supera 200 caracteres)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Superusuario" as user
participant "V_RechazarTransferencia" as view
participant "C_RolesGuard" as guard
participant "C_TransferenciasController" as ctrl
participant "C_TransferenciasService" as svc
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "movimiento_inventario" as ment
participant "log_auditoria" as aent

user -> view : Ingresa motivo de rechazo\n(> 200 caracteres) y confirma
activate view

view -> guard : PATCH /transferencias/:id/rechazar\n{ observaciones: "..." (> 200 chars) }
activate guard

guard -> guard : Verifica rol SUPERUSUARIO\nen JWT
activate guard
deactivate guard

guard -> ctrl : Acceso autorizado
deactivate guard

activate ctrl

ctrl -> svc : rechazarTransferencia(id,\nobservaciones, actor)
activate svc

svc -> svc : Valida observaciones no vacías:\npasa OK
activate svc
deactivate svc

svc -> svc : Valida longitud:\nobservaciones.trim().length > 200
activate svc
deactivate svc

svc --> ctrl : throw BadRequestException\n('El motivo de rechazo no puede\nsuperar los 200 caracteres.')
deactivate svc

ctrl --> view : 400 Bad Request\n{ message: 'El motivo de rechazo no\npuede superar los 200 caracteres.' }
deactivate ctrl

view --> user : Muestra "El motivo de rechazo no\npuede superar los 200 caracteres."
deactivate view

@enduml
