@startuml CU24-exc-campos-invalidos
title CU-24 — Creando tipo de equipo en el catálogo (excepción: campos obligatorios incompletos)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_CrearTipoEquipo" as view
participant "C_CatalogController" as ctrl
participant "C_CatalogService" as svc

user -> view : Envía formulario con\ncampos obligatorios\nincompletos o inválidos
activate view

view -> ctrl : POST /catalogo\n{ nombre: "", categoria: "",\nrequiereSerialNumber: undefined }
activate ctrl

ctrl -> svc : crearTipo({ nombre: "",\ncategoria: "",\nrequiereSerialNumber: undefined,\nid_empresa: actor.id_empresa })
activate svc

svc -> svc : Valida campos obligatorios:\nnombre, categoria,\nrequiereSerialNumber definido
activate svc
deactivate svc

svc --> ctrl : throw BadRequestException\n('El nombre, la categoría y la definición\nde serie individual son campos obligatorios.')
deactivate svc

ctrl --> view : 400 Bad Request\n{ message: "El nombre, la categoría y la\ndefinición de serie individual son\ncampos obligatorios." }
deactivate ctrl

view --> user : Muestra errores\nespecíficos por campo
deactivate view

@enduml
