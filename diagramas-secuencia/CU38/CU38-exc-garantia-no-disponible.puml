@startuml CU38-exc-garantia-no-disponible
title CU-38 — Calcular fecha de vencimiento de garantía\n(excepción: fecha_venc_garantia no disponible — campo queda null)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_RegistroUnidad" as view
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as ent

user -> view : Completa formulario de registro\nsin ingresar fecha_venc_garantia\n(campo omitido o enviado como null/undefined)
activate view

view -> ctrl : POST /inventario/units\n{ ..., fecha_adquisicion, fecha_venc_garantia: undefined }
activate ctrl

ctrl -> svc : registrarUnidad(dto, idEmpresaContexto)
activate svc

svc -> svc : Valida campos obligatorios:\nid_tipo_equipo, numero_serie, id_bodega_actual
activate svc
deactivate svc

svc -> svc : Verifica naturaleza del tipo de equipo\n(no CONSUMIBLE / VOLUMEN)
activate svc
deactivate svc

svc -> svc : Valida formato numero_serie\ny verifica unicidad en repositorio
activate svc
deactivate svc

svc -> svc : Evalúa fecha_venc_garantia:\ndto.fecha_venc_garantia es null/undefined\n→ fechaVencGarantia = null\n(sin excepción; la unidad se registra sin garantía)
activate svc
deactivate svc

svc -> svc : Construye datosNuevaUnidad:\n{ ..., fechaAdquisicion, fechaVencGarantia: null }
activate svc
deactivate svc

svc -> orm : unitRepository.create(datosNuevaUnidad)
activate orm
orm --> svc : nuevaUnidad (fechaVencGarantia = null)
deactivate orm

svc -> orm : unitRepository.save(nuevaUnidad)
activate orm

orm -> ent : INSERT unidad_equipo\n(fecha_venc_garantia = NULL)
activate ent
ent --> orm : Registro persistido sin garantía
deactivate ent

orm --> svc : unidadGuardada\n(fechaVencGarantia = null)
deactivate orm

svc --> ctrl : { success: true, id_unidad,\nnumero_serie, estado, id_empresa,\nmessage: "registrada con éxito" }
deactivate svc

ctrl --> view : 201 Created\n{ success, id_unidad, ... }
deactivate ctrl

view --> user : Muestra confirmación de registro\n(la ficha de la unidad indicará\n"Sin garantía registrada")
deactivate view

@enduml
