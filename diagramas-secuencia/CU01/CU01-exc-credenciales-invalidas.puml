@startuml CU01-exc-credenciales-invalidas
title CU-01 — Iniciar sesión en el sistema (excepción: credenciales inválidas)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Login" as view
participant "C_AuthController" as ctrl
participant "C_AuthService" as svc
participant "C_TypeORM" as orm
participant "usuario" as uent

user -> view : Ingresa nombre_usuario\ny password incorrectos
activate view

view -> ctrl : POST /auth/login\n{ nombre_usuario, password }
activate ctrl

ctrl -> svc : login(loginDto)
activate svc

svc -> orm : findOne(usuario por\nnombre_usuario, con roles)
activate orm

orm -> uent : SELECT usuario\nJOIN usuario_rol JOIN rol\nWHERE nombre_usuario
activate uent
uent --> orm : Datos usuario
deactivate uent

orm --> svc : Usuario (existe)
deactivate orm

svc -> svc : Verifica password:\nbcrypt.compare(password,\npassword_hash)
activate svc
deactivate svc

svc -> orm : update(id_usuario,\n{ intentos_fallidos: N+1 })
activate orm

orm -> uent : UPDATE usuario SET\nintentos_fallidos = N+1
activate uent
uent --> orm : Actualizado
deactivate uent

orm --> svc : OK
deactivate orm

svc --> ctrl : throw UnauthorizedException\n('Usuario o contraseña incorrectos.')
deactivate svc

ctrl --> view : 401 Unauthorized\n'Usuario o contraseña incorrectos.'
deactivate ctrl

view --> user : Muestra "Usuario o contraseña incorrectos."
deactivate view

@enduml
