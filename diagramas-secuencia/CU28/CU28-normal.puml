@startuml CU28-normal
title CU-28 — Validar número de serie de equipo (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

participant "C_UnitsService" as units
participant "C_CatalogService" as catalog

units -> catalog : validarFormatoSerialNumber(numero_serie)
activate catalog

catalog -> catalog : Verifica no vacío:\n!serial || serial.trim() === ''
activate catalog
deactivate catalog

catalog -> catalog : Aplica regex:\n/^[A-Z0-9-]{4,30}$/.test(serial)
activate catalog
deactivate catalog

catalog --> units : true (formato válido)
deactivate catalog

@enduml
