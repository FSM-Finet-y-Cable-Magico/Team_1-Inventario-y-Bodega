<lane id="Lane_4" name="Sistema de terreno (G3)"><flowNodeRef>t9</flowNodeRef></lane>
</laneSet>
<startEvent id="s1" name="Se requieren equipos"><outgoing>f0</outgoing></startEvent>
<task id="t1" name="Revisar vigencia del proveedor"><incoming>f0</incoming><outgoing>f1</outgoing></task>
<exclusiveGateway id="g1" name="¿Proveedor activo?"><incoming>f1</incoming><outgoing>f2</outgoing><outgoing>f3</outgoing></exclusiveGateway>
<task id="t3" name="Reactivar o elegir otro proveedor (CU-98)"><incoming>f2</incoming><outgoing>f4</outgoing></task>
<task id="t2" name="Registrar orden de ingreso"><incoming>f3</incoming><incoming>f4</incoming><outgoing>f5</outgoing></task>
<task id="t4" name="Validar proveedor activo y crear la orden"><incoming>f5</incoming><outgoing>f6</outgoing></task>
<task id="t5" name="Recibir equipos"><incoming>f6</incoming><outgoing>f7</outgoing></task>
<task id="t6" name="Registrar unidades y stock"><incoming>f7</incoming><outgoing>f8</outgoing></task>
<task id="t7" name="Asignar equipos y consumibles al técnico"><incoming>f8</incoming><outgoing>f9</outgoing></task>
<task id="t8" name="Instalar o reparar en terreno"><incoming>f9</incoming><outgoing>f10</outgoing></task>
<task id="t9" name="Confirmar cierre de la orden de trabajo"><incoming>f10</incoming><outgoing>f11</outgoing></task>
<task id="t10" name="Aplicar cierre: estados, consumos y SRV"><incoming>f11</incoming><outgoing>f12</outgoing></task>
<intermediateCatchEvent id="i1" name="Periodo de control"><incoming>f12</incoming><outgoing>f13</outgoing><timerEventDefinition id="TD_i1"/></intermediateCatchEvent>
<task id="t11" name="Abrir toma de inventario (CU-97)"><incoming>f13</incoming><outgoing>f14</outgoing></task>
<task id="t12" name="Guardar lo esperado de la bodega"><incoming>f14</incoming><outgoing>f15</outgoing></task>
<task id="t13" name="Contar consumibles y leer series"><incoming>f15</incoming><outgoing>f16</outgoing></task>
<exclusiveGateway id="g2" name="¿Hay diferencias?"><incoming>f16</incoming><outgoing>f17</outgoing><outgoing>f18</outgoing></exclusiveGateway>
<task id="t14" name="Ajustar stock con movimientos de ajuste"><incoming>f17</incoming><outgoing>f19</outgoing></task>
<task id="t15" name="Generar acta PDF (CU-99)"><incoming>f18</incoming><incoming>f19</incoming><outgoing>f20</outgoing></task>
<task id="t16" name="Firmar y archivar el acta"><incoming>f20</incoming><outgoing>f21</outgoing></task>
<task id="t17" name="Desactivar proveedores sin uso (CU-98)"><incoming>f21</incoming><outgoing>f22</outgoing></task>
<endEvent id="e1" name="Inventario cuadrado y proveedores vigentes"><incoming>f22</incoming></endEvent>
