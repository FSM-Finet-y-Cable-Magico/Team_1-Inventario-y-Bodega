<collaboration id="Colab_I4"><participant id="Pool_I4" name="Proceso operativo final de inventario y bodega (Incremento 4)" processRef="Proc_I4"/></collaboration>
<process id="Proc_I4" name="Proceso operativo final" isExecutable="false"><laneSet id="LS">
<lane id="Lane_0" name="Administrador"><flowNodeRef>s1</flowNodeRef><flowNodeRef>t1</flowNodeRef><flowNodeRef>g1</flowNodeRef><flowNodeRef>t3</flowNodeRef><flowNodeRef>t2</flowNodeRef><flowNodeRef>t17</flowNodeRef><flowNodeRef>e1</flowNodeRef></lane>
