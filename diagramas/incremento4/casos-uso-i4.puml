@startuml casos-uso-i4
title Diagrama de casos de uso — Incremento 4
left to right direction
skinparam shadowing false
skinparam usecase {
  BackgroundColor #E8DEFB
  BorderColor #6A4FB3
}
skinparam actorStyle awesome
actor "Encargado de bodega\n(ADMIN_BODEGA)" as ab
actor "Administrador" as adm
actor "Superusuario" as su
adm <|-- su
ab <|-- adm
rectangle "Sistema de Inventario y Bodega (T1)" {
  usecase "CU-97 Registrando toma de inventario\nfísico y ajuste de diferencias" as cu97
  usecase "CU-99 Generando acta de toma\nde inventario en PDF" as cu99
  usecase "CU-98 Desactivando proveedor" as cu98
  usecase "CU-45 Consultando stock\nde bodega (I1)" as cu45 #DDEBFF
  usecase "CU-52 Registrando orden de\ningreso desde proveedor (I2)" as cu52 #D9F2E4
  usecase "CU-93 Exportando reporte\na PDF (I3)" as cu93 #FFE8C2
  usecase "CU-08 Registrando eventos en el\nlog de auditoría (I1)" as cu08 #DDEBFF
}
ab --> cu97
ab --> cu99
adm --> cu98
cu97 ..> cu45 : <<include>>
cu99 ..> cu97 : <<extend>>\n(toma confirmada)
cu99 ..> cu93 : <<include>>\n(generador PDF)
cu98 ..> cu52 : <<extend>>\n(proveedor inactivo\nno admite órdenes)
cu97 ..> cu08 : <<include>>
cu98 ..> cu08 : <<include>>
cu99 ..> cu08 : <<include>>
@enduml
