prestamo_detalle }o--|| prestamo_externo
prestamo_detalle }o--|| unidad_equipo
prestamo_externo }o--|| unidad_equipo
prestamo_retorno }o--|| prestamo_detalle
proveedor_tipo_equipo }o--|| proveedor
proveedor_tipo_equipo }o--|| tipo_equipo
salida_detalle }o--|| salida_bodega
solicitud_baja }o--|| unidad_equipo
stock_consumible }o--|| bodega
stock_consumible }o--|| tipo_equipo
unidad_equipo }o--|| tipo_equipo
