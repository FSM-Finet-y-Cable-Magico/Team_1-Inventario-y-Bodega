  * id_detalle <<PK>>
}
entity "prestamo_externo" as prestamo_externo {
  * id_prestamo <<PK>>
}
entity "prestamo_retorno" as prestamo_retorno {
  * id_retorno <<PK>>
}
entity "proveedor" as proveedor {
  * id_proveedor <<PK>>
}
