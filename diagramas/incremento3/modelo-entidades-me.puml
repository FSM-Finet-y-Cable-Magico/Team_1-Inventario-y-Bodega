@startuml

!theme plain

hide circle

skinparam linetype ortho

skinparam shadowing false

skinparam roundcorner 4

skinparam classFontSize 11

skinparam classFontName "Helvetica,Arial,sans-serif"

skinparam arrowColor #333333

skinparam packageBackgroundColor transparent

skinparam class {

    BackgroundColor #FFFFFF

    BorderColor #2B5797

    HeaderBackgroundColor #E8EEF7

}

title Modelo de entidades y claves — corte Incremento 3
entity "asignacion_equipo_servicio" as asignacion_equipo_servicio {
  * id_asignacion <<PK>>
}
entity "bodega" as bodega {
