}
entity "cierre_reparacion" as cierre_reparacion {
  * id_cierre_reparacion <<PK>>
}
entity "donacion" as donacion {
  * id_donacion <<PK>>
}
entity "donacion_detalle" as donacion_detalle {
  * id_detalle <<PK>>
}
entity "empresa" as empresa {
  * id_empresa <<PK>>
}
entity "historial_estado_equipo" as historial_estado_equipo {
  * id_historial <<PK>>
}
entity "integracion_activacion" as integracion_activacion {
