@startuml CU89-exc-tecnico-sin-items
title CU-89 — Generando reporte de inventario actual de técnicos (excepción: técnico sin ítems)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam ParticipantPadding 25
skinparam ActorPadding 20
skinparam sequence {
	MessageAlign center
	LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega / Administrador / Superusuario" as user
participant "V_ReportesTecnicos" as view
participant "C_ReportesController" as ctrl
participant "C_ReportesService" as svc
participant "C_TypeORM" as orm
participant "log_auditoria" as aent

user -> view : Selecciona un técnico y Generar
activate view
view -> ctrl : GET /api/reportes/tecnicos/inventario\n?id_usuario=X
activate ctrl
ctrl -> svc : getInventarioTecnicosReport({ id_usuario: X }, req.user)
activate svc
svc -> orm : SELECT técnico activo de la empresa
activate orm
orm --> svc : Técnico
deactivate orm
svc -> orm : SELECT unidades asignadas y saldos positivos
activate orm
orm --> svc : 0 equipos y 0 consumibles
deactivate orm
svc -> svc : Conserva la tarjeta con secciones vacías
svc -> aent : INSERT log_auditoria\n(GENERAR_REPORTE, reporte_inventario_tecnicos)
activate aent
aent --> svc : Auditoría registrada
deactivate aent
svc --> ctrl : Tarjeta sin ítems
deactivate svc
ctrl --> view : 200 OK: Sin ítems asignados
deactivate ctrl
view --> user : Este técnico no tiene ítems en su inventario personal.
deactivate view

@enduml
