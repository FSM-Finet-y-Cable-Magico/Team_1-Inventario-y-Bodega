@startuml CU22-normal
title CU-22 — Rechazando transferencia inter-empresa (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Superusuario" as user
participant "V_RechazarTransferencia" as view
participant "C_RolesGuard" as guard
participant "C_TransferenciasController" as ctrl
participant "C_TransferenciasService" as svc
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "movimiento_inventario" as ment
participant "log_auditoria" as aent

user -> view : Ingresa motivo de rechazo\ny confirma acción
activate view

view -> guard : PATCH /transferencias/:id/rechazar\n{ observaciones }
activate guard

guard -> guard : Verifica rol SUPERUSUARIO\nen JWT
activate guard
deactivate guard

guard -> ctrl : Acceso autorizado
deactivate guard

activate ctrl

ctrl -> svc : rechazarTransferencia(id,\nobservaciones, actor)
activate svc

svc -> svc : Valida observaciones\nno vacías y ≤ 200 chars
activate svc
deactivate svc

svc -> orm : find(movimiento_inventario\nWHERE referencia_id = id\nAND tipo_movimiento = PENDIENTE)
activate orm

orm -> ment : SELECT movimiento_inventario\nWHERE referencia_id AND PENDIENTE
activate ment
ment --> orm : Lista de movimientos pendientes
deactivate ment

orm --> svc : movimientos[]
deactivate orm

svc -> orm : update(movimiento_inventario\ntipo_movimiento = RECHAZADA)\npor cada movimiento
activate orm

orm -> ment : UPDATE movimiento_inventario\nSET tipo_movimiento = RECHAZADA
activate ment
ment --> orm : Actualizado
deactivate ment

orm --> svc : OK
deactivate orm

svc -> aud : create({ accion: RECHAZAR_TRANSFERENCIA,\nentidad_afectada: transferencia_equipo,\nvalor_nuevo: { estado: RECHAZADA, observaciones } })
activate aud

aud -> orm : save(log_auditoria)
activate orm

orm -> aent : INSERT log_auditoria
activate aent
aent --> orm : Registrado
deactivate aent

orm --> aud : Log guardado
deactivate orm

aud --> svc : Auditoría registrada
deactivate aud

svc --> ctrl : { success: true,\nestado: RECHAZADA,\nmessage: ... }
deactivate svc

ctrl --> view : 200 OK\n{ success, id_transferencia,\nestado: RECHAZADA }
deactivate ctrl

view --> user : Muestra confirmación\n"Transferencia rechazada"
deactivate view

@enduml
