@startuml CU22-exc-sin-motivo
title CU-22 — Rechazando transferencia inter-empresa (excepción: sin motivo de rechazo)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Superusuario" as user
participant "V_RechazarTransferencia" as view
participant "C_RolesGuard" as guard
participant "C_TransferenciasController" as ctrl
participant "C_TransferenciasService" as svc
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "movimiento_inventario" as ment
participant "log_auditoria" as aent

user -> view : Confirma rechazo sin\ningresar motivo
activate view

view -> guard : PATCH /transferencias/:id/rechazar\n{ observaciones: "" }
activate guard

guard -> guard : Verifica rol SUPERUSUARIO\nen JWT
activate guard
deactivate guard

guard -> ctrl : Acceso autorizado
deactivate guard

activate ctrl

ctrl -> svc : rechazarTransferencia(id,\n"", actor)
activate svc

svc -> svc : Valida observaciones:\n!observaciones || trim === ""
activate svc
deactivate svc

svc --> ctrl : throw BadRequestException\n('Debe ingresar un motivo de\nrechazo para continuar.')
deactivate svc

ctrl --> view : 400 Bad Request\n{ message: 'Debe ingresar un motivo\nde rechazo para continuar.' }
deactivate ctrl

view --> user : Muestra "Debe ingresar un motivo\nde rechazo para continuar."
deactivate view

@enduml
