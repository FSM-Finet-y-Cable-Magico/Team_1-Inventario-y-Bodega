@startuml CU64-normal
skinparam sequenceDividerBorderThickness 0.6
skinparam sequenceDividerBorderColor 888888
skinparam sequenceDividerBackgroundColor white
skinparam sequenceDividerFontStyle italic
skinparam sequenceDividerFontColor 444444
skinparam sequenceDividerShadowing false
title CU-64 — Ejecutando acciones atómicas del cierre de instalación (flujo normal)
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 30
  }
  actor {
    margin 12
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Técnico de terreno (G3)" as g3
participant "C_IntegracionesController" as ctrl
participant "C_IntegracionesService" as svc
participant "C_InventarioPersonalService" as ips
participant "C_TypeORM (transacción)" as orm
participant "integracion_cierre" as cierre
participant "secuencia_srv" as sec
participant "unidad_equipo" as uni
participant "inventario_personal_tecnico" as inv

g3 -> ctrl : POST /api/integraciones/ordenes/781/cierre\nX-API-KEY + { clave_idempotencia, tipo_ot: INSTALACION,\ncliente{rut,nombre}, direccion{...}, materiales[], equipos_instalados[] }
activate ctrl
ctrl -> svc : recibirCierreOt(781, payload, integracion)
activate svc
svc -> svc : validar X-API-KEY + scope id_empresa + payload
svc -> orm : startTransaction()
activate orm
orm --> svc : transacción iniciada
svc -> orm : INSERT integracion_cierre\n(clave_idempotencia UNIQUE, payload)
orm -> cierre : INSERT
activate cierre
cierre --> orm : id_cierre
deactivate cierre
orm --> svc : id_cierre
note right : (E) auditoría de integración: el payload completo\n+ acciones + discrepancias quedan en integracion_cierre
svc -> orm : INSERT secuencia_srv ... ON CONFLICT DO UPDATE RETURNING ultimo
orm -> sec : UPSERT
activate sec
sec --> orm : ultimo = 1
deactivate sec
orm --> svc : SRV-2026-00001
svc -> orm : UPDATE integracion_cierre SET srv, id_tecnico
orm -> cierre : UPDATE
activate cierre
cierre --> orm : actualizado
deactivate cierre
orm --> svc : cierre actualizado
== Inicio loop: cada equipos_instalados[] (A)(B) ==
  svc -> orm : SELECT unidad_equipo WHERE numero_serie + id_empresa
  orm -> uni : SELECT
  activate uni
  uni --> orm : estado 'Asignado a técnico', id_tecnico_asignado
  deactivate uni
  orm --> svc : unidad
  svc -> svc : valida acción INSTALADO_EN_CLIENTE (máquina T1)
  svc -> orm : UPDATE unidad_equipo SET estado = 'Instalado en cliente',\ncliente_rut/nombre, direccion_instalacion, srv
  orm -> uni : UPDATE
  activate uni
  uni --> orm : unidad actualizada
  deactivate uni
  orm --> svc : unidad actualizada
  svc -> orm : INSERT historial_estado_equipo (usuario null, motivo integración)
  orm --> svc : historial guardado
== Fin loop ==
== Inicio loop: cada materiales[] (C) ==
  svc -> ips : descontarHasta(manager, id_tecnico, id_tipo_equipo, cantidad)
  activate ips
  ips -> orm : SELECT inventario_personal_tecnico FOR UPDATE
  orm -> inv : SELECT con bloqueo
  activate inv
  inv --> orm : cantidad = 25
  deactivate inv
  orm --> ips : saldo 25
  ips -> orm : UPDATE cantidad = 15 (nunca negativa)
  orm -> inv : UPDATE
  activate inv
  inv --> orm : saldo actualizado
  deactivate inv
  orm --> ips : saldo 15
  ips --> svc : { saldoAnterior: 25, descontado: 10, faltante: 0 }
  deactivate ips
== Fin loop ==
svc -> orm : commitTransaction()
orm --> svc : transacción confirmada
deactivate orm
svc --> ctrl : { success, data: { srv: 'SRV-2026-00001',\nid_tecnico, acciones_aplicadas, materiales { descontados, ajustes } } }
deactivate svc
ctrl --> g3 : 200 OK (G3 guarda el SRV; nunca 4xx por regla de negocio)
deactivate ctrl
@enduml
