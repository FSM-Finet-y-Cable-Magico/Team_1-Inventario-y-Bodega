@startuml CU64-exc-fallo-accion
skinparam sequenceDividerBorderThickness 0.6
skinparam sequenceDividerBorderColor 888888
skinparam sequenceDividerBackgroundColor white
skinparam sequenceDividerFontStyle italic
skinparam sequenceDividerFontColor 444444
skinparam sequenceDividerShadowing false
title CU-64 — Ejecutando acciones atómicas del cierre de instalación (excepción: una acción falla → rollback total)
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 30
  }
  actor {
    margin 12
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Técnico de terreno (G3)" as g3
participant "C_IntegracionesService" as svc
participant "C_TypeORM (transacción)" as orm
participant "integracion_cierre" as cierre
participant "unidad_equipo" as uni
participant "inventario_personal_tecnico" as inv

g3 -> svc : POST /api/integraciones/ordenes/781/cierre (INSTALACION)
activate svc
svc -> orm : startTransaction()
activate orm
orm --> svc : transacción iniciada
svc -> orm : INSERT integracion_cierre (clave UNIQUE, payload)
orm -> cierre : INSERT
activate cierre
cierre --> orm : id_cierre
deactivate cierre
orm --> svc : id_cierre
svc -> orm : UPDATE unidad_equipo SET estado = 'Instalado en cliente' (acción A/B)
orm -> uni : UPDATE
activate uni
uni --> orm : unidad actualizada
deactivate uni
orm --> svc : unidad actualizada
svc -> orm : INSERT historial_estado_equipo
orm --> svc : <font:DejaVu Sans Mono>✗</font> fallo inesperado (p. ej. error de BD)
note right : Excepción 1 (E1): "alguna acción falla"
svc -> orm : ROLLBACK total (QueryRunner)
orm --> svc : transacción revertida
deactivate orm
note right : ninguna acción parcial queda aplicada:\nla unidad vuelve a 'Asignado a técnico' y el material no se descuenta
svc --> g3 : 5xx con el error específico (G3 reintenta con backoff;\nun 4xx de payload malformado no se reintenta)
deactivate svc
@enduml
