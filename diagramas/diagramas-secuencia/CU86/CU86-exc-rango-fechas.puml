@startuml CU86-exc-rango-fechas
title CU-86 — Generando reporte de movimientos de inventario (excepción: rango superior a 365 días)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam ParticipantPadding 25
skinparam ActorPadding 20
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega / Administrador / Superusuario" as user
participant "V_ReportesMovimientos" as view
participant "C_ReportesController" as ctrl
participant "C_ReportesService" as svc

user -> view : Selecciona fechas con rango mayor a 365 días
activate view
view -> ctrl : GET /api/reportes/movimientos\n?fecha_desde=2024-01-01&fecha_hasta=2026-01-01
activate ctrl
ctrl -> svc : getMovementsReport(filtros, req.user)
activate svc
svc -> svc : validateDateRange(fecha_desde, fecha_hasta)
svc --> ctrl : BadRequestException\n"El rango de fechas no puede superar los 365 días."
deactivate svc
ctrl --> view : 400 Bad Request: Rango de fechas superior a 365 días
deactivate ctrl
view --> user : Muestra el mensaje de rango inválido\ny no genera el reporte
deactivate view

@enduml