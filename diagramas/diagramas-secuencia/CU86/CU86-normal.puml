@startuml CU86-Reporte-Movimientos-Normal
title CU-86 — Generando reporte de movimientos de inventario (flujo normal)
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
hide footbox

actor Usuario
participant "Vista SvelteKit" as V
participant "ReportesController" as C
participant "ReportesService" as S
 database "movimiento_inventario" as M
 database "tablas relacionadas" as DB

Usuario -> V : Configura filtros y pulsa Generar
activate V
V -> C : GET /api/reportes/movimientos?id_empresa=...&fecha_desde=...&fecha_hasta=...
activate C
C -> S : getMovementsReport(filtros, req.user)
activate S
S -> S : valida fechas, máximo 365 días y empresa
S -> M : SELECT movimientos filtrados por fechas, tipo y usuario
M -> DB : LEFT JOIN tipo_equipo, unidad_equipo, bodega, usuario
DB --> S : filas con NS/tipo, empresa, bodega y usuario
S -> S : resuelve referencia_id y audita GENERAR_REPORTE
S --> C : filas del reporte
C --> V : 200 OK, JSON
V --> Usuario : Tabla con fecha DD/MM/YYYY HH:MM:SS y referencia
 deactivate S
 deactivate C
 deactivate V
@enduml
