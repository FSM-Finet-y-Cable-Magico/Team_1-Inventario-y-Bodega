@startuml CU86-normal
title CU-86 — Generando reporte de movimientos de inventario (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam ParticipantPadding 25
skinparam ActorPadding 20
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega / Administrador / Superusuario" as user
participant "V_ReportesMovimientos" as view
participant "C_ReportesController" as ctrl
participant "C_ReportesService" as svc
participant "C_TypeORM" as orm
participant "movimiento_inventario" as ment
participant "tipo_equipo" as tent
participant "unidad_equipo" as uent
participant "bodega" as bent
participant "usuario" as userent
participant "log_auditoria" as aent

user -> view : Selecciona filtros y Generar
activate view
view -> ctrl : GET /api/reportes/movimientos\n?id_empresa=&id_bodega=&id_tipo_equipo=\n&fecha_desde=&fecha_hasta=&tipo_movimiento=&id_usuario=
activate ctrl
ctrl -> svc : getMovementsReport(filtros, req.user)
activate svc
svc -> svc : Valida rango máximo 365 días\ny aislamiento por empresa
svc -> orm : Consulta movimientos con filtros
activate orm
orm -> ment : SELECT fecha, tipo, cantidad y referencia
activate ment
ment --> orm : Movimientos
deactivate ment
orm -> tent : JOIN tipo_equipo para consumibles
activate tent
tent --> orm : Nombre del tipo
deactivate tent
orm -> uent : JOIN unidad_equipo para número de serie
activate uent
uent --> orm : Número de serie
deactivate uent
orm -> bent : JOIN bodegas origen/destino
activate bent
bent --> orm : Bodega
deactivate bent
orm -> userent : JOIN usuario que realizó el movimiento
activate userent
userent --> orm : Nombre del usuario
deactivate userent
orm --> svc : Filas de movimientos
deactivate orm
svc -> svc : Completa empresa y tipo de referencia
svc -> aent : INSERT log_auditoria\n(GENERAR_REPORTE, reporte_movimientos)
activate aent
aent --> svc : Auditoría registrada
deactivate aent
svc --> ctrl : Filas del reporte
deactivate svc
ctrl --> view : 200 OK: Datos del reporte
deactivate ctrl
view --> user : Tabla con fecha, movimiento, ítem, cantidad y usuario
deactivate view

@enduml