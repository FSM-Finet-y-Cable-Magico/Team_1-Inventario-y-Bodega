@startuml CU31-normal
title CU-31 — Distinguiendo naturaleza de equipo: INDIVIDUALIZABLE o CONSUMIBLE (flujo normal — contexto: registro de unidad)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_RegistrarUnidad" as view
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as units
participant "C_CatalogService" as catalog
participant "C_TypeORM" as orm
participant "tipo_equipo" as tent
participant "unidad_equipo" as uent

user -> view : Selecciona tipo de equipo\ne ingresa datos del registro
activate view

view -> ctrl : POST /unidades\n{ id_tipo_equipo, numero_serie,\nid_bodega_actual }
activate ctrl

ctrl -> units : registrarUnidad(body,\nactor.id_empresa)
activate units

units -> catalog : determinarNaturalezaEquipo(\nidTipoEquipo, idEmpresaContexto)
activate catalog

catalog -> orm : findOne({ id_tipo_equipo,\nid_empresa })
activate orm

orm -> tent : SELECT tipo_equipo\nWHERE id_tipo_equipo\nAND id_empresa
activate tent
tent --> orm : Registro tipo_equipo\n(requiereSerialNumber definido)
deactivate tent

orm --> catalog : tipo (TipoEquipo)
deactivate orm

catalog -> catalog : Evalúa tipo.requiereSerialNumber\n→ true
activate catalog
deactivate catalog

catalog --> units : { clasificacion: 'INDIVIDUALIZABLE',\ntablaDestino: 'unidad_equipo',\nobligaSerialNumber: true,\nobligaUbicacionBodega: true }
deactivate catalog

units -> orm : save(nuevaUnidad)\n(registro individualizado\nen tablaDestino)
activate orm

orm -> uent : INSERT unidad_equipo\n(numero_serie, estado = 'En bodega',\nid_bodega_actual)
activate uent
uent --> orm : Unidad guardada
deactivate uent

orm --> units : UnidadEquipo guardada
deactivate orm

units --> ctrl : { success: true, id_unidad,\nnumero_serie, estado }
deactivate units

ctrl --> view : 201 Created
deactivate ctrl

view --> user : Muestra confirmación del registro\ncomo equipo individualizable
deactivate view

@enduml
