@startuml CU49-Crear-Proveedor-Normal
title CU-49 — Creando proveedor (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 25
skinparam ActorPadding 20
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Admin/Superusuario" as user
participant "V_Proveedores" as view
participant "C_ProveedoresController" as ctrl
participant "C_ProveedoresService" as svc
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "proveedor" as pent
participant "proveedor_tipo_equipo" as pte
participant "log_auditoria" as aent

user -> view : Completa formulario\n"Nuevo proveedor"
activate view

view -> ctrl : POST /api/proveedores\n{ nombre_comercial, rut,\nnombre_contacto, telefono,\nemail, ids_tipos_equipo }
activate ctrl

ctrl -> svc : create(dto, actorId)
activate svc

svc -> svc : validarRut(rut)\n(módulo 11, DV correcto)
activate svc
deactivate svc

svc -> orm : findOne(proveedor\npor rut)
activate orm

orm -> pent : SELECT proveedor\nWHERE rut = ?
activate pent
pent --> orm : null (no existe)
deactivate pent

orm --> svc : null
deactivate orm

svc -> orm : save(proveedor)
activate orm

orm -> pent : INSERT proveedor\n(nombre_comercial, rut, ...)
activate pent
pent --> orm : Proveedor creado
deactivate pent

orm --> svc : Proveedor { id_proveedor }
deactivate orm

svc -> orm : save(pivots[])
activate orm

orm -> pte : INSERT proveedor_tipo_equipo\n(id_proveedor, id_tipo_equipo) x N
activate pte
pte --> orm : Registrados
deactivate pte

orm --> svc : OK
deactivate orm

svc -> aud : create({ accion: 'CREAR',\nentidad_afectada: 'proveedor' })
activate aud

aud -> orm : save(log)
activate orm

orm -> aent : INSERT log_auditoria
activate aent
aent --> orm : Registrado
deactivate aent

orm --> aud : Log guardado
deactivate orm

aud --> svc : Auditoría registrada
deactivate aud

svc --> ctrl : Proveedor + tipos_equipo
deactivate svc

ctrl --> view : 201 Created\n{ proveedor }
deactivate ctrl

view --> user : Muestra proveedor en listado
deactivate view

@enduml
