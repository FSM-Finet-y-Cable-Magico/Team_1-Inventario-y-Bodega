@startuml CU47-exc-sin-ubicacion
title CU-47 — Excepción 1: el actor no ingresa ubicación (aviso sin bloqueo)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style> sequenceDiagram { participant { Margin 35 } actor { Margin 15 } } </style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega" as user
participant "V_GestionEquipos" as view
participant "C_RolesGuard" as guard
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as uent
participant "historial_estado_equipo" as hent

user -> view : Abre ficha y elige reingreso a bodega\nSIN ingresar ubicación física
activate view

view -> view : estado_nuevo = 'En bodega'\n&& ubicacion_fisica vacía
activate view
view --> user : AVISO (no bloquea):\n'Se recomienda registrar la ubicación física\npara facilitar la trazabilidad del equipo.'
deactivate view

user -> view : Confirma el cambio de estado
activate view
deactivate view

view -> guard : PATCH /unidades/:id/cambiar-estado\n{ nuevoEstado: "En bodega",\nubicacion_fisica: "" }
activate guard
guard --> view : Autorizado
deactivate guard

view -> ctrl : transicionarEstadoEquipo(...)
activate ctrl
ctrl -> svc : transicionarEstado(unitId, "En bodega", actor, ...,\nubicacionFisicaPayload = "")
activate svc

svc -> svc : ubicacionFisica = ''.trim() || null = null\n(no obligatoria: Excepción 1 permite continuar)
activate svc
deactivate svc

svc -> orm : findOne(id_unidad)
activate orm
orm -> uent : SELECT unidad_equipo WHERE id_unidad = :id
activate uent
uent --> orm : unidad (estadoOrigen = 'Asignado a técnico')
deactivate uent
orm --> svc : unidad
deactivate orm

svc -> svc : transición permitida → OK\nunidad.ubicacionFisica = null
activate svc
deactivate svc

svc -> orm : queryRunner.startTransaction()\nqueryRunner.manager.save(unidad)
activate orm
orm -> uent : UPDATE unidad_equipo\nSET estado = 'En bodega',\nubicacion_fisica = NULL\nWHERE id_unidad = :id
activate uent
uent --> orm : Unidad actualizada (ubicación vacía)
deactivate uent
orm --> svc : unidad guardada
deactivate orm

svc -> orm : queryRunner.manager.save(historial\n{ estadoAnterior, estadoNuevo: 'En bodega',\nmotivo: 'Cambio de estado ordinario' (sin ubicación) })
activate orm
orm -> hent : INSERT historial_estado_equipo
activate hent
hent --> orm : Registro insertado
deactivate hent
orm --> svc : historial guardado
deactivate orm

svc -> orm : queryRunner.commitTransaction()
activate orm
orm --> svc : Transacción confirmada
deactivate orm

svc --> ctrl : 200 OK { success: true, estadoActual: 'En bodega',\nubicacion_fisica: null }
deactivate svc
ctrl --> view : 200 OK
deactivate ctrl

view --> user : Ficha actualizada en 'En bodega'\ncon ubicación física vacía ('-')\nEl sistema permitió continuar sin ubicación (Excepción 1)
deactivate view

@enduml
