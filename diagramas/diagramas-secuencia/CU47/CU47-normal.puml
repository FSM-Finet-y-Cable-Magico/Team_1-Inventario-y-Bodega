@startuml CU47-normal
title CU-47 — Registrando ubicación física de equipo en bodega (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style> sequenceDiagram { participant { Margin 35 } actor { Margin 15 } } </style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega" as user
participant "V_GestionEquipos" as view
participant "C_RolesGuard" as guard
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as uent
participant "historial_estado_equipo" as hent
participant "log_auditoria" as aent

user -> view : Abre ficha de la unidad\n(elige reingreso a bodega)\ne ingresa ubicación física\n"Estante B, Fila 3"
activate view

view -> guard : PATCH /unidades/:id/cambiar-estado\n{ nuevoEstado: "En bodega",\nubicacion_fisica: "Estante B, Fila 3",\nobservacion }
activate guard
guard --> view : Autorizado\n(ADMIN_BODEGA / ADMIN / SUPERUSUARIO)
deactivate guard

view -> ctrl : transicionarEstadoEquipo(id,\nnuevoEstado, observacion, diagnostico,\ndescripcionOtro, ubicacionFisica, actor)
activate ctrl

ctrl -> svc : transicionarEstado(unitId, "En bodega",\nactor, observacion, diagnostico,\ndescripcionOtro, simularErrorHistorial,\nubicacionFisicaPayload)
activate svc

svc -> svc : ubicacionFisica = trim(payload) || null\nvalida length ≤ 60\n(> 60 → 400 BadRequestException\n'La ubicación física no puede\nsuperar los 60 caracteres.')
activate svc
deactivate svc

svc -> orm : findOne(id_unidad, relations: tipoEquipo)
activate orm
orm -> uent : SELECT unidad_equipo\nWHERE id_unidad = :id
activate uent
uent --> orm : Datos unidad (estadoOrigen = 'Asignado a técnico')
deactivate uent
orm --> svc : unidad (existe)
deactivate orm

svc -> svc : transicionesPermitidas['Asignado a técnico']\nincluye 'En bodega' → OK\nubicacionOrigen = unidad.ubicacionFisica\nunidad.ubicacionFisica = "Estante B, Fila 3"
activate svc
deactivate svc

svc -> orm : queryRunner.startTransaction()\nqueryRunner.manager.save(unidad)
activate orm
orm -> uent : UPDATE unidad_equipo\nSET estado = 'En bodega',\nubicacion_fisica = 'Estante B, Fila 3'\nWHERE id_unidad = :id
activate uent
uent --> orm : Unidad actualizada
deactivate uent
orm --> svc : unidad guardada
deactivate orm

svc -> orm : queryRunner.manager.save(historial\n{ estadoAnterior: 'Asignado a técnico',\nestadoNuevo: 'En bodega',\nmotivo: 'Cambio de estado ordinario.\nUbicación física: Estante B, Fila 3',\nfechaHora (America/Santiago) })
activate orm
orm -> hent : INSERT historial_estado_equipo
activate hent
hent --> orm : Registro insertado
deactivate hent
orm --> svc : historial guardado
deactivate orm

svc -> orm : queryRunner.commitTransaction()
activate orm
orm --> svc : Transacción confirmada
deactivate orm

svc -> orm : auditoriaService.create({ accion:\n'CAMBIAR_ESTADO', entidad: 'unidad_equipo',\nvalor_anterior: { estado, ubicacion_fisica },\nvalor_nuevo: { estado, ubicacion_fisica } })
activate orm
orm -> aent : INSERT log_auditoria
activate aent
aent --> orm : Registro insertado
deactivate aent
orm --> svc : auditoría guardada
deactivate orm

svc --> ctrl : 200 OK { success: true, estadoActual: 'En bodega',\ndiagnostico_registrado, ubicacion_fisica: 'Estante B, Fila 3' }
deactivate svc

ctrl --> view : 200 OK
deactivate ctrl

view --> user : Ficha actualizada:\nestado 'En bodega' y ubicación física visible
deactivate view

@enduml
