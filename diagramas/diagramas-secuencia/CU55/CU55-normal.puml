@startuml CU55-NumerosSerieRecepcion-Normal
title CU-55 — Ingresando números de serie en recepción de equipos (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 35
  }
  actor {
    margin 15
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Admin/AdminBodega/\nSuperusuario" as user
participant "V_OrdenIngresoDetalle" as view
participant "C_OrdenesIngresoController" as ctrl
participant "C_OrdenesIngresoService" as svc
participant "C_CatalogService" as cat
participant "C_AuditoriaService" as aud
participant "C_QueryRunner" as qr
participant "tipo_equipo" as tent
participant "orden_ingreso" as oing
participant "orden_ingreso_detalle" as odet
participant "log_auditoria" as aent
participant "unidad_equipo" as uent

user -> view : Abre "Registrar recepción" e indica\nla cantidad recibida de un ítem\ncon requiere_serie_individual = true
activate view

view -> view : Muestra la sección de NS\ncon el contador 0 / cantidad

loop por cada unidad física recibida
  user -> view : Ingresa un NS y pulsa "Agregar"
  view -> view : Valida formato /^[A-Z0-9-]{4,30}$/\ny que no esté repetido en el listado
  view --> user : Acepta el NS y actualiza\nel contador N / cantidad
end

note right of view
  "Guardar recepción" permanece
  deshabilitado mientras el contador
  no llegue a la cantidad (Excepción 3)
end note

user -> view : Confirma la recepción

view -> ctrl : POST /api/ordenes-ingreso/{id}/recepcion\n{ items: [ { id_detalle, cantidad_recibida,\nnumeros_serie: [...] } ] }
activate ctrl

ctrl -> svc : registrarRecepcion(id, dto, actor)
activate svc

svc -> tent : SELECT * FROM tipo_equipo\nWHERE id_tipo_equipo = ?
tent --> svc : tipo (requiere_serie_individual = true)

svc -> svc : numeros_serie.length == cantidad_recibida\n(si no, Excepción 3)

loop por cada NS
  svc -> cat : validarFormatoSerialNumber(ns)
  activate cat
  cat --> svc : formato válido
  deactivate cat

  svc -> uent : SELECT * FROM unidad_equipo\nWHERE numero_serie = ?
  uent --> svc : sin coincidencias
end

svc -> qr : startTransaction()
activate qr

qr -> odet : UPDATE orden_ingreso_detalle\nSET cantidad_recibida = cantidad_recibida + ?

loop por cada NS
  qr -> uent : INSERT INTO unidad_equipo\n(numero_serie, estado='En bodega',\nid_empresa, id_bodega_actual,\nfecha_adquisicion, fecha_venc_garantia,\nproveedor)
  uent --> qr : unidad creada
end

qr -> oing : UPDATE orden_ingreso SET estado = ?
qr -> oing :COMMIT (sobre la orden_ingreso)
qr --> svc : Transacción exitosa
deactivate qr

svc -> aud : create({ accion: 'RECEPCION', orden })\ny un CREAR por cada unidad_equipo
activate aud
aud -> aent : INSERT INTO log_auditoria
aent --> aud : ok
aud --> svc : Auditoría registrada
deactivate aud

svc --> ctrl : Orden con detalles actualizados
deactivate svc

ctrl --> view : 201 Created
deactivate ctrl

view --> user : Banner "Recepción registrada" y\nunidades disponibles en\nel inventario como 'En bodega'
deactivate view

@enduml
