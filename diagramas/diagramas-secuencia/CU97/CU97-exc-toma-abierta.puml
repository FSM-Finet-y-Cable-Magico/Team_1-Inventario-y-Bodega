@startuml CU97-exc-toma-abierta
title CU-97 — Excepción E1: la bodega ya tiene una toma abierta
skinparam style strictuml
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
skinparam participant {
  BackgroundColor<<vista>> #BDD7EF
  BackgroundColor<<control>> #C7E1B5
  BackgroundColor<<persistencia>> #F9CBAD
}
skinparam database {
  BackgroundColor<<persistencia>> #F9CBAD
}
hide stereotype
hide footbox

actor "Encargado de bodega" as user
participant "V_TomaInventario" as view <<vista>>
participant "C_RolesGuard" as guard <<control>>
participant "C_TomasInventarioController" as ctrl <<control>>
participant "C_TomasInventarioService" as svc <<control>>
participant "C_AuditoriaService" as aud <<control>>
participant "C_TypeORM" as orm <<persistencia>>
database "postgres" as db <<persistencia>>

user -> view : Selecciona la bodega\ny abre la toma
activate view
view -> guard : POST /tomas-inventario\n{ id_bodega }
activate guard
guard --> view : Acceso permitido
deactivate guard
view -> ctrl : POST /tomas-inventario\n{ id_bodega }
activate ctrl
ctrl -> svc : abrir(id_bodega, actor)
activate svc
svc -> orm : Busca una toma abierta de la bodega
activate orm
orm -> db : SELECT toma_inventario\nWHERE estado = ABIERTA
db --> orm : Toma #N abierta
orm --> svc : Toma existente
deactivate orm
svc --> ctrl : ConflictException
deactivate svc
ctrl --> view : 409 Conflict
deactivate ctrl
view --> user : «La bodega ya tiene una toma abierta (#N).»
deactivate view
@enduml

