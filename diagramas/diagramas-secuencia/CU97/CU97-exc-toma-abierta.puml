@startuml CU97-exc-toma-abierta
title CU-97 — Excepción E1: la bodega ya tiene una toma abierta
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Encargado de bodega" as user
participant "V_TomaInventario" as view
participant "C_RolesGuard" as guard
participant "C_TomasInventarioController" as ctrl
participant "C_TomasInventarioService" as svc
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
database "postgres" as db

user -> view : Selecciona la bodega\ny abre la toma
activate view
view -> guard : POST /tomas-inventario\n{ id_bodega }
activate guard
guard --> view : Acceso permitido
deactivate guard
view -> ctrl : POST /tomas-inventario\n{ id_bodega }
activate ctrl
ctrl -> svc : abrir(id_bodega, actor)
activate svc
svc -> orm : Busca una toma abierta de la bodega
activate orm
orm -> db : SELECT toma_inventario\nWHERE estado = ABIERTA
db --> orm : Toma #N abierta
orm --> svc : Toma existente
deactivate orm
svc --> ctrl : ConflictException
deactivate svc
ctrl --> view : 409 Conflict
deactivate ctrl
view --> user : «La bodega ya tiene una toma abierta (#N).»
deactivate view
@enduml

