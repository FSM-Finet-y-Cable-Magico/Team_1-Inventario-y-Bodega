@startuml CU74-exc-sin-bodega
title CU-74 — Reacondicionando equipo operativo desde revisión a bodega (excepción 1: no se selecciona bodega de destino)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    padding 35
  }
  actor {
    padding 15
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega" as user
participant "V_FichaUnidad" as view
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc

user -> view : Abre el modal "Operativo - enviar a bodega"\ny hace clic en "Confirmar" SIN seleccionar\nbodega de destino
activate view

view -> view : handleReacondicionar()\nreacondicionarForm.id_bodega_destino === 0
activate view
view --> user : Muestra en el modal:\n'Debe seleccionar una bodega de destino\npara continuar.'\n(no se envía la petición, no permite confirmar)
deactivate view
deactivate view

note over view, svc
  Defensa en profundidad: si la petición llegara al backend
  sin id_bodega_destino (bypass del cliente), el servicio
  aplica la misma validación y devuelve el mismo mensaje.
end note

view -> ctrl : (hipotético) POST /unidades/:id/reacondicionar\n{ id_bodega_destino: undefined }
activate ctrl
ctrl -> svc : reacondicionarEquipo(idUnidad, dto, actor)
activate svc
svc -> svc : validarDestinoOperativo(undefined, ...)\n!idBodegaDestino → true
activate svc
deactivate svc
svc --> ctrl : throw BadRequestException\n('Debe seleccionar una bodega de destino\npara continuar.')
deactivate svc
ctrl --> view : 400 Bad Request
deactivate ctrl

@enduml
