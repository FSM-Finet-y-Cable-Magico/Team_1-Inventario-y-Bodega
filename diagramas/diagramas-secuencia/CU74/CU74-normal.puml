@startuml CU74-normal
title CU-74 — Reacondicionando equipo operativo desde revisión a bodega (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    padding 35
  }
  actor {
    padding 15
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega" as user
participant "V_FichaUnidad" as view
participant "C_RolesGuard" as guard
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as uent
participant "bodega" as bent
participant "historial_estado_equipo" as hent
participant "log_auditoria" as aent

user -> view : Abre unidad en estado\n"En revisión" y elige\n"Operativo - enviar a bodega"
activate view

view -> guard : POST /unidades/:id/reacondicionar\n{ id_bodega_destino, ubicacion_fisica?, observacion? }
activate guard
guard --> view : Autorizado\n(ADMIN_BODEGA / ADMIN / SUPERUSUARIO)
deactivate guard

view -> ctrl : reacondicionarEquipo(id, body, actor)
activate ctrl

ctrl -> svc : reacondicionarEquipo(idUnidad, dto, actor)
activate svc

svc -> orm : findOne(id_unidad, id_empresa)
activate orm
orm -> uent : SELECT unidad_equipo\nWHERE id_unidad = :id AND id_empresa = :idEmpresa
activate uent
uent --> orm : Datos unidad (estado = 'En revisión')
deactivate uent
orm --> svc : unidad (existe)
deactivate orm

svc -> svc : Precondición: estado === 'En revisión'\n(si no → 400 'Transición de estado no\npermitida para este equipo.')
activate svc
deactivate svc

svc -> svc : validarDestinoOperativo(id_bodega_destino,\nubicacion_fisica, id_empresa)\n(compartido con CU-72 "Operativo")
activate svc
deactivate svc

svc -> orm : getRepository(Bodega).findOne\n(id_bodega, id_empresa)
activate orm
orm -> bent : SELECT bodega\nWHERE id_bodega = :id AND id_empresa = :idEmpresa
activate bent
bent --> orm : bodega (existe y activa)
deactivate bent
orm --> svc : bodega
deactivate orm

svc -> svc : observación ≤ 300\nmotivoHistorial = observación o texto\npor defecto + ubicación física (si hay)

svc -> orm : queryRunner.startTransaction()\nmanager.save(unidad\n{ estado: 'En bodega', id_bodega_actual,\nubicacionFisica })
activate orm
orm -> uent : UPDATE unidad_equipo\nSET estado = 'En bodega',\nid_bodega_actual = :destino,\nubicacion_fisica = :ubicacion\nWHERE id_unidad = :id
activate uent
uent --> orm : Unidad actualizada
deactivate uent
orm --> svc : unidad guardada
deactivate orm

svc -> orm : manager.save(historial\n{ estadoAnterior: 'En revisión',\nestadoNuevo: 'En bodega', motivo: motivoHistorial })
activate orm
orm -> hent : INSERT historial_estado_equipo
activate hent
hent --> orm : Registro insertado
deactivate hent
orm --> svc : historial guardado
deactivate orm

svc -> orm : queryRunner.commitTransaction()
activate orm
orm --> svc : Transacción confirmada
deactivate orm

svc -> orm : auditoriaService.create({ accion:\n'CAMBIAR_ESTADO', entidad: 'unidad_equipo',\nvalor_anterior: { estado: 'En revisión' },\nvalor_nuevo: { estado: 'En bodega', ubicacion_fisica,\nid_bodega_actual } })
activate orm
orm -> aent : INSERT log_auditoria
activate aent
aent --> orm : Registro insertado
deactivate aent
orm --> svc : auditoría guardada
deactivate orm

svc --> ctrl : 201 Created { success: true,\nestadoActual: 'En bodega', id_bodega_actual,\nubicacion_fisica }
deactivate svc

ctrl --> view : 201 Created
deactivate ctrl

view --> user : Ficha actualizada: estado "En bodega",\nbodega y ubicación física visibles,\nhistorial actualizado
deactivate view

@enduml
