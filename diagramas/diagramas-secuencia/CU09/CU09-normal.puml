@startuml CU09-normal
title CU-09 — Consultando log de auditoría (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 25
skinparam ActorPadding 20
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Auditoria" as view
participant "C_RolesGuard" as guard
participant "C_AuditoriaController" as ctrl
participant "C_AuditoriaService" as svc
participant "C_TypeORM" as orm
participant "log_auditoria" as aent

user -> view : Ingresa filtros opcionales\n(id_usuario, accion,\nfecha_inicio, fecha_fin,\npagina, limite)
activate view

view -> guard : GET /auditoria?[filtros]
activate guard

guard -> guard : Verifica JWT y rol ADMIN
activate guard
deactivate guard

guard -> ctrl : Solicitud autorizada
deactivate guard
activate ctrl

ctrl -> svc : findAll(filtros: FiltrarAuditoriaDto)
activate svc

svc -> svc : Construye where:\naplica filtros id_usuario,\naccion, Between(fecha_inicio,\nfecha_fin); pagina y limite
activate svc
deactivate svc

svc -> orm : find({ where, skip:\n(pagina-1)*limite, take: limite })
activate orm

orm -> aent : SELECT log_auditoria\nWHERE [filtros]\nLIMIT limite OFFSET skip
activate aent
aent --> orm : Lista de registros
deactivate aent

orm --> svc : Auditoria[]
deactivate orm

svc --> ctrl : Auditoria[]
deactivate svc

ctrl --> view : 200 OK\n[ { ...registros } ]
deactivate ctrl

view --> user : Muestra tabla con\nregistros de auditoría
deactivate view

@enduml
