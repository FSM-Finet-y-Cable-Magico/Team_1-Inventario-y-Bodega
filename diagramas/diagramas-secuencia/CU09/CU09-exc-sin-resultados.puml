@startuml CU09-exc-sin-resultados
title CU-09 — Consultar log de auditoría (excepción: sin resultados)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Auditoria" as view
participant "C_RolesGuard" as guard
participant "C_AuditoriaController" as ctrl
participant "C_AuditoriaService" as svc
participant "C_TypeORM" as orm
participant "log_auditoria" as aent

user -> view : Ingresa filtros sin\ncoincidencias en la BD
activate view

view -> guard : GET /auditoria?[filtros]
activate guard

guard -> guard : Verifica JWT y rol ADMIN
activate guard
deactivate guard

guard -> ctrl : Solicitud autorizada
deactivate guard
activate ctrl

ctrl -> svc : findAll(filtros: FiltrarAuditoriaDto)
activate svc

svc -> svc : Construye where:\naplica filtros id_usuario,\naccion, Between(fecha_inicio,\nfecha_fin); pagina y limite
activate svc
deactivate svc

svc -> orm : find({ where, skip:\n(pagina-1)*limite, take: limite })
activate orm

orm -> aent : SELECT log_auditoria\nWHERE [filtros]\nLIMIT limite OFFSET skip
activate aent
aent --> orm : (sin resultados)
deactivate aent

orm --> svc : []
deactivate orm

svc --> ctrl : [] (lista vacía —\n'No se encontraron eventos\ncon los filtros seleccionados.')
deactivate svc

ctrl --> view : 200 OK []
deactivate ctrl

view --> user : Muestra mensaje\n'No se encontraron eventos\ncon los filtros seleccionados.'
deactivate view

@enduml
