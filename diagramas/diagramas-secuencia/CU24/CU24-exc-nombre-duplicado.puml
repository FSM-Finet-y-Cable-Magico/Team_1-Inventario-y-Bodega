@startuml CU24-exc-nombre-duplicado
title CU-24 — Creando tipo de equipo en el catálogo (excepción: nombre duplicado en el catálogo)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_CrearTipoEquipo" as view
participant "C_CatalogController" as ctrl
participant "C_CatalogService" as svc
participant "C_TypeORM" as orm
participant "tipo_equipo" as tent

user -> view : Completa formulario con\nun nombre ya existente\nen el catálogo
activate view

view -> ctrl : POST /catalogo\n{ nombre, categoria,\nrequiereSerialNumber }
activate ctrl

ctrl -> svc : crearTipo({ nombre, categoria,\nrequiereSerialNumber,\nid_empresa: actor.id_empresa })
activate svc

svc -> svc : Valida campos obligatorios:\nnombre, categoria,\nrequiereSerialNumber definido
activate svc
deactivate svc

svc -> orm : findOne({ nombre, id_empresa,\nactivo: true })
activate orm

orm -> tent : SELECT tipo_equipo\nWHERE nombre = :nombre\nAND id_empresa = :id_empresa\nAND activo = true
activate tent
tent --> orm : TipoEquipo (ya existe)
deactivate tent

orm --> svc : TipoEquipo existente
deactivate orm

svc --> ctrl : throw ConflictException\n('Restricción de catálogo: Ya existe un tipo\nde equipo registrado con el nombre\n[:nombre] para esta empresa.')
deactivate svc

ctrl --> view : 409 Conflict\n{ message: "Ya existe un tipo de equipo\nregistrado con ese nombre\npara esta empresa." }
deactivate ctrl

view --> user : Muestra mensaje de\nconflicto: nombre duplicado\nen el catálogo
deactivate view

@enduml
