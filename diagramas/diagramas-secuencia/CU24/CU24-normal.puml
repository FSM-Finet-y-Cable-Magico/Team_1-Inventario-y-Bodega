@startuml CU24-normal
title CU-24 — Creando tipo de equipo en el catálogo (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_CrearTipoEquipo" as view
participant "C_CatalogController" as ctrl
participant "C_CatalogService" as svc
participant "C_TypeORM" as orm
participant "tipo_equipo" as tent

user -> view : Completa formulario:\nnombre, categoría,\nrequiereSerialNumber,\nunidadMedida (si aplica)
activate view

view -> ctrl : POST /catalogo\n{ nombre, categoria,\nrequiereSerialNumber,\nunidadMedida }
activate ctrl

ctrl -> svc : crearTipo({ nombre, categoria,\nrequiereSerialNumber,\nunidadMedida,\nid_empresa: actor.id_empresa })
activate svc

svc -> svc : Valida campos obligatorios:\nnombre, categoria,\nrequiereSerialNumber definido
activate svc
deactivate svc

svc -> svc : Si requiereSerialNumber == false:\nvalida que unidadMedida exista\ny concatena a categoría
activate svc
deactivate svc

svc -> orm : findOne({ nombre, id_empresa,\nactivo: true })
activate orm

orm -> tent : SELECT tipo_equipo\nWHERE nombre = :nombre\nAND id_empresa = :id_empresa\nAND activo = true
activate tent
tent --> orm : null (no existe duplicado)
deactivate tent

orm --> svc : null
deactivate orm

svc -> orm : save(nuevoTipo)
activate orm

orm -> tent : INSERT tipo_equipo\n(id_empresa, nombre, categoria,\nrequiere_serie_individual, activo)
activate tent
tent --> orm : Registro creado
deactivate tent

orm --> svc : TipoEquipo guardado
deactivate orm

svc --> ctrl : TipoEquipo { id_tipo_equipo,\nnombre, categoria,\nrequiereSerialNumber, activo }
deactivate svc

ctrl --> view : 201 Created\n{ id_tipo_equipo, nombre,\ncategoria, requiereSerialNumber,\nactivo }
deactivate ctrl

view --> user : Muestra tipo de equipo\ncreado en el catálogo
deactivate view

@enduml
