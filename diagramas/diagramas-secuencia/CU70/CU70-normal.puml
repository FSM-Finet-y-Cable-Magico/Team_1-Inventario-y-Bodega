@startuml CU70-normal
title CU-70 — Seleccionando tipo de trabajo codificado para cierre (flujo normal)
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 30
  }
  actor {
    margin 12
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Técnico de terreno" as tec
participant "V_MiJornada" as vista
participant "C_CierresTrabajoController" as ctrl
participant "C_CierresTrabajoService" as svc
participant "TIPOS_TRABAJO (catálogo T-01..T-10)" as cat
participant "borrador_cierre" as bor
participant "log_auditoria" as aud
participant "C_IntegracionesService (webhook G3)" as intg
participant "cierre_reparacion" as crep

note over tec : El cierre de la OT lo confirma G3 (CU-63);\naquí el técnico prepara los datos del cierre

tec -> vista : Abre "Preparar cierre" de la OT 900
activate vista
vista -> ctrl : GET /api/tipos-trabajo?tipo_ot=REPARACION
activate ctrl
ctrl -> svc : listarTiposTrabajo('REPARACION')
activate svc
svc -> cat : filtra los códigos del tipo de OT\n(los de tipo AMBOS siempre aplican)
cat --> svc : T-04..T-10 con sus campos predefinidos
svc --> ctrl : catálogo
deactivate svc
ctrl --> vista : 200 [{ codigo, nombre, campos, materiales_sugeridos }]
deactivate ctrl

vista -> ctrl : GET /api/cierres-trabajo/borradores/900
activate ctrl
ctrl -> svc : obtenerBorrador(900, actor)
activate svc
svc -> bor : SELECT WHERE id_ot y id_empresa del actor
bor --> svc : sin borrador previo
svc --> ctrl : null
deactivate svc
ctrl --> vista : 200 null
deactivate ctrl

tec -> vista : Selecciona T-06 Reparación fibra
vista -> vista : aplicarTipo('T-06'):\nprecompleta falla, solución, resultado y categoría\ncon los campos del código (no pisa lo ya escrito)
vista --> tec : Campos precompletados + materiales sugeridos

tec -> vista : Ajusta los textos según la situación real y guarda
vista -> ctrl : PATCH /api/cierres-trabajo/borradores/900\n{ codigo_trabajo: 'T-06', falla, solución, resultado, categoría }
activate ctrl
ctrl -> svc : guardarBorrador(900, datos, actor)
activate svc
svc -> svc : valida el código contra el catálogo\ny el resultado (RESUELTO | PARCIAL | SIN_SOLUCION)
svc -> bor : INSERT / UPDATE (uno por OT y empresa)
activate bor
bor --> svc : id_borrador
deactivate bor
svc -> aud : auditoriaService.create(CREAR_BORRADOR_CIERRE)
svc --> ctrl : borrador guardado
deactivate svc
ctrl --> vista : 200 borrador
deactivate ctrl
vista --> tec : "Cierre preparado. Se aplicará cuando G3 cierre la OT."
deactivate vista

== Más tarde: G3 cierra la orden de trabajo ==

intg -> bor : completarDesdeBorrador(900, empresa)
activate intg
bor --> intg : borrador T-06 con sus campos
intg -> cat : campos del código para lo que no trae el borrador
cat --> intg : falla, solución, resultado y categoría predefinidos
intg -> crep : INSERT cierre_reparacion\n(CU-69, con codigo_trabajo = 'T-06')
intg -> aud : auditoría CIERRE_REPARACION\n(incluye el codigo_trabajo)
deactivate intg

@enduml
