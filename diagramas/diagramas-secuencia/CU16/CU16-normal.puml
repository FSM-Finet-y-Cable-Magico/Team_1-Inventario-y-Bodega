@startuml CU16-normal
title CU-16 — Consultando datos aislados por empresa (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Catalogo" as view
participant "C_CompanyIsolationGuard" as guard
participant "C_CatalogController" as ctrl
participant "C_CatalogService" as svc
participant "C_TypeORM" as orm
participant "tipo_equipo" as tent

user -> view : Solicita consultar catálogo
activate view

view -> guard : GET /catalogo\n(JWT en cabecera)
activate guard

guard -> guard : canActivate():\nextraer user = request.user
activate guard
deactivate guard

guard -> guard : Verificar user.id_empresa\nexiste en el token JWT
activate guard
deactivate guard

guard -> ctrl : request.companyContextId\n= user.id_empresa → continúa
deactivate guard
activate ctrl

ctrl -> svc : consultar({ id_empresa:\nactor.id_empresa, ...filtros })
activate svc

svc -> orm : createQueryBuilder('tipo')\n.where('tipo.id_empresa = :id_empresa')
activate orm

orm -> tent : SELECT tipo_equipo\nWHERE id_empresa = :id_empresa
activate tent
tent --> orm : Lista tipos de equipo\nde la empresa
deactivate tent

orm --> svc : resultados[]
deactivate orm

svc --> ctrl : Lista tipos de equipo\nfiltrada por empresa
deactivate svc

ctrl --> view : 200 OK\n[ { id_tipo_equipo, nombre,\ncategoria, activo, ... } ]
deactivate ctrl

view --> user : Muestra catálogo\nde su empresa
deactivate view

@enduml
