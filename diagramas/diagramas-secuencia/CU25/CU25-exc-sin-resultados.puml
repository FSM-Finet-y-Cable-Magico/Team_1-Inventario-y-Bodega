@startuml CU25-exc-sin-resultados
title CU-25 — Consultando catálogo de tipos de equipo (excepción: sin resultados)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Catalogo" as view
participant "C_RolesGuard" as guard
participant "C_CatalogController" as ctrl
participant "C_CatalogService" as svc
participant "C_TypeORM" as orm
participant "tipo_equipo" as ent

user -> view : Consulta catálogo\ncon filtros sin coincidencias
activate view

view -> guard : GET /catalogo\n?categoria=&activo=&buscar=
activate guard

guard --> view : Roles permitidos\n(ADMIN, SUPERUSUARIO,\nADMIN_BODEGA)
deactivate guard

view -> ctrl : buscarCatalogo(query, actor)
activate ctrl

ctrl -> svc : consultar({ categoria,\nactivo, buscar,\nid_empresa })
activate svc

svc -> orm : createQueryBuilder('tipo')\n.where(id_empresa)\n.andWhere(filtros)\n.getMany()
activate orm

orm -> ent : SELECT tipo_equipo\nWHERE id_empresa\n[AND filtros]
activate ent

ent --> orm : (sin resultados)
deactivate ent

orm --> svc : [] (array vacío)
deactivate orm

svc --> ctrl : throw NotFoundException\n('No se encontraron tipos de equipos\nen el catálogo que coincidan con\nlos filtros de búsqueda seleccionados.')
deactivate svc

ctrl --> view : 404 Not Found
deactivate ctrl

view --> user : Muestra "No se encontraron\ntipos de equipo con\nlos filtros seleccionados"
deactivate view

@enduml
