@startuml CU25-normal
title CU-25 — Consultando catálogo de tipos de equipo (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Catalogo" as view
participant "C_RolesGuard" as guard
participant "C_CatalogController" as ctrl
participant "C_CatalogService" as svc
participant "C_TypeORM" as orm
participant "tipo_equipo" as ent

user -> view : Consulta catálogo\n(filtros: categoria,\nactivo, buscar)
activate view

view -> guard : GET /catalogo\n?categoria=&activo=&buscar=
activate guard

guard --> view : Roles permitidos\n(ADMIN, SUPERUSUARIO,\nADMIN_BODEGA)
deactivate guard

view -> ctrl : buscarCatalogo(query, actor)
activate ctrl

ctrl -> svc : consultar({ categoria,\nactivo, buscar,\nid_empresa })
activate svc

svc -> orm : createQueryBuilder('tipo')\n.where(id_empresa)\n.andWhere(filtros)\n.getMany()
activate orm

orm -> ent : SELECT tipo_equipo\nWHERE id_empresa\n[AND categoria]\n[AND activo]\n[AND nombre ILIKE]
activate ent

ent --> orm : Lista de tipos de equipo
deactivate ent

orm --> svc : resultados (array no vacío)
deactivate orm

svc --> ctrl : Lista tipos de equipo
deactivate svc

ctrl --> view : 200 OK\n[ { id_tipo_equipo, nombre,\ncategoria, activo, ... } ]
deactivate ctrl

view --> user : Muestra catálogo\nde tipos de equipo
deactivate view

@enduml
