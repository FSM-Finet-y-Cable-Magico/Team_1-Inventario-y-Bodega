@startuml CU35-normal
title CU-35 — Gestionando transición de estado de equipo (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_GestionEquipos" as view
participant "C_RolesGuard" as guard
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as uent
participant "historial_estado_equipo" as hent

user -> view : Selecciona equipo y\nnuevo estado deseado
activate view

view -> guard : PATCH /unidades/:id/cambiar-estado\n{ nuevoEstado, observacion }
activate guard
guard --> view : Autorizado\n(ADMIN / ADMIN_BODEGA / TECNICO_TERRENO)
deactivate guard

view -> ctrl : transicionarEstadoEquipo(id,\nnuevoEstado, observacion, diagnostico, actor)
activate ctrl

ctrl -> svc : transicionarEstado(unitId,\nnuevoEstado, actor, observacion, diagnostico)
activate svc

svc -> orm : findOne(id_unidad, relations: tipoEquipo)
activate orm
orm -> uent : SELECT unidad_equipo\nWHERE id_unidad = :id
activate uent
uent --> orm : Datos unidad (estado actual)
deactivate uent
orm --> svc : unidad (existe)
deactivate orm

svc -> svc : Consulta transicionesPermitidas[estadoOrigen]\n— verifica que nuevoEstado sea permitido
activate svc
deactivate svc

svc -> orm : queryRunner.startTransaction()\nqueryRunner.manager.save(unidad\ncon estado = nuevoEstado)
activate orm
orm -> uent : UPDATE unidad_equipo\nSET estado = nuevoEstado\nWHERE id_unidad = :id
activate uent
uent --> orm : Unidad actualizada
deactivate uent
orm --> svc : unidad guardada
deactivate orm

svc -> orm : queryRunner.manager.save(historial\n{ id_unidad, id_usuario, estadoAnterior,\nestadoNuevo, motivo, fechaHora })
activate orm
orm -> hent : INSERT historial_estado_equipo
activate hent
hent --> orm : Registro insertado
deactivate hent
orm --> svc : historial guardado
deactivate orm

svc -> orm : queryRunner.commitTransaction()
activate orm
orm --> svc : Transacción confirmada
deactivate orm

svc --> ctrl : { success: true,\nestadoActual, diagnostico_registrado }
deactivate svc

ctrl --> view : 200 OK\n{ success, estadoActual }
deactivate ctrl

view --> user : Muestra nuevo estado del equipo
deactivate view

@enduml
