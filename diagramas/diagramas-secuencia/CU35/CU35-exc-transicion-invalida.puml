@startuml CU35-exc-transicion-invalida
title CU-35 — Gestionando transición de estado de equipo\n(excepción: transición de estado no permitida)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_GestionEquipos" as view
participant "C_RolesGuard" as guard
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as uent

user -> view : Selecciona equipo y\nnuevo estado no permitido
activate view

view -> guard : PATCH /unidades/:id/cambiar-estado\n{ nuevoEstado, observacion }
activate guard
guard --> view : Autorizado
deactivate guard

view -> ctrl : transicionarEstadoEquipo(id,\nnuevoEstado, observacion, diagnostico, actor)
activate ctrl

ctrl -> svc : transicionarEstado(unitId,\nnuevoEstado, actor, observacion, diagnostico)
activate svc

svc -> orm : findOne(id_unidad, relations: tipoEquipo)
activate orm
orm -> uent : SELECT unidad_equipo\nWHERE id_unidad = :id
activate uent
uent --> orm : Datos unidad (estadoOrigen)
deactivate uent
orm --> svc : unidad (existe)
deactivate orm

svc -> svc : Consulta transicionesPermitidas[estadoOrigen]\n— nuevoEstado NO está en la lista permitida
activate svc
deactivate svc

svc --> ctrl : throw BadRequestException\n('Transición inválida. No se puede pasar\nde [estadoOrigen] a [nuevoEstado].')
deactivate svc

ctrl --> view : 400 Bad Request
deactivate ctrl

view --> user : Muestra "Transición inválida."
deactivate view

@enduml