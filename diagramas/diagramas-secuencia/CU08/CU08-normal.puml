@startuml CU08-normal
title CU-08 — Registrando evento en el log de auditoría (flujo normal — contexto: inicio de sesión)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    Margin 35
  }
  actor {
    Margin 15
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Login" as view
participant "C_AuthController" as ctrl
participant "C_AuthService" as caller
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "usuario" as uent
participant "log_auditoria" as aent

user -> view : Ingresa nombre_usuario\ny password
activate view

view -> ctrl : POST /auth/login\n{ nombre_usuario, password }
activate ctrl

ctrl -> caller : login(loginDto)
activate caller

caller -> orm : findOne(usuario por\nnombre_usuario, con roles)
activate orm

orm -> uent : SELECT usuario\nJOIN usuario_rol JOIN rol\nWHERE nombre_usuario
activate uent
uent --> orm : Datos usuario + roles
deactivate uent

orm --> caller : Usuario (existe y activo)
deactivate orm

caller -> caller : Valida password y genera token:\nbcrypt.compare(...) +\njwtService.signAsync(payload)
activate caller
deactivate caller

caller -> aud : create({ id_usuario, accion: 'LOGIN',\nentidad_afectada: 'usuario',\nid_entidad_afectada, valor_nuevo })
activate aud

aud -> orm : auditoriaRepository.create(\ncreateAuditoriaDto)
activate orm
orm --> aud : Instancia Auditoria\n(en memoria)
deactivate orm

aud -> orm : auditoriaRepository.save(auditoria)
activate orm

orm -> aent : INSERT log_auditoria\n(id_usuario, accion, entidad_afectada,\nid_entidad_afectada, valor_anterior,\nvalor_nuevo, fecha_hora)
activate aent
aent --> orm : Registro guardado
deactivate aent

orm --> aud : Entidad Auditoria guardada
deactivate orm

aud --> caller : Auditoría registrada
deactivate aud

caller --> ctrl : { access_token, usuario }
deactivate caller

ctrl --> view : 200 OK\n{ access_token, usuario }
deactivate ctrl

view --> user : Redirige al dashboard
deactivate view

@enduml
