@startuml CU32-exc-mac-invalida
title CU-32 — Registrando unidad de equipo individualizable\n(excepción: dirección MAC inválida o duplicada)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 25
skinparam ActorPadding 20
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_RegistrarUnidad" as view
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as uent

user -> view : Ingresa numero_serie válido\ny dirección MAC inválida\no ya existente
activate view

view -> ctrl : POST /unidades\n{ id_tipo_equipo, numero_serie,\nmac_address, id_bodega_actual }
activate ctrl

ctrl -> svc : registrarUnidad(dto, id_empresa)
activate svc

svc -> orm : findOne(unidad_equipo\npor mac_address)
activate orm

orm -> uent : SELECT unidad_equipo\nWHERE mac_address
activate uent
uent --> orm : Resultado (duplicada)\no formato inválido detectado
deactivate uent

orm --> svc : UnidadEquipo (MAC duplicada)\no validación fallida
deactivate orm

svc --> ctrl : throw BadRequestException /\nConflictException\n('Dirección MAC inválida\no ya registrada')
deactivate svc

ctrl --> view : 400 Bad Request / 409 Conflict\n{ message: 'La dirección MAC\nes inválida o ya existe' }
deactivate ctrl

view --> user : Muestra error de\nvalidación MAC
deactivate view

@enduml