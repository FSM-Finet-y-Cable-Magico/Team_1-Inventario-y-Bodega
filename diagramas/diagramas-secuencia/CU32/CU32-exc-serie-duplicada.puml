@startuml CU32-exc-serie-duplicada
title CU-32 — Registrando unidad de equipo individualizable\n(excepción: número de serie ya registrado en el sistema)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_RegistrarUnidad" as view
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_CatalogService" as cat
participant "C_TypeORM" as orm
participant "tipo_equipo" as tent
participant "unidad_equipo" as uent

user -> view : Ingresa numero_serie que\nya existe en el inventario
activate view

view -> ctrl : POST /unidades\n{ id_tipo_equipo, numero_serie,\nid_bodega_actual }
activate ctrl

ctrl -> svc : registrarUnidad(dto, id_empresa)
activate svc

svc -> cat : determinarNaturalezaEquipo(\nid_tipo_equipo, id_empresa)
activate cat

cat -> orm : findOne(tipo_equipo\npor id_tipo_equipo, id_empresa)
activate orm

orm -> tent : SELECT tipo_equipo\nWHERE id_tipo_equipo\nAND id_empresa
activate tent
tent --> orm : Datos tipo_equipo
deactivate tent

orm --> cat : TipoEquipo (INDIVIDUALIZABLE)
deactivate orm

cat --> svc : { clasificacion: 'INDIVIDUALIZABLE' }
deactivate cat

svc -> cat : validarFormatoSerialNumber(\nnumero_serie.trim())
activate cat

cat -> cat : Evalúa regex\n/^[A-Z0-9-]{4,30}$/\n→ pasa (formato válido)
activate cat
deactivate cat

cat --> svc : true
deactivate cat

svc -> orm : findOne(unidad_equipo\npor serialNumber)
activate orm

orm -> uent : SELECT unidad_equipo\nWHERE numero_serie = serieNormalizada
activate uent
uent --> orm : UnidadEquipo existente
deactivate uent

orm --> svc : UnidadEquipo (ya registrada)
deactivate orm

svc --> ctrl : throw ConflictException\n('El número de serie [X] ya se\nencontra registrado en el sistema\nen el estado [Y]')
deactivate svc

ctrl --> view : 409 Conflict\n{ message: 'Conflicto de Inventario:\nEl número de serie ya existe' }
deactivate ctrl

view --> user : Muestra "El número de serie\nya se encuentra registrado\nen el sistema"
deactivate view

@enduml
