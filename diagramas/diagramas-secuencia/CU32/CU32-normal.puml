@startuml CU32-normal
title CU-32 — Registrando unidad de equipo individualizable (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    Margin 35
  }
  actor {
    Margin 15
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_RegistrarUnidad" as view
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_CatalogService" as cat
participant "C_TypeORM" as orm
participant "tipo_equipo" as tent
participant "unidad_equipo" as uent

user -> view : Ingresa id_tipo_equipo,\nnumero_serie, id_bodega_actual\ny datos opcionales
activate view

view -> ctrl : POST /unidades\n{ id_tipo_equipo, numero_serie,\nid_bodega_actual, modelo, fechas }
activate ctrl

ctrl -> svc : registrarUnidad(dto, id_empresa)
activate svc

svc -> cat : determinarNaturalezaEquipo(\nid_tipo_equipo, id_empresa)
activate cat

cat -> orm : findOne(tipo_equipo\npor id_tipo_equipo, id_empresa)
activate orm

orm -> tent : SELECT tipo_equipo\nWHERE id_tipo_equipo\nAND id_empresa
activate tent
tent --> orm : Datos tipo_equipo
deactivate tent

orm --> cat : TipoEquipo (existe)
deactivate orm

cat --> svc : { clasificacion: 'INDIVIDUALIZABLE',\nobligaSerialNumber: true }
deactivate cat

svc -> cat : validarFormatoSerialNumber(\nnumero_serie.trim())
activate cat

cat -> cat : Evalúa regex\n/^[A-Z0-9-]{4,30}$/
activate cat
deactivate cat

cat --> svc : true (formato válido)
deactivate cat

svc -> orm : findOne(unidad_equipo\npor serialNumber)
activate orm

orm -> uent : SELECT unidad_equipo\nWHERE numero_serie
activate uent
uent --> orm : null (no existe)
deactivate uent

orm --> svc : null
deactivate orm

svc -> orm : save(nuevaUnidad)
activate orm

orm -> uent : INSERT unidad_equipo\n(id_tipo_equipo, id_empresa,\nnumero_serie, estado='En bodega',\nid_bodega_actual, fechas)
activate uent
uent --> orm : Unidad guardada
deactivate uent

orm --> svc : UnidadEquipo guardada
deactivate orm

svc --> ctrl : { success: true,\nid_unidad, numero_serie,\nestado: 'En bodega' }
deactivate svc

ctrl --> view : 201 Created\n{ success: true, id_unidad,\nnumero_serie, estado }
deactivate ctrl

view --> user : Muestra confirmación\nde registro exitoso
deactivate view

@enduml
