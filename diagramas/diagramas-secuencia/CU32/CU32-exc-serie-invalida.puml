@startuml CU32-exc-serie-invalida
title CU-32 — Registrando unidad de equipo individualizable\n(excepción: número de serie con formato inválido)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_RegistrarUnidad" as view
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_CatalogService" as cat
participant "C_TypeORM" as orm
participant "tipo_equipo" as tent

user -> view : Ingresa id_tipo_equipo,\nnumero_serie con formato inválido\n(ej: "AB 1@", espacios/especiales)
activate view

view -> ctrl : POST /unidades\n{ id_tipo_equipo, numero_serie,\nid_bodega_actual }
activate ctrl

ctrl -> svc : registrarUnidad(dto, id_empresa)
activate svc

svc -> cat : determinarNaturalezaEquipo(\nid_tipo_equipo, id_empresa)
activate cat

cat -> orm : findOne(tipo_equipo\npor id_tipo_equipo, id_empresa)
activate orm

orm -> tent : SELECT tipo_equipo\nWHERE id_tipo_equipo\nAND id_empresa
activate tent
tent --> orm : Datos tipo_equipo
deactivate tent

orm --> cat : TipoEquipo (INDIVIDUALIZABLE)
deactivate orm

cat --> svc : { clasificacion: 'INDIVIDUALIZABLE' }
deactivate cat

svc -> cat : validarFormatoSerialNumber(\nnumero_serie.trim())
activate cat

cat -> cat : Evalúa regex\n/^[A-Z0-9-]{4,30}$/\n→ falla (formato inválido)
activate cat
deactivate cat

cat --> svc : throw BadRequestException\n('El formato del numero de serie\nes invalido...')
deactivate cat

svc --> ctrl : throw BadRequestException
deactivate svc

ctrl --> view : 400 Bad Request\n{ message: 'El formato del numero\nde serie es invalido...' }
deactivate ctrl

view --> user : Muestra "Número de serie inválido.\nDebe contener entre 4 y 30\ncaracteres alfanuméricos y guiones"
deactivate view

@enduml