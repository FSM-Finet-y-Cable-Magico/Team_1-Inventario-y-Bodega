@startuml CU51-Consultar-Proveedores-Normal
title CU-51 — Consultando listado de proveedores (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    padding 25
  }
  actor {
    padding 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Admin/AdminBodega/\nSuperusuario" as user
participant "V_Proveedores" as view
participant "C_ProveedoresController" as ctrl
participant "C_ProveedoresService" as svc
participant "C_TypeORM" as orm
participant "proveedor" as pent
participant "proveedor_tipo_equipo" as pte

user -> view : Navega a\n/proveedores
activate view

view -> ctrl : GET /api/proveedores\n?buscar=&activa=true
activate ctrl

ctrl -> svc : findAll(buscar, activa)
activate svc

svc -> orm : find(proveedor\ncon filtros)
activate orm

orm -> pent : SELECT proveedor\nWHERE activa = true\nORDER BY nombre_comercial
activate pent
pent --> orm : Proveedor[] (N registros)
deactivate pent

orm --> svc : Proveedor[]
deactivate orm

svc -> orm : find(proveedor_tipo_equipo\npor proveedores)
activate orm

orm -> pte : SELECT pte\nJOIN tipo_equipo\nWHERE id_proveedor IN (...)
activate pte
pte --> orm : PivotRows[]
deactivate pte

orm --> svc : Tipos por proveedor
deactivate orm

svc --> ctrl : Proveedor[] + tipos_equipo
deactivate svc

ctrl --> view : 200 OK\n[ { proveedor, tipos_equipo }... ]
deactivate ctrl

view --> user : Muestra tabla de proveedores\ncon nombre, RUT, contacto,\ntipos de equipo
deactivate view

@enduml
