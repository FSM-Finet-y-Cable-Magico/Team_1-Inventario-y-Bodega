@startuml CU43-normal
title CU-43 — Desactivando bodega (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 25
skinparam ActorPadding 20
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Bodegas" as view
participant "C_BodegasController" as ctrl
participant "C_BodegasService" as svc
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "bodega" as bent
participant "log_auditoria" as aent

user -> view : Solicita desactivar bodega
activate view

view -> ctrl : DELETE /bodegas/:id/desactivar
activate ctrl

ctrl -> svc : deactivate(id, actorId)
activate svc

svc -> orm : findOne(bodega WHERE id_bodega = id)
activate orm

orm -> bent : SELECT bodega\nWHERE id_bodega = id
activate bent
bent --> orm : Bodega encontrada
deactivate bent

orm --> svc : Bodega (activa = true)
deactivate orm

svc -> orm : count(bodega WHERE\nid_empresa = bodega.id_empresa\nAND activa = true)
activate orm

orm -> bent : SELECT COUNT(*) bodega\nWHERE id_empresa AND activa = true
activate bent
bent --> orm : count > 1
deactivate bent

orm --> svc : activeCount > 1
deactivate orm

svc -> svc : bodega.activa = false
activate svc
deactivate svc

svc -> orm : save(bodega)
activate orm

orm -> bent : UPDATE bodega\nSET activa = false\nWHERE id_bodega = id
activate bent
bent --> orm : Bodega actualizada
deactivate bent

orm --> svc : bodegaActualizada
deactivate orm

svc -> aud : create({ accion: 'DESACTIVAR',\nentidad_afectada: 'bodega',\nid_entidad_afectada, valor_anterior,\nvalor_nuevo })
activate aud

aud -> orm : save(log)
activate orm

orm -> aent : INSERT log_auditoria
activate aent
aent --> orm : Registrado
deactivate aent

orm --> aud : Log guardado
deactivate orm

aud --> svc : Auditoría registrada
deactivate aud

svc --> ctrl : bodegaActualizada
deactivate svc

ctrl --> view : 200 OK\n{ bodega desactivada }
deactivate ctrl

view --> user : Bodega desactivada exitosamente
deactivate view

@enduml
