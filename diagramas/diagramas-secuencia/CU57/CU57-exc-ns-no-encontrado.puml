@startuml CU57-exc-ns-no-encontrado
title CU-57 — Registrando salida de equipos de bodega a técnico (excepción: número de serie no encontrado)
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 30
  }
  actor {
    margin 12
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega" as user
participant "V_Salidas" as view
participant "C_UnitsController" as uctrl
participant "C_UnitsService" as usvc
participant "C_SalidasController" as ctrl
participant "C_SalidasService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as uent
participant "salida_bodega" as sald

user -> view : Ingresa un NS inexistente y lo agrega
activate view

view -> uctrl : GET /api/unidades/serie/{ns}?id_bodega=N\n(validación en vivo, CU-59)
activate uctrl

uctrl -> usvc : verificarSerie(ns, id_empresa, id_bodega)
activate usvc

usvc -> uent : SELECT * FROM unidad_equipo\nWHERE numero_serie = ? AND id_empresa = ?
activate uent
uent --> usvc : sin filas
deactivate uent

usvc --> uctrl : 200 { existe: false, disponible: false }
deactivate usvc

uctrl --> view : 200
deactivate uctrl

view --> user : Marca el NS en rojo:\n'Número de serie no encontrado.'\nDeshabilita Confirmar

user -> view : Confirma de todos modos\n(quedaba un NS inválido en el listado)

view -> ctrl : POST /api/salidas (re-valida de verdad)
activate ctrl

ctrl -> svc : registrarSalida(dto, idEmpresa, actor)
activate svc

svc -> orm : QueryRunner.connect()\n+ startTransaction()
activate orm
orm --> svc : Transacción iniciada
deactivate orm

svc -> orm : manager.save(SalidaBodega, { ... })
activate orm
orm -> sald : INSERT INTO salida_bodega
activate sald
sald --> orm : salida #N
deactivate sald
orm --> svc : salida #N
deactivate orm

svc -> orm : procesarItemUnidad(...)\nfindOne(UnidadEquipo, { numero_serie, id_empresa })
activate orm
orm -> uent : SELECT * FROM unidad_equipo\nWHERE numero_serie = ? AND id_empresa = ?
activate uent
uent --> orm : sin filas
deactivate uent
orm --> svc : null
deactivate orm

svc -> svc : unidad no encontrada -> Excepción (CU-59)
activate svc
deactivate svc

svc -> orm : QueryRunner.rollbackTransaction()
activate orm
orm --> svc : Rollback total (nada queda aplicado)
deactivate orm

svc -> orm : QueryRunner.release()
activate orm
orm --> svc : Conexión liberada
deactivate orm

svc --> ctrl : throw NotFoundException\n('Número de serie no encontrado.')
deactivate svc

ctrl --> view : 404 Not Found
deactivate ctrl

view --> user : Banner de error con el mensaje exacto
deactivate view
@enduml
