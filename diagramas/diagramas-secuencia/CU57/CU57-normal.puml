@startuml CU57-normal
title CU-57 — Registrando salida de equipos de bodega a técnico (flujo normal)
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 30
  }
  actor {
    margin 12
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega" as user
participant "V_Salidas" as view
participant "C_RolesGuard" as guard
participant "C_SalidasController" as ctrl
participant "C_SalidasService" as svc
participant "C_InventarioPersonalService" as ips
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "usuario" as usr
participant "bodega" as bdg
participant "salida_bodega" as sald
participant "unidad_equipo" as uent
participant "stock_consumible" as stock
participant "log_auditoria" as aent

user -> view : Formulario: técnico, bodega,\nNS + consumibles -> Confirma
activate view

view -> guard : POST /api/salidas\n{ id_tecnico, id_bodega_origen, items[] }
activate guard

guard -> guard : AuthGuard('jwt') + RolesGuard:\nrol ADMIN_BODEGA / ADMIN / SUPERUSUARIO
activate guard
deactivate guard

guard -> guard : CompanyIsolationGuard:\nid_empresa = contexto del actor
activate guard
deactivate guard

guard --> view : Autorizado\n(canActivate() = true)
deactivate guard

view -> ctrl : POST /api/salidas\n{ id_tecnico, id_bodega_origen, items[] }
activate ctrl

ctrl -> svc : registrarSalida(dto, idEmpresa, actor)
activate svc

svc -> orm : findOne(Usuario, { id_usuario,\nactivo: true }, relations: usuarioRoles.rol)
activate orm
orm -> usr : SELECT usuario\nJOIN usuario_rol JOIN rol\nWHERE id_usuario = ? AND activo = true
activate usr
usr --> orm : técnico con rol TECNICO_TERRENO
deactivate usr
orm --> svc : técnico activo de la empresa ✓
deactivate orm

svc -> orm : findOne(Bodega, { id_bodega, id_empresa })
activate orm
orm -> bdg : SELECT * FROM bodega\nWHERE id_bodega = ? AND id_empresa = ?
activate bdg
bdg --> orm : bodega activa
deactivate bdg
orm --> svc : bodega de origen válida ✓
deactivate orm

svc -> svc : Valida NS duplicados dentro\ndel mismo envío (CU-59)
activate svc
deactivate svc

svc -> orm : QueryRunner.connect()\n+ startTransaction()
activate orm
orm --> svc : Transacción iniciada
deactivate orm

svc -> orm : manager.save(SalidaBodega)\n{ id_tecnico, id_bodega_origen,\nfecha_hora = now(), id_empresa,\nid_usuario_registro }
activate orm
orm -> sald : INSERT INTO salida_bodega
activate sald
sald --> orm : salida #N
deactivate sald
orm --> svc : salida #N
deactivate orm

note over svc : inicio loop\n(por cada ítem UNIDAD - procesarItemUnidad)
  svc -> orm : manager.findOne(UnidadEquipo,\n{ numero_serie, id_empresa })
  activate orm
  orm -> uent : SELECT * FROM unidad_equipo\nWHERE numero_serie = ? AND id_empresa = ?
  activate uent
  uent --> orm : unidad (estado 'En bodega',\nbodega de origen) ✓
  deactivate uent
  orm --> svc : unidad disponible
  deactivate orm

  svc -> orm : manager.save(unidad)\n[estado = 'Asignado a técnico',\nid_tecnico_asignado, id_bodega_actual = NULL,\nubicacion_fisica = NULL (CU-47)]
  activate orm
  orm -> uent : UPDATE unidad_equipo SET estado = ...
  activate uent
  uent --> orm : unidad actualizada
  deactivate uent
  orm --> svc : ok
  deactivate orm

  svc -> orm : manager.save(HistorialEstado)\n['En bodega' -> 'Asignado a técnico']
  activate orm
  orm --> svc : registrado
  deactivate orm

  svc -> orm : manager.save(SalidaDetalle, { id_unidad })
  activate orm
  orm --> svc : registrado
  deactivate orm

  svc -> orm : manager.save(MovimientoInventario)\n{ tipo_movimiento = 'SALIDA_A_TECNICO', cantidad = 1 }
  activate orm
  orm --> svc : registrado
  deactivate orm
note over svc : término loop

note over svc : inicio loop\n(por cada ítem CONSUMIBLE - procesarItemConsumible)
  svc -> orm : manager.findOne(TipoEquipo)\n-> es consumible (no requiere NS)
  activate orm
  orm --> svc : tipo válido
  deactivate orm

  svc -> orm : verificarStockDisponible(...)\nfindOne(StockConsumible, lock pessimistic_write)
  activate orm
  orm -> stock : SELECT * FROM stock_consumible\nWHERE (id_bodega, id_tipo_equipo)\nFOR UPDATE
  activate stock
  stock --> orm : cantidad_disponible = 100
  deactivate stock
  orm --> svc : disponible >= cantidad ✓
  deactivate orm

  svc -> orm : manager.save(stock)\n[cantidad_disponible = 100 - 25.5 = 74.5]
  activate orm
  orm -> stock : UPDATE stock_consumible\nSET cantidad_disponible = ?
  activate stock
  stock --> orm : stock actualizado
  deactivate stock
  orm --> svc : ok
  deactivate orm

  svc -> ips : sumar(manager, id_tecnico,\nid_tipo_equipo, cantidad) (CU-58)
  activate ips
  ips -> orm : findOne(InventarioPersonal, lock)\n+ save
  activate orm
  orm --> ips : saldo += 25.5
  deactivate orm
  ips --> svc : ok
  deactivate ips

  svc -> orm : manager.save(SalidaDetalle)\n{ id_tipo_equipo, cantidad }
  activate orm
  orm --> svc : registrado
  deactivate orm

  svc -> orm : manager.save(MovimientoInventario)\n{ tipo_movimiento = 'SALIDA_A_TECNICO', cantidad }
  activate orm
  orm --> svc : registrado
  deactivate orm
note over svc : término loop

svc -> orm : QueryRunner.commitTransaction()
activate orm
orm --> svc : Commit OK
deactivate orm

svc -> orm : QueryRunner.release()
activate orm
orm --> svc : Conexión liberada
deactivate orm

svc -> aud : create({ accion: 'SALIDA_BODEGA',\nentidad_afectada: 'salida_bodega',\nvalor_nuevo: { tecnico, bodega, items } })
activate aud
aud -> orm : save(log)
activate orm
orm -> aent : INSERT INTO log_auditoria
activate aent
aent --> orm : Registrado
deactivate aent
orm --> aud : Log guardado
deactivate orm
aud --> svc : Auditoría registrada
deactivate aud

svc --> ctrl : { success: true, id_salida,\nunidades_salidas, consumibles_salidos, message }
deactivate svc

ctrl --> view : 201 Created
deactivate ctrl

view --> user : Éxito + inventario personal\ndel técnico actualizado (CU-58)
deactivate view
@enduml
