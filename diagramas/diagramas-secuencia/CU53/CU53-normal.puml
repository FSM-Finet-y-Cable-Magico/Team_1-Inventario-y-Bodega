@startuml CU53-ConsultarOrdenesIngreso-Normal
title CU-53 — Consultando órdenes de ingreso (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 35
  }
  actor {
    margin 15
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Admin/AdminBodega/\nSuperusuario" as user
participant "V_OrdenesIngreso" as view
participant "V_OrdenIngresoDetalle" as detalle
participant "C_OrdenesIngresoController" as ctrl
participant "C_OrdenesIngresoService" as svc
participant "C_TypeORM" as orm
participant "orden_ingreso" as oing

user -> view : Navega a\n/ordenes-ingreso
activate view

view -> ctrl : GET /api/ordenes-ingreso
activate ctrl
ctrl -> svc : findAll(actor, filtros)
activate svc

svc -> svc : Aislamiento: si no es Superusuario\nfuerza id_empresa_destino = su empresa\ne ignora el filtro id_empresa

svc -> orm : createQueryBuilder + andWhere\n(estado, proveedor, rango de fechas,\nempresa, buscar)
activate orm
orm -> oing : SELECT * FROM orden_ingreso o\nWHERE o.id_empresa_destino = ?\nAND o.estado = ?\nAND o.fecha_documento BETWEEN ? AND ?\nORDER BY o.id_orden DESC
oing --> orm : OrdenIngreso[] (N filas)
orm --> svc : OrdenIngreso[]
deactivate orm

svc -> orm : Enriquecer cada orden\n(proveedor, bodega, tipos de equipo)
activate orm
orm -> oing : SELECT orden_ingreso\n+ JOIN proveedor, bodega, tipo_equipo, detalle
oing --> orm : rows (nombres y detalles)
orm --> svc : nombre_proveedor, nombre_bodega,\nnombre_empresa, detalles[]
deactivate orm

svc --> ctrl : OrdenIngreso[] enriquecidas
deactivate svc
ctrl --> view : 200 OK\n[ { correlativo, nombre_proveedor,\nfecha_documento, nombre_empresa,\nnombre_bodega, estado, detalles[] } ]
deactivate ctrl

view --> user : Tabla con correlativo, proveedor,\nfecha DD/MM/YYYY, empresa, bodega,\nestado (badge) y total de ítems
deactivate view

user -> view : Selecciona una orden
activate view
view -> detalle : goto(/ordenes-ingreso/{id})
deactivate view
activate detalle

detalle -> ctrl : GET /api/ordenes-ingreso/{id}
activate ctrl
ctrl -> svc : findOne(id, actor)
activate svc

svc -> orm : findOne(orden_ingreso)
activate orm
orm -> oing : SELECT * FROM orden_ingreso\nWHERE id_orden = ?
oing --> orm : row
orm --> svc : OrdenIngreso
deactivate orm

svc -> svc : Verifica pertenencia:\nSuperusuario o\nid_empresa_destino = empresa del actor

svc --> ctrl : Orden + detalles enriquecidos
deactivate svc
ctrl --> detalle : 200 OK\n{ ..., detalles: [ { cantidad_esperada,\ncantidad_recibida, garantia_dias } ] }
deactivate ctrl

detalle --> user : Ficha con cabecera + ítems\n(esperado vs recibido vs pendiente).\n"Registrar recepción" deshabilitado (CU-54)
deactivate detalle

@enduml
