@startuml CU36-exc-error-historial
title CU-36 — Registrando automáticamente cambio de estado de equipo (excepción: error al registrar historial)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_GestionEquipos" as view
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as uent
participant "historial_estado_equipo" as hent

user -> view : Selecciona equipo y\nnuevo estado deseado
activate view

view -> ctrl : PATCH /unidades/:id/cambiar-estado\n{ nuevoEstado, observacion }
activate ctrl

ctrl -> svc : transicionarEstado(unitId,\nnuevoEstado, actor, observacion)
activate svc

svc -> orm : findOne(id_unidad,\nrelations: tipoEquipo)
activate orm

orm -> uent : SELECT unidad_equipo\nWHERE id_unidad = :id
activate uent
uent --> orm : Datos unidad\n(estado actual)
deactivate uent

orm --> svc : unidad (existe)
deactivate orm

svc -> orm : queryRunner.startTransaction()\nqueryRunner.manager.save(unidad\ncon estado = nuevoEstado)
activate orm

orm -> uent : UPDATE unidad_equipo\nSET estado = nuevoEstado\nWHERE id_unidad = :id
activate uent
uent --> orm : Fila actualizada
deactivate uent

orm --> svc : unidad actualizada
deactivate orm

svc -> svc : historyRepository.create(\n{ id_unidad, id_usuario,\nestadoAnterior, estadoNuevo,\nmotivo, fechaHora })
activate svc
deactivate svc

svc -> orm : queryRunner.manager.save(\nnuevoHistorial)
activate orm

orm -> hent : INSERT historial_estado_equipo
activate hent
hent --> orm : Error de base de datos
deactivate hent

orm --> svc : throw Error
deactivate orm

svc -> orm : rollbackTransaction()\n— reintenta la transacción completa\n(máx. 3 intentos) y el error persiste
activate orm
orm --> svc : Transacción revertida\n(UPDATE deshecho)
deactivate orm

svc --> ctrl : throw BadRequestException\n('Error al registrar el cambio en el historial.\nEl sistema reintentó la escritura\npero el error persiste.')
deactivate svc

ctrl --> view : 400 Bad Request
deactivate ctrl

view --> user : Muestra "Error al registrar\nel cambio en el historial..."
deactivate view

@enduml
