@startuml CU88-exc-sin-resultados
title CU-88 — Generando reporte de garantías (excepción: sin resultados)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
<style>
sequenceDiagram {
  participant { Margin 25 }
  actor { Margin 20 }
}
</style>
skinparam sequence {
	MessageAlign center
	LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega / Administrador / Superusuario" as user
participant "V_ReportesGarantias" as view
participant "C_ReportesController" as ctrl
participant "C_ReportesService" as svc
participant "C_TypeORM" as orm
participant "log_auditoria" as aent

user -> view : Ejecuta filtros sin coincidencias
activate view
view -> ctrl : GET /api/reportes/garantias\n?id_empresa=2&id_tipo_equipo=15&periodo=60
activate ctrl
ctrl -> svc : getGarantiasReport(filtros, req.user)
activate svc
svc -> orm : SELECT equipos por empresa, tipo y período
activate orm
orm --> svc : 0 filas
deactivate orm
svc -> svc : Retorna reporte vacío
svc -> aent : INSERT log_auditoria\n(GENERAR_REPORTE, filtros)
activate aent
aent --> svc : Auditoría registrada
deactivate aent
svc --> ctrl : Sin resultados
deactivate svc
ctrl --> view : 200 OK: Sin resultados
deactivate ctrl
view --> user : No se encontraron equipos con los filtros seleccionados.
deactivate view

@enduml
