@startuml CU88-normal
title CU-88 — Generando reporte de garantías (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam ParticipantPadding 25
skinparam ActorPadding 20
skinparam sequence {
	MessageAlign center
	LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega / Administrador / Superusuario" as user
participant "V_ReportesGarantias" as view
participant "C_ReportesController" as ctrl
participant "C_ReportesService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as uent
participant "tipo_equipo" as tent
participant "log_auditoria" as aent

user -> view : Selecciona empresa, tipo y período
activate view
view -> ctrl : GET /api/reportes/garantias\n?id_empresa=&id_tipo_equipo=&periodo=
activate ctrl
ctrl -> svc : getGarantiasReport(filtros, req.user)
activate svc
svc -> svc : Valida rol y aislamiento por empresa
svc -> orm : Consulta equipos individualizables y garantías
activate orm
orm -> uent : SELECT unidades con número de serie y estado
activate uent
uent --> orm : Equipos
deactivate uent
orm -> tent : SELECT garantía, marca y modelo
activate tent
tent --> orm : Datos de tipo de equipo
deactivate tent
orm --> svc : Equipos con fechas de adquisición
deactivate orm
svc -> svc : Calcula vencimiento, días restantes\ny estado de garantía
svc -> aent : INSERT log_auditoria\n(GENERAR_REPORTE, filtros)
activate aent
aent --> svc : Auditoría registrada
deactivate aent
svc --> ctrl : Filas del reporte
deactivate svc
ctrl --> view : 200 OK: Datos del reporte
deactivate ctrl
view --> user : Tabla de garantías con estados y fechas
deactivate view

@enduml
