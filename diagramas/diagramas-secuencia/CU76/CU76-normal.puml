@startuml CU76-normal
title CU-76 — Reingresando equipo desde reparación externa (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    padding 35
  }
  actor {
    padding 15
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega" as user
participant "V_FichaUnidad" as view
participant "C_RolesGuard" as guard
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as uent
participant "prestamo_externo" as pent
participant "historial_estado_equipo" as hent
participant "log_auditoria" as aent

user -> view : Abre unidad en estado\n"En préstamo externo" y elige\n"Registrar retorno"
activate view

view -> guard : POST /unidades/:id/retorno-reparacion\n{ resultado: 'REPARADO'|'NO_REPARADO', observacion }
activate guard
guard --> view : Autorizado\n(ADMIN_BODEGA / ADMIN / SUPERUSUARIO)
deactivate guard

view -> ctrl : registrarRetornoReparacion(id, body, actor)
activate ctrl

ctrl -> svc : registrarRetornoReparacion(idUnidad, dto, actor)
activate svc

svc -> orm : findOne(id_unidad, id_empresa)
activate orm
orm -> uent : SELECT unidad_equipo\nWHERE id_unidad = :id AND id_empresa = :idEmpresa
activate uent
uent --> orm : Datos unidad (estado = 'En préstamo externo')
deactivate uent
orm --> svc : unidad (existe)
deactivate orm

svc -> svc : Precondición: estado === 'En préstamo externo'\n(si no → 400 'Transición de estado no\npermitida para este equipo.')
activate svc
deactivate svc

svc -> orm : getRepository(PrestamoExterno).findOne\n({ id_unidad, tipo: 'REPARACION_EXTERNA', estado: 'ACTIVO' })
activate orm
orm -> pent : SELECT prestamo_externo\nWHERE id_unidad = :id AND tipo = 'REPARACION_EXTERNA'\nAND estado = 'ACTIVO'
activate pent
pent --> orm : préstamo activo (existe)
deactivate pent
orm --> svc : préstamo
deactivate orm

svc -> svc : valida resultado (REPARADO/NO_REPARADO)\ny observación (mínimo 5, máximo 300 caracteres)
activate svc
deactivate svc

svc -> orm : queryRunner.startTransaction()\nmanager.save(unidad { estado: 'En revisión' })
activate orm
orm -> uent : UPDATE unidad_equipo\nSET estado = 'En revisión'\nWHERE id_unidad = :id
activate uent
uent --> orm : Unidad actualizada
deactivate uent
orm --> svc : unidad guardada
deactivate orm

svc -> orm : manager.save(prestamo { estado: 'CERRADO',\nfechaRetornoReal, resultado })
activate orm
orm -> pent : UPDATE prestamo_externo\nSET estado = 'CERRADO', fecha_retorno_real = now(),\nresultado = :resultado\nWHERE id_prestamo = :id
activate pent
pent --> orm : Préstamo actualizado
deactivate pent
orm --> svc : préstamo guardado
deactivate orm

svc -> orm : manager.save(historial\n{ estadoAnterior: 'En préstamo externo',\nestadoNuevo: 'En revisión', motivo: 'Retorno de\nreparación externa: ...' })
activate orm
orm -> hent : INSERT historial_estado_equipo
activate hent
hent --> orm : Registro insertado
deactivate hent
orm --> svc : historial guardado
deactivate orm

svc -> orm : queryRunner.commitTransaction()
activate orm
orm --> svc : Transacción confirmada
deactivate orm

svc -> orm : auditoriaService.create({ accion:\n'CAMBIAR_ESTADO', entidad: 'unidad_equipo',\nvalor_anterior: { estado: 'En préstamo externo' },\nvalor_nuevo: { estado: 'En revisión', resultado } })
activate orm
orm -> aent : INSERT log_auditoria
activate aent
aent --> orm : Registro insertado
deactivate aent
orm --> svc : auditoría guardada
deactivate orm

svc --> ctrl : 201 Created { success: true,\nestadoActual: 'En revisión' }
deactivate svc

ctrl --> view : 201 Created
deactivate ctrl

view --> user : Ficha actualizada: estado "En revisión",\npréstamo cerrado, visible en listado\nde equipos en revisión (CU-77)
deactivate view

@enduml
