@startuml CU54-RecepcionOrdenIngreso-Normal
title CU-54 — Registrando recepción total o parcial de orden de ingreso (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style> sequenceDiagram { participant { Margin 35 } actor { Margin 15 } } </style>
skinparam sequence { MessageAlign center  LifeLineBorderColor black }
hide footbox

actor "Admin/AdminBodega/\nSuperusuario" as user
participant "V_OrdenIngresoDetalle" as view
participant "C_OrdenesIngresoController" as ctrl
participant "C_OrdenesIngresoService" as svc
participant "C_AuditoriaService" as aud
participant "C_QueryRunner" as qr
database "postgres" as db

user -> view : Abre la ficha de una orden\n'Pendiente de recepción'\no 'Recepción parcial'
activate view

view -> user : Muestra los ítems con tipo de equipo,\ncantidad esperada y ya recibida

user -> view : Clic "Registrar recepción" e\nindica la cantidad recibida\nen esta instancia por ítem

view -> view : Valida en cliente\n0 <= cantidad <= pendiente

view -> ctrl : POST /api/ordenes-ingreso/{id}/recepcion\n{ items: [ { id_detalle, cantidad_recibida } ] }
activate ctrl

ctrl -> svc : registrarRecepcion(id, dto, actor)
activate svc

svc -> svc : verificarPertenencia(id, actor)\n404 genérico si es de otra empresa

svc -> db : SELECT * FROM orden_ingreso\nWHERE id_orden = ?
db --> svc : orden

svc -> svc : Precondición: estado != 'Completada'

svc -> db : SELECT * FROM orden_ingreso_detalle\nWHERE id_orden = ?
db --> svc : detalles[]

svc -> svc : Valida TODOS los ítems antes de\nabrir la transacción:\n0 <= cantidad <= (esperada - recibida)

svc -> svc : Calcula el estado resultante:\ntodos completos -> 'Completada'\nalgo pendiente -> 'Recepción parcial'\nnada recibido -> 'Pendiente de recepción'

svc -> qr : startTransaction()
activate qr

qr -> db : UPDATE orden_ingreso_detalle\nSET cantidad_recibida = cantidad_recibida + ?\nWHERE id_detalle = ?   (x N ítems)
db --> qr : ok

qr -> db : UPDATE orden_ingreso\nSET estado = ?\nWHERE id_orden = ?
db --> qr : ok

qr -> db : COMMIT
qr --> svc : Transacción exitosa
deactivate qr

svc -> aud : create({ accion: 'RECEPCION',\nentidad_afectada: 'orden_ingreso',\nvalor_anterior: estado previo,\nvalor_nuevo: items + estado })
activate aud
aud -> db : INSERT INTO log_auditoria
db --> aud : ok
aud --> svc : Auditoría registrada
deactivate aud

svc --> ctrl : Orden con detalles actualizados
deactivate svc

ctrl --> view : 201 Created\n{ estado, detalles: [ { cantidad_esperada,\ncantidad_recibida } ] }
deactivate ctrl

view --> user : Banner "Recepción registrada" +\ntabla de ítems con cantidades\ny estado actualizados
deactivate view

@enduml
