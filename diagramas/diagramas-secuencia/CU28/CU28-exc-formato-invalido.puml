@startuml CU28-exc-formato-invalido
title CU-28 — Validar número de serie de equipo (excepción: formato inválido)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    Margin 35
  }
  actor {
    Margin 15
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_RegistrarUnidad" as view
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as units
participant "C_CatalogService" as catalog
participant "C_TypeORM" as orm
participant "tipo_equipo" as tent

user -> view : Ingresa numero_serie\ncon formato inválido
activate view

view -> ctrl : POST /unidades\n{ id_tipo_equipo, numero_serie,\nid_bodega_actual }
activate ctrl

ctrl -> units : registrarUnidad(body,\nactor.id_empresa)
activate units

units -> catalog : determinarNaturalezaEquipo(\nid_tipo_equipo, id_empresa)
activate catalog

catalog -> orm : findOne({ id_tipo_equipo,\nid_empresa })
activate orm

orm -> tent : SELECT tipo_equipo\nWHERE id_tipo_equipo\nAND id_empresa
activate tent
tent --> orm : Registro tipo_equipo\n(requiereSerialNumber = true)
deactivate tent

orm --> catalog : tipo (TipoEquipo)
deactivate orm

catalog --> units : { clasificacion: 'INDIVIDUALIZABLE',\nobligaSerialNumber: true }
deactivate catalog

units -> catalog : validarFormatoSerialNumber(\nnumero_serie.trim())
activate catalog

catalog -> catalog : Aplica regex:\n/^[A-Z0-9-]{4,30}$/.test(serial)\n→ no cumple
activate catalog
deactivate catalog

catalog --> units : throw BadRequestException\n('El formato del número de serie es inválido.\nDebe contener entre 4 y 30 caracteres\nalfanuméricos y guiones. No se permiten\nespacios ni caracteres especiales.')
deactivate catalog

units --> ctrl : throw BadRequestException\n(propagada)
deactivate units

ctrl --> view : 400 Bad Request
deactivate ctrl

view --> user : Muestra "El formato del\nnúmero de serie es inválido..."
deactivate view

@enduml
