@startuml CU12-normal
title CU-12 — Cerrando sesión del sistema (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    padding 25
  }
  actor {
    padding 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Dashboard" as view
participant "C_AuthController" as ctrl
participant "C_AuthService" as svc
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "log_auditoria" as aent

user -> view : Confirma cierre\nde sesión
activate view

view -> ctrl : POST /auth/logout\nAuthorization: Bearer <token>
activate ctrl

ctrl -> svc : logout(token, id_usuario)
activate svc

svc -> svc : tokenBlacklist.add(token)
activate svc
deactivate svc

svc -> aud : create({ accion: 'LOGOUT',\nentidad_afectada: 'usuario' })
activate aud

aud -> orm : save(log)
activate orm

orm -> aent : INSERT log_auditoria
activate aent
aent --> orm : Registrado
deactivate aent

orm --> aud : Log guardado
deactivate orm

aud --> svc : Auditoría registrada
deactivate aud

svc --> ctrl : { message: 'Sesión cerrada\ncorrectamente.' }
deactivate svc

ctrl --> view : 200 OK\n{ message: 'Sesión cerrada correctamente.' }
deactivate ctrl

view --> user : Redirige al login
deactivate view

@enduml
