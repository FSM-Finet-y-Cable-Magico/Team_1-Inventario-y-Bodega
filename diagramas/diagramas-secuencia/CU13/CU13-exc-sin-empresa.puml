@startuml CU13-exc-sin-empresa
title CU-13 — Cargando contexto de empresa Finet al iniciar sesión\n(excepción: usuario sin empresa asignada)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    padding 25
  }
  actor {
    padding 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario Finet" as user
participant "V_Login" as view
participant "C_AuthController" as ctrl
participant "C_AuthService" as svc
participant "C_TypeORM" as orm
participant "usuario" as uent

user -> view : Ingresa nombre_usuario\ny password
activate view

view -> ctrl : POST /auth/login\n{ nombre_usuario, password }
activate ctrl

ctrl -> svc : login(loginDto)
activate svc

svc -> orm : findOne(usuario por\nnombre_usuario, con roles)
activate orm

orm -> uent : SELECT usuario\nJOIN usuario_rol JOIN rol\nWHERE nombre_usuario
activate uent
uent --> orm : Datos usuario + roles\n(id_empresa = null)
deactivate uent

orm --> svc : Usuario (activo, id_empresa = null)
deactivate orm

svc -> svc : Verifica password:\nbcrypt.compare(password,\npassword_hash)
activate svc
deactivate svc

svc -> svc : Verifica id_empresa:\nusuario.id_empresa === null
activate svc
deactivate svc

svc --> ctrl : throw UnauthorizedException\n('Su cuenta no tiene empresa asignada.\nContacte al administrador.')
deactivate svc

ctrl --> view : 401 Unauthorized
deactivate ctrl

view --> user : Muestra "Su cuenta no tiene\nempresa asignada.\nContacte al administrador."
deactivate view

@enduml