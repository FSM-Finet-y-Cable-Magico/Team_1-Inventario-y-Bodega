@startuml CU13-normal
title CU-13 — Cargando contexto de empresa Finet al iniciar sesión (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 25
skinparam ActorPadding 20
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario Finet" as user
participant "V_Login" as view
participant "C_AuthController" as ctrl
participant "C_AuthService" as svc
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "usuario" as uent
participant "log_auditoria" as aent

user -> view : Ingresa nombre_usuario\ny password
activate view

view -> ctrl : POST /auth/login\n{ nombre_usuario, password }
activate ctrl

ctrl -> svc : login(loginDto)
activate svc

svc -> orm : findOne(usuario por\nnombre_usuario, con roles)
activate orm

orm -> uent : SELECT usuario\nJOIN usuario_rol JOIN rol\nWHERE nombre_usuario
activate uent
uent --> orm : Datos usuario + roles\n(id_empresa = 1)
deactivate uent

orm --> svc : Usuario (activo, id_empresa = 1)
deactivate orm

svc -> svc : Verifica password:\nbcrypt.compare(password,\npassword_hash)
activate svc
deactivate svc

svc -> orm : update(id_usuario,\n{ intentos_fallidos: 0,\nbloqueado_hasta: null })
activate orm

orm -> uent : UPDATE usuario\nWHERE id_usuario
activate uent
uent --> orm : OK
deactivate uent

orm --> svc : Actualizado
deactivate orm

svc -> svc : Genera token:\njwtService.signAsync({ sub,\nnombre_usuario,\nid_empresa: 1, roles })
activate svc
deactivate svc

svc -> aud : create({ accion: 'LOGIN',\nentidad_afectada: 'usuario' })
activate aud

aud -> orm : save(log)
activate orm

orm -> aent : INSERT log_auditoria
activate aent
aent --> orm : Registrado
deactivate aent

orm --> aud : Log guardado
deactivate orm

aud --> svc : Auditoría registrada
deactivate aud

svc --> ctrl : { access_token }
deactivate svc

ctrl --> view : 200 OK\n{ access_token }
deactivate ctrl

view --> user : Redirige al dashboard\n(id_empresa=1 disponible en req.user)
deactivate view

@enduml
