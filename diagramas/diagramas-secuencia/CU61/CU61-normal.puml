@startuml CU61-normal
title CU-61 — Consultando vista móvil de trabajos e inventario del técnico (flujo normal)
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 30
  }
  actor {
    margin 12
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Técnico de terreno" as user
participant "V_Jornada (móvil)" as view
participant "C_TecnicosController" as ctrl
participant "C_JornadaService" as svc
participant "C_InventarioPersonalService" as ips
participant "C_G3ClientService" as g3
participant "G3 FSM (externo)" as g3api
participant "C_TypeORM" as orm
participant "inventario_personal_tecnico" as inv
participant "unidad_equipo" as uni

user -> view : Abre /jornada en el dispositivo móvil
activate view
view -> ctrl : GET /api/tecnicos/me/jornada (JWT)
activate ctrl
ctrl -> svc : obtenerJornada(actor)
activate svc
svc -> svc : fecha de hoy (America/Santiago)
svc -> ips : consultar(id_usuario, id_empresa, actor) → CU-58
activate ips
ips -> inv : SELECT saldos de consumibles
ips -> uni : SELECT unidades 'Asignado a técnico' del técnico
ips --> svc : { tecnico, ns_asignados[], saldos[] }
deactivate ips
svc -> g3 : consultarOrdenes({ id_tecnico, id_empresa, fecha })
activate g3
g3 -> g3api : GET {G3}/ordenes?id_empresa&id_tecnico&estado=PENDIENTE,EN_CURSO&desde&hasta\nX-API-KEY (timeout 3 s)
g3api --> g3 : { success, data: [OT con cliente{} y direccion{}] }
g3 --> svc : { ok: true, data: ordenes[] }
deactivate g3
svc -> svc : mapear trabajos (tipo, estado, cliente, dirección, teléfono)
svc --> ctrl : 200 { fecha, trabajos_estado: OK, trabajos[], inventario }
deactivate svc
ctrl --> view : { success, data }
deactivate ctrl
view --> user : (A) Trabajos del día en tarjetas\n(B) Inventario personal: NS + saldos
deactivate view
@enduml
