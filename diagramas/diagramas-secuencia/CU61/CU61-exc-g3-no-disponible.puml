@startuml CU61-exc-g3-no-disponible
skinparam sequenceDividerBorderThickness 0.6
skinparam sequenceDividerBorderColor 888888
skinparam sequenceDividerBackgroundColor white
skinparam sequenceDividerFontStyle italic
skinparam sequenceDividerFontColor 444444
skinparam sequenceDividerShadowing false
title CU-61 — Vista móvil del técnico (degradación: G3 no responde o no está configurado)
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 30
  }
  actor {
    margin 12
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Técnico de terreno" as user
participant "V_Jornada (móvil)" as view
participant "C_JornadaService" as svc
participant "C_G3ClientService" as g3
participant "G3 FSM (externo)" as g3api
participant "C_InventarioPersonalService" as ips

user -> view : Abre /jornada
activate view
view -> svc : GET /api/tecnicos/me/jornada → obtenerJornada(actor)
activate svc
svc -> ips : consultar(...) → CU-58 (sigue funcionando)
ips --> svc : { tecnico, ns_asignados[], saldos[] }
svc -> g3 : consultarOrdenes({ id_tecnico, id_empresa, fecha })
activate g3
alt sin G3_INTEGRACION_URL/API_KEY
  g3 -> g3 : no configurado → ok: false (sin llamada HTTP)
else error de red / 4xx / 5xx / timeout 3 s
  g3 -> g3api : GET /ordenes?...
  g3api --> g3 : error / sin respuesta / 500
  note right : el cliente NUNCA lanza excepción
end
g3 --> svc : { ok: false, data: null }
deactivate g3
svc --> view : 200 { trabajos_estado: NO_DISPONIBLE, trabajos: [], inventario }
deactivate svc
view --> user : Banner de advertencia "No se pudieron obtener los trabajos del día\n(G3 no responde...)" + inventario personal visible
note right : Degradación visible: la pantalla no falla y el técnico\nsigue viendo su inventario
deactivate view
@enduml
