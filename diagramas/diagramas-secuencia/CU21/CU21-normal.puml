@startuml CU21-normal
title CU-21 — Aprobando transferencia inter-empresa (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 25
skinparam ActorPadding 20
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Superusuario" as user
participant "V_Transferencias" as view
participant "C_RolesGuard" as guard
participant "C_TransferenciasController" as ctrl
participant "C_TransferenciasService" as svc
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "movimiento_inventario" as mvent
participant "unidad_equipo" as uent
participant "log_auditoria" as aent

user -> view : Selecciona transferencia\npendiente y aprueba
activate view

view -> ctrl : PATCH /transferencias/:id/aprobar
activate ctrl

ctrl -> guard : Verifica rol SUPERUSUARIO
activate guard
guard --> ctrl : Acceso permitido
deactivate guard

ctrl -> svc : aprobarTransferencia(id, actor)
activate svc

svc -> orm : find(movimiento_inventario\ndonde referencia_id = id\ny tipo_movimiento = PENDIENTE)
activate orm
orm -> mvent : SELECT movimiento_inventario\nWHERE referencia_id = id\nAND tipo_movimiento = 'TRANSFERENCIA_PENDIENTE'
activate mvent
mvent --> orm : Lista de movimientos
deactivate mvent
orm --> svc : movimientos[]
deactivate orm

svc -> orm : findBy(unidad_equipo\ndonde id_unidad IN ids)
activate orm
orm -> uent : SELECT unidad_equipo\nWHERE id_unidad IN (ids)
activate uent
uent --> orm : Lista de unidades
deactivate uent
orm --> svc : unidades[]
deactivate orm

svc -> svc : Valida que todas las\nunidades estén en estado\n'En bodega'
activate svc
deactivate svc

svc -> svc : dataSource.createQueryRunner()\n→ connect() → startTransaction()
activate svc
deactivate svc

loop Por cada movimiento pendiente
  svc -> orm : update(movimiento_inventario,\ntipo_movimiento = APROBADA)
  activate orm
  orm -> mvent : UPDATE movimiento_inventario\nSET tipo_movimiento = 'TRANSFERENCIA_APROBADA'\nWHERE id_movimiento = id
  activate mvent
  mvent --> orm : Actualizado
  deactivate mvent
  orm --> svc : OK
  deactivate orm

  svc -> orm : update(unidad_equipo,\nid_empresa = destino,\nid_bodega_actual = destino)
  activate orm
  orm -> uent : UPDATE unidad_equipo\nSET id_empresa = id_empresa_destino,\nid_bodega_actual = id_bodega_destino\nWHERE id_unidad = id
  activate uent
  uent --> orm : Actualizado
  deactivate uent
  orm --> svc : OK
  deactivate orm
end

svc -> svc : queryRunner.commitTransaction()
activate svc
deactivate svc

svc -> aud : create({ accion: 'APROBAR_TRANSFERENCIA',\nentidad_afectada: 'transferencia_equipo',\nid_entidad_afectada: id,\nvalor_anterior: PENDIENTE,\nvalor_nuevo: APROBADA })
activate aud

aud -> orm : save(log)
activate orm
orm -> aent : INSERT log_auditoria
activate aent
aent --> orm : Registrado
deactivate aent
orm --> aud : Log guardado
deactivate orm

aud --> svc : Auditoría registrada
deactivate aud

svc --> ctrl : { success: true,\nestado: TRANSFERENCIA_APROBADA,\nunidades_transferidas: N }
deactivate svc

ctrl --> view : 200 OK\n{ success, estado, unidades_transferidas }
deactivate ctrl

view --> user : Muestra confirmación:\n"Transferencia aprobada"
deactivate view

@enduml
