@startuml CU17-normal
title CU-17 — Creando tipo de equipo con aislamiento de empresa (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    padding 25
  }
  actor {
    padding 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_CrearTipoEquipo" as view
participant "C_CompanyIsolationGuard" as guard
participant "C_RolesGuard" as roles
participant "C_CatalogController" as ctrl
participant "C_CatalogService" as svc
participant "C_TypeORM" as orm
participant "tipo_equipo" as tent

user -> view : Completa formulario\nnombre, categoría,\nrequiereSerialNumber
activate view

view -> guard : POST /catalogo\n{ nombre, categoria,\nrequiereSerialNumber }\n+ JWT en Authorization
activate guard

guard -> guard : Extrae user de JWT\n(req.user)\nVerifica user.id_empresa
activate guard
deactivate guard

guard -> roles : user.id_empresa OK\nrequest.companyContextId = user.id_empresa
activate roles

roles -> roles : Verifica rol:\nADMIN o SUPERUSUARIO
activate roles
deactivate roles

roles -> ctrl : Acceso autorizado
deactivate roles
deactivate guard

activate ctrl

ctrl -> svc : crearTipo({\n  ...body,\n  id_empresa: actor.id_empresa\n})\n[id_empresa proviene del JWT,\nNO del body]
activate svc

svc -> svc : Valida campos obligatorios:\nnombre, categoría,\nrequiereSerialNumber
activate svc
deactivate svc

svc -> orm : findOne(nombre, id_empresa, activo=true)
activate orm

orm -> tent : SELECT tipo_equipo\nWHERE nombre = :nombre\nAND id_empresa = :id_empresa\nAND activo = true
activate tent
tent --> orm : null (sin duplicado)
deactivate tent

orm --> svc : null
deactivate orm

svc -> orm : create({ id_empresa, nombre,\ncategoria, requiereSerialNumber,\nactivo: true })
activate orm

orm -> tent : INSERT tipo_equipo
activate tent
tent --> orm : Registro creado
deactivate tent

orm --> svc : TipoEquipo guardado
deactivate orm

svc --> ctrl : TipoEquipo { id_tipo_equipo, ... }
deactivate svc

ctrl --> view : 201 Created\n{ id_tipo_equipo, nombre,\ncategoria, activo }
deactivate ctrl

view --> user : Muestra tipo de equipo\ncreado exitosamente
deactivate view

@enduml
