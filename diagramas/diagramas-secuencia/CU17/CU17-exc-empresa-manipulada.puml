@startuml CU17-exc-empresa-manipulada
title CU-17 — Creando tipo de equipo (excepción: empresa manipulada)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_CrearTipoEquipo" as view
participant "C_CompanyIsolationGuard" as guard

user -> view : Envía body con id_empresa\nde otra empresa (manipulado)
activate view

view -> guard : POST /catalogo\n{ nombre, categoria,\nid_empresa: <id_ajeno> }\n+ JWT en Authorization
activate guard

guard -> guard : Extrae user del JWT (req.user)\nComprueba user.id_empresa:\nes null o undefined
activate guard
deactivate guard

guard --> view : throw ForbiddenException\n('Su cuenta no tiene una empresa\nasignada. Contacte al\nadministrador del sistema.')
deactivate guard

view --> user : 403 Forbidden\nAcceso no autorizado
deactivate view

@enduml