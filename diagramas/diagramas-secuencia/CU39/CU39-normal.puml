@startuml CU39-normal
title CU-39 — Mostrando indicador visual de garantía vigente (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_FichaDetalle" as view
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as uent

user -> view : Solicita ficha de unidad\n(id_unidad)
activate view

view -> ctrl : GET /unidades/:id/ficha
activate ctrl

ctrl -> svc : verFichaDetalle(idUnidad, idEmpresaContexto)
activate svc

svc -> orm : findOne({ id_unidad, id_empresa },\nrelations: tipoEquipo)
activate orm

orm -> uent : SELECT unidad_equipo\nJOIN tipo_equipo\nWHERE id_unidad AND id_empresa
activate uent
uent --> orm : Datos unidad (fechaVencGarantia vigente)
deactivate uent

orm --> svc : UnidadEquipo (con tipoEquipo)
deactivate orm

svc -> svc : Calcula alertaGarantia:\nhoy = new Date(); setHours(0,0,0,0)\nfechaVencimiento = fechaVencGarantia\ndias = ceil((fecVenc - hoy) / ms_dia)\ndias >= 0 → garantia_vigente: true
activate svc
deactivate svc

svc --> ctrl : { success, datos_unidad,\nalerta_visual_garantia\n{ posee_garantia: true,\ngarantia_vigente: true,\ndias_restantes: N,\nmensaje_alerta: "¡ALERTA VIGENTE!..." },\nespecificaciones_catalogo }
deactivate svc

ctrl --> view : 200 OK\n{ datos_unidad, alerta_visual_garantia,\nespecificaciones_catalogo }
deactivate ctrl

view --> user : Muestra ficha con\nindicador visual de garantía vigente\n(días restantes)
deactivate view

@enduml
