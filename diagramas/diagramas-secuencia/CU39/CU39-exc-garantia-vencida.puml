@startuml CU39-exc-garantia-vencida
title CU-39 — Mostrando indicador visual de garantía vigente (excepción: garantía vencida o sin registrar)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_FichaDetalle" as view
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as uent

user -> view : Solicita ficha de unidad\n(id_unidad)
activate view

view -> ctrl : GET /unidades/:id/ficha
activate ctrl

ctrl -> svc : verFichaDetalle(idUnidad, idEmpresaContexto)
activate svc

svc -> orm : findOne({ id_unidad, id_empresa },\nrelations: tipoEquipo)
activate orm

orm -> uent : SELECT unidad_equipo\nJOIN tipo_equipo\nWHERE id_unidad AND id_empresa
activate uent
uent --> orm : Datos unidad\n(fechaVencGarantia null o fecha pasada)
deactivate uent

orm --> svc : UnidadEquipo (con tipoEquipo)
deactivate orm

svc -> svc : Calcula alertaGarantia:\nfechaVencGarantia null → posee_garantia: false\nfechaVencGarantia pasada → dias < 0\n→ garantia_vigente: false, dias_restantes: 0
activate svc
deactivate svc

svc --> ctrl : { success, datos_unidad,\nalerta_visual_garantia\n{ posee_garantia: false/true,\ngarantia_vigente: false,\ndias_restantes: 0,\nmensaje_alerta: "Sin garantía / COBERTURA EXPIRADA" },\nespecificaciones_catalogo }
deactivate svc

ctrl --> view : 200 OK\n{ datos_unidad, alerta_visual_garantia,\nespecificaciones_catalogo }
deactivate ctrl

view --> user : Muestra ficha sin indicador\nde garantía vigente\n(garantía nula o expirada)
deactivate view

@enduml
