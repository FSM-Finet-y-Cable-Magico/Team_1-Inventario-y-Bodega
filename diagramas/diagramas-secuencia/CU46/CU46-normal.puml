@startuml CU46-normal
title CU-46 — Configurando umbral de stock mínimo (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_ConfigurarUmbral" as view
participant "C_RolesGuard" as guard
participant "C_BodegasController" as ctrl
participant "C_BodegasService" as svc
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "bodega" as bent
participant "tipo_equipo" as tent
participant "stock_consumible" as scent
participant "log_auditoria" as aent

user -> view : Ingresa id_tipo_equipo\ny umbral
activate view

view -> guard : POST /bodegas/:id/umbral\n{ id_tipo_equipo, umbral }
activate guard

guard --> view : Acceso permitido\n(ADMIN / SUPERUSUARIO / ADMIN_BODEGA)
deactivate guard

view -> ctrl : POST /bodegas/:id/umbral\n{ id_tipo_equipo, umbral }
activate ctrl

ctrl -> svc : configurarUmbral(id, dto, actorId)
activate svc

svc -> orm : findOne(bodega WHERE id_bodega = id)
activate orm

orm -> bent : SELECT bodega\nWHERE id_bodega
activate bent
bent --> orm : Bodega encontrada
deactivate bent

orm --> svc : Bodega (existe)
deactivate orm

svc -> orm : findOne(tipoEquipo\nWHERE id_tipo_equipo)
activate orm

orm -> tent : SELECT tipo_equipo\nWHERE id_tipo_equipo
activate tent
tent --> orm : TipoEquipo encontrado
deactivate tent

orm --> svc : TipoEquipo (existe)
deactivate orm

svc -> orm : findOne(stock_consumible\nWHERE id_bodega AND id_tipo_equipo)
activate orm

orm -> scent : SELECT stock_consumible\nWHERE id_bodega AND id_tipo_equipo
activate scent
scent --> orm : Registro existente o null
deactivate scent

orm --> svc : record (existente o null)
deactivate orm

svc -> svc : Si record existe: record.umbral_minimo = dto.umbral\nSi no: create({ id_bodega, id_tipo_equipo,\ncantidad_disponible: 0, umbral_minimo })
activate svc
deactivate svc

svc -> orm : save(record)
activate orm

orm -> scent : INSERT / UPDATE stock_consumible\nSET umbral_minimo
activate scent
scent --> orm : Registro guardado
deactivate scent

orm --> svc : StockConsumible guardado
deactivate orm

svc -> aud : create({ accion: 'CONFIGURAR_UMBRAL',\nentidad_afectada: 'stock_consumible',\nid_entidad_afectada, valor_anterior, valor_nuevo })
activate aud

aud -> orm : save(log)
activate orm

orm -> aent : INSERT log_auditoria
activate aent
aent --> orm : Registrado
deactivate aent

orm --> aud : Log guardado
deactivate orm

aud --> svc : Auditoría registrada
deactivate aud

svc --> ctrl : StockConsumible actualizado
deactivate svc

ctrl --> view : 200 OK\n{ StockConsumible }
deactivate ctrl

view --> user : Umbral configurado exitosamente
deactivate view

@enduml
