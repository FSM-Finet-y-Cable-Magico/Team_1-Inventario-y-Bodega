@startuml CU72-exc-campos-incompletos
title CU-72 — Registrando resultado de revisión de equipo (excepción 2: campos obligatorios incompletos)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style> sequenceDiagram { participant { Margin 35 } actor { Margin 15 } } </style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega" as user
participant "V_FichaUnidad" as view
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as uent

user -> view : Elige "Requiere reparación externa"\ny confirma sin completar\nel nombre del receptor
activate view

view -> ctrl : POST /unidades/:id/resultado-revision\n{ resultado: "REPARACION_EXTERNA",\nnombre_receptor: "", fecha_retorno_estimada,\ndescripcion_falla }
activate ctrl

ctrl -> svc : registrarResultadoRevision(unitId, dto, actor)
activate svc

svc -> orm : findOne(id_unidad, id_empresa,\nrelations: tipoEquipo)
activate orm
orm -> uent : SELECT unidad_equipo\nWHERE id_unidad = :id
activate uent
uent --> orm : Datos unidad (estado = 'En revisión')
deactivate uent
orm --> svc : unidad (existe)
deactivate orm

svc -> svc : Precondición de estado OK\nresultado válido ('REPARACION_EXTERNA')
activate svc
deactivate svc

svc -> svc : nombreReceptor = dto.nombre_receptor?.trim() ?? ''\nlength === 0 → no cumple\nel rango 3-80 caracteres
activate svc
deactivate svc

svc --> ctrl : throw BadRequestException\n('El nombre del receptor debe tener\nentre 3 y 80 caracteres.')
deactivate svc

ctrl --> view : 400 Bad Request
deactivate ctrl

view --> user : Muestra el error dentro del modal\n"El nombre del receptor debe tener\nentre 3 y 80 caracteres."\n(no cierra el modal, no cambia el estado)
deactivate view

@enduml
