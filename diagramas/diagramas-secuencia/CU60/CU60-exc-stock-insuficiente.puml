@startuml CU60-exc-stock-insuficiente
title CU-60 — excepción: stock insuficiente
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    padding 30
  }
  actor {
    padding 12
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega" as user
participant "V_Salidas" as view
participant "C_SalidasService" as svc
participant "C_TypeORM (transacción)" as orm
participant "stock_consumible" as stock

user -> view : Consumible x500 (hay 49.5)
view -> svc : POST /api/salidas { items: [{ tipo: 'CONSUMIBLE', cantidad: 500 }] }
activate svc
svc -> orm : startTransaction · SELECT stock FOR UPDATE
stock --> orm : cantidad_disponible = 49.5
svc -> svc : 49.5 < 500 → E2 (CU-62)
svc --> view : 400 'Stock insuficiente de [Fibra drop QA]\nen [Bodega Central QA]. Disponible: 49.5 Metro.'
svc -> orm : ROLLBACK
deactivate svc
view --> user : Banner exacto; stock y saldo del técnico intactos
deactivate view
@enduml
