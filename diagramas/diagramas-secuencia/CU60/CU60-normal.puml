@startuml CU60-normal
title CU-60 — Registrando salida de consumibles de bodega a técnico (flujo normal)
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 30
  }
  actor {
    margin 12
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega" as user
participant "V_Salidas" as view
participant "C_SalidasController" as ctrl
participant "C_SalidasService" as svc
participant "C_InventarioPersonalService" as ips
participant "C_TypeORM (transacción)" as orm
participant "usuario" as usr
participant "stock_consumible" as stock
participant "log_auditoria" as aent
participant "salida_bodega" as sald

user -> view : Técnico + bodega + consumible (fibra) x50.5 metros → Confirma
activate view
view -> ctrl : POST /api/salidas\n{ id_tecnico, id_bodega_origen, items: [{ tipo: 'CONSUMIBLE', id_tipo_equipo, cantidad: 50.5 }] }
activate ctrl
ctrl -> svc : registrarSalida(dto, idEmpresa, actor)
activate svc
svc -> usr : SELECT usuario (+roles)\n→ técnico activo TECNICO_TERRENO ✓
svc -> bdg : SELECT bodega WHERE id_bodega AND id_empresa → activa ✓
svc -> orm : startTransaction() · INSERT salida_bodega
svc -> orm : SELECT tipo_equipo → requiereSerialNumber = false ✓ (es consumible)
svc -> orm : SELECT stock_consumible FOR UPDATE WHERE (id_bodega, id_tipo_equipo)
stock --> orm : cantidad_disponible = 100
svc -> orm : UPDATE stock SET cantidad_disponible = 100 − 50.5 = 49.5
svc -> ips : sumar(manager, id_tecnico, id_tipo_equipo, 50.5) (CU-58)
ips -> orm : UPSERT inventario_personal_tecnico (bloqueo de fila) → saldo += 50.5
svc -> orm : INSERT salida_detalle (id_tipo_equipo, cantidad=50.5)
svc -> orm : INSERT movimiento_inventario (SALIDA_A_TECNICO, cantidad=50.5)
svc -> orm : commitTransaction()
svc -> aent : auditoriaService.create({ accion: 'SALIDA_BODEGA', ... })
svc --> ctrl : 200 { success, id_salida, consumibles_salidos: 1 }
deactivate svc
ctrl --> view : 200
deactivate ctrl
view --> user : Éxito + saldo del técnico visible (CU-58)
deactivate view
@enduml
