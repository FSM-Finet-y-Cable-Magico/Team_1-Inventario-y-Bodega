@startuml CU02-exc-acceso-denegado
title CU-02 — Verificando permisos del rol al acceder a una funcionalidad (excepción: acceso denegado)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 25
skinparam ActorPadding 20
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Usuarios" as view
participant "C_RolesGuard" as guard
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "log_auditoria" as aent

user -> view : Solicita lista de usuarios
activate view

view -> guard : GET /usuario\n(JWT con roles en req.user)
activate guard

guard -> guard : reflector.get('roles',\ngetHandler())\n→ ['ADMIN','SUPERUSUARIO']
activate guard
deactivate guard

guard -> guard : roles.some(role =>\nuser.roles?.includes(role))\n→ false
activate guard
deactivate guard

guard -> aud : create({ accion: 'ACCESO_DENEGADO',\nentidad_afectada: ruta,\nvalor_nuevo: { roles_requeridos,\nroles_usuario } })
activate aud

aud -> orm : save(log)
activate orm

orm -> aent : INSERT log_auditoria
activate aent
aent --> orm : Registrado
deactivate aent

orm --> aud : Log guardado
deactivate orm

aud --> guard : Auditoría registrada
deactivate aud

guard --> view : throw ForbiddenException\n('No tiene permisos para\nacceder a esta sección.')\n→ 403 Forbidden
deactivate guard

view --> user : Muestra "No tiene permisos para\nacceder a esta sección."
deactivate view

@enduml