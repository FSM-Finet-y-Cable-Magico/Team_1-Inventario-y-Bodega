@startuml CU50-Editar-Proveedor-Normal
title CU-50 — Editando proveedor (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Admin/Superusuario" as user
participant "V_Proveedores" as view
participant "C_ProveedoresController" as ctrl
participant "C_ProveedoresService" as svc
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "proveedor" as pent
participant "proveedor_tipo_equipo" as pte
participant "log_auditoria" as aent

user -> view : Selecciona proveedor\ny elige "Editar"
activate view

view -> view : Muestra modal con\ndatos actuales pre-llenados
activate view
deactivate view

user -> view : Modifica campos\ny confirma

view -> ctrl : PATCH /api/proveedores/:id\n{ nombre_comercial, rut,\nnombre_contacto, telefono,\nemail, ids_tipos_equipo }
activate ctrl

ctrl -> svc : update(id, dto, actorId)
activate svc

svc -> orm : findOne(proveedor\npor id_proveedor)
activate orm
orm -> pent : SELECT proveedor\nWHERE id_proveedor = :id
activate pent
pent --> orm : Proveedor existente
deactivate pent
orm --> svc : proveedor (existe)
deactivate orm

svc -> svc : snapshot valorAnterior\n{ nombre_comercial, rut,\nnombre_contacto, telefono, email }
activate svc
deactivate svc

svc -> svc : validarRut(rut)\n(módulo 11, DV correcto)
activate svc
deactivate svc

svc -> orm : findOne(proveedor\npor rut normalizado)
activate orm
orm -> pent : SELECT proveedor\nWHERE rut = ?
activate pent
pent --> orm : null (no duplicado)
deactivate pent
orm --> svc : null
deactivate orm

svc -> orm : save(proveedor\ncon campos actualizados)
activate orm
orm -> pent : UPDATE proveedor\nSET nombre_comercial, rut, ...
activate pent
pent --> orm : Proveedor actualizado
deactivate pent
orm --> svc : proveedor guardado
deactivate orm

svc -> orm : delete(pivots existentes)\n+ save(pivots nuevos)
activate orm
orm -> pte : DELETE proveedor_tipo_equipo\nWHERE id_proveedor = :id\nINSERT nuevos pivots x N
activate pte
pte --> orm : Actualizados
deactivate pte
orm --> svc : OK
deactivate orm

svc -> aud : create({ accion: 'EDITAR',\nentidad_afectada: 'proveedor',\nvalor_anterior, valor_nuevo })
activate aud
aud -> orm : save(log)
activate orm
orm -> aent : INSERT log_auditoria
activate aent
aent --> orm : Registrado
deactivate aent
orm --> aud : Log guardado
deactivate orm
aud --> svc : Auditoría registrada
deactivate aud

svc --> ctrl : Proveedor actualizado\n+ tipos_equipo
deactivate svc

ctrl --> view : 200 OK\n{ proveedor }
deactivate ctrl

view --> user : Muestra datos\nactualizados en listado
deactivate view

@enduml
