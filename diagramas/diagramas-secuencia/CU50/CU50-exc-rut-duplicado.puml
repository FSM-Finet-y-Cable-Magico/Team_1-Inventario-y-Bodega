@startuml CU50-exc-rut-duplicado
title CU-50 — Editando proveedor (excepción: RUT ya existe en otro proveedor)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    padding 25
  }
  actor {
    padding 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Admin/Superusuario" as user
participant "V_Proveedores" as view
participant "C_ProveedoresController" as ctrl
participant "C_ProveedoresService" as svc
participant "C_TypeORM" as orm
participant "proveedor" as pent

user -> view : Edita proveedor\ncambiando RUT a uno existente
activate view

view -> ctrl : PATCH /api/proveedores/:id\n{ rut: "76543210-K", ... }
activate ctrl

ctrl -> svc : update(id, dto, actorId)
activate svc

svc -> orm : findOne(proveedor\npor id_proveedor)
activate orm
orm -> pent : SELECT proveedor\nWHERE id_proveedor = :id
activate pent
pent --> orm : Proveedor existente
deactivate pent
orm --> svc : proveedor (existe)
deactivate orm

svc -> svc : validarRut("76543210-K")\n(DV correcto)
activate svc
deactivate svc

svc -> orm : findOne(proveedor\npor rut normalizado)
activate orm
orm -> pent : SELECT proveedor\nWHERE rut = '76543210-K'
activate pent
pent --> orm : Proveedor existente\n(id_proveedor != :id)
deactivate pent
orm --> svc : duplicado encontrado
deactivate orm

svc --> ctrl : throw ConflictException\n('Ya existe un proveedor con ese RUT.')
deactivate svc

ctrl --> view : 409 Conflict\n'Ya existe un proveedor con ese RUT.'
deactivate ctrl

view --> user : Muestra error:\n"Ya existe un proveedor con ese RUT."
deactivate view

@enduml
