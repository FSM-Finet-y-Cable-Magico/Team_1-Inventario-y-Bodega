@startuml CU84-exc-item-invalido
title CU-84 — Validando trazabilidad de devolución (excepción: ítem inválido, no se procesa nada)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style> sequenceDiagram { participant { Margin 35 } actor { Margin 15 } } </style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega" as user
participant "V_Prestamos" as view
participant "C_PrestamosService" as svc
participant "C_TypeORM" as orm
participant "prestamo_detalle" as dent
participant "unidad_equipo" as uent
participant "stock_consumible" as sent

user -> view : Marca un NS de otro préstamo, un NS ya\nretornado y una cantidad mayor a la prestada
activate view

view -> svc : POST /api/prestamos/10/retorno\n{ items: [{ numero_serie: 'SN-CU81-003' },\n{ numero_serie: 'SN-CU81-100' },\n{ id_detalle: 15, cantidad: 99 }] }
activate svc

svc -> orm : Detalles del préstamo + estado de las unidades\n+ retornos previos
activate orm
orm -> dent : SELECT prestamo_detalle
activate dent
dent --> orm : Ítems reales
deactivate dent
orm --> svc : datos
deactivate orm

svc -> svc : (A) SN-CU81-003 no está en el préstamo\n(B) SN-CU81-100 ya fue retornado\n(C) 99 supera lo prestado del consumible
activate svc
svc --> view : 400 BadRequestException con los tres mensajes:\n'El equipo [SN-CU81-003] no pertenece al préstamo [PE-00010].\nEl equipo [SN-CU81-100] ya fue retornado o no está en\npréstamo externo. La cantidad retornada supera la cantidad\nprestada del ítem [Cable UTP Cat6].'
deactivate svc
deactivate svc

note over uent, sent : No se abre la transacción: ningún equipo cambia\nde estado, el stock no se toca y cantidad_retornada\nno se modifica

view -> view : Reparte las frases del mensaje\nentre los ítems que nombran
activate view
view --> user : Cada ítem rechazado se marca en rojo\ncon su motivo; no permite continuar\nhasta corregir el listado
deactivate view
deactivate view

@enduml
