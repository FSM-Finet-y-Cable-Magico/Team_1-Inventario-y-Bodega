@startuml CU04-exc-rol-superusuario-denegado
title CU-04 — Crear cuenta de usuario (excepción: rol Superusuario denegado)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador" as user
participant "V_CrearUsuario" as view
participant "C_RolesGuard" as guard
participant "C_UsuariosController" as ctrl
participant "C_UsuariosService" as svc
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "usuario" as uent
participant "log_auditoria" as aent

user -> view : Completa formulario\nasignando rol SUPERUSUARIO
activate view

view -> guard : POST /usuario\n{ rol: 'SUPERUSUARIO', ... }
activate guard

guard --> view : Acceso permitido\n(rol ADMIN)
deactivate guard

view -> ctrl : POST /usuario\n{ rol: 'SUPERUSUARIO', ... }
activate ctrl

ctrl -> svc : create(createUsuarioDto,\nreq.user.sub, req.user.roles)
activate svc

svc --> ctrl : throw ForbiddenException\n('Solo un Superusuario puede\nasignar el rol de Superusuario.')
deactivate svc

ctrl --> view : 403 Forbidden
deactivate ctrl

view --> user : Muestra "No tienes permisos\npara asignar ese rol"
deactivate view

@enduml
