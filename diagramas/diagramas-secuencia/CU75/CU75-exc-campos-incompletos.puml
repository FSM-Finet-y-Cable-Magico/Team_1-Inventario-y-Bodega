@startuml CU75-exc-campos-incompletos
title CU-75 — Enviando equipo a reparación externa (excepción: campo obligatorio incompleto)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 35
skinparam ActorPadding 15
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega" as user
participant "V_FichaUnidad" as view
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as uent

user -> view : Completa el formulario pero deja\n"Descripción de la falla" con\nmenos de 5 caracteres ("No")
activate view

view -> ctrl : POST /unidades/:id/reparacion-externa\n{ nombre_receptor: "Juan Rojas", rut_receptor: "12345678-5",\nfecha_retorno_estimada: "2026-09-10",\ndescripcion_falla: "No" }
activate ctrl

ctrl -> svc : enviarAReparacionExterna(idUnidad, dto, actor)
activate svc

svc -> orm : findOne(id_unidad, id_empresa)
activate orm
orm -> uent : SELECT unidad_equipo\nWHERE id_unidad = :id
activate uent
uent --> orm : Datos unidad (estado = 'En revisión')
deactivate uent
orm --> svc : unidad (existe)
deactivate orm

svc -> svc : Precondición de estado OK
activate svc
deactivate svc

svc -> svc : validarDatosReparacionExterna(dto, hoy):\nnombre OK, RUT OK, fecha OK,\ndescripcionFalla.trim().length (2) < 5
activate svc
deactivate svc

svc --> ctrl : throw BadRequestException\n('La descripción de la falla debe tener\nentre 5 y 300 caracteres.')
deactivate svc

ctrl --> view : 400 Bad Request
deactivate ctrl

view --> user : Muestra el error dentro del modal:\n'La descripción de la falla debe tener\nentre 5 y 300 caracteres.'\n(no cierra el modal, no cambia el estado)
deactivate view

@enduml
