@startuml CU52-OrdenIngreso-Normal
title CU-52 — Registrando orden de ingreso desde proveedor (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style> sequenceDiagram { participant { Margin 35 } actor { Margin 15 } } </style>
skinparam sequence { MessageAlign center  LifeLineBorderColor black }
hide footbox

actor "Usuario" as user
participant "V_OrdenesIngreso" as view
participant "C_OrdenesIngresoController" as ctrl
participant "C_OrdenesIngresoService" as svc
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
database "postgres" as db

user -> view : Clic "Nueva orden de ingreso"\ny completa formulario\n(proveedor, nro doc, fecha,\nempresa, bodega, ítems)
activate view

view -> ctrl : POST /api/ordenes-ingreso\n{ id_proveedor, numero_documento,\nfecha_documento, id_empresa_destino,\nid_bodega_destino, items[] }
activate ctrl

ctrl -> svc : create(dto, actor)
activate svc

svc -> svc : Aislamiento: no-superusuario\nfuerza id_empresa_destino = su empresa\n(solo el Superusuario la indica)

svc -> orm : findOne(proveedor)
activate orm
orm -> db : SELECT * FROM proveedor\nWHERE id_proveedor = ?
db --> orm : row
orm --> svc : Proveedor existe
deactivate orm

svc -> orm : findOne(bodega)
activate orm
orm -> db : SELECT * FROM bodega\nWHERE id_bodega = ?
db --> orm : row (activa, empresa correcta)
orm --> svc : Bodega válida
deactivate orm

svc -> svc : Validar fecha no futura

svc -> orm : findOne(tipo_equipo) x N ítems
activate orm
orm -> db : SELECT * FROM tipo_equipo\nWHERE id_tipo_equipo = ?
db --> orm : rows (activos)
orm --> svc : Tipos válidos
deactivate orm

svc -> orm : QueryRunner.startTransaction()
activate orm

orm -> db : SELECT pg_advisory_xact_lock(52)
db --> orm : lock tomado\n(se libera en el COMMIT)

orm -> db : SELECT correlativo\nFROM orden_ingreso\nORDER BY id_orden DESC\nLIMIT 1
db --> orm : último correlativo (o vacío)

svc -> svc : Calcular siguiente:\nOI-{MAX+1 padded 4 dígitos}

orm -> db : INSERT INTO orden_ingreso\n(correlativo, id_proveedor, ...)
db --> orm : orden guardada

orm -> db : INSERT INTO orden_ingreso_detalle\n(id_orden, id_tipo_equipo,\ncantidad_esperada, garantia_dias) x N
db --> orm : detalles guardados

orm -> db : COMMIT
orm --> svc : Transacción exitosa
deactivate orm

svc -> aud : create({ accion: 'CREAR',\nentidad_afectada: 'orden_ingreso' })
activate aud
aud -> orm : save(log)
activate orm
orm -> db : INSERT INTO log_auditoria
db --> orm : ok
deactivate orm
aud --> svc : Auditoría registrada
deactivate aud

svc --> ctrl : OrdenIngreso con detalles\n(correlativo, estado, etc.)
deactivate svc

ctrl --> view : 201 Created\n{ id_orden, correlativo: 'OI-XXXX',\nestado: 'Pendiente de recepción', ... }
deactivate ctrl

view --> user : Muestra toast:\n"Orden OI-XXXX creada exitosamente"
deactivate view

@enduml
