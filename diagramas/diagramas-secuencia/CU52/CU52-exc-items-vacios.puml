@startuml CU52-OrdenIngreso-Exc-ItemsVacios
title CU-52 — Registrando orden de ingreso (excepción: listado de ítems vacío o campo obligatorio incompleto)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    padding 35
  }
  actor {
    padding 15
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_OrdenesIngreso" as view
participant "C_ValidationPipe" as pipe

user -> view : Clic "Crear orden"\nsin agregar ítems\n(o campo obligatorio vacío)
activate view

view -> view : Validación en cliente\n(handleCreate): indica el error\nespecífico y no envía la petición

view --> user : Banner: "Debe agregar al menos\nun ítem a la orden de ingreso"

user -> view : Reintenta (o llamada directa\na la API sin pasar por la UI)

view -> pipe : POST /api/ordenes-ingreso\n{ ..., items: [] }
activate pipe

pipe -> pipe : ValidationPipe({ transform: true })\nsobre CreateOrdenIngresoDto:\n@ArrayMinSize(1) + @ValidateNested

note right of pipe
  El pipe global rechaza antes del
  controller: OrdenesIngresoService
  nunca se ejecuta y no se escribe
  nada en la base de datos
end note

pipe --> view : 400 Bad Request\n{ message: ["Debe agregar al menos\nun ítem a la orden de ingreso"] }
deactivate pipe

view --> user : Muestra banner de error\ncon los errores específicos.\nNo se registra la orden
deactivate view

@enduml
