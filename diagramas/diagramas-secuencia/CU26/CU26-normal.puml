@startuml CU26-normal
title CU-26 — Editando tipo de equipo existente (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 25
skinparam ActorPadding 20
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_EditarTipoEquipo" as view
participant "C_RolesGuard" as guard
participant "C_CatalogController" as ctrl
participant "C_CatalogService" as svc
participant "C_TypeORM" as orm
participant "tipo_equipo" as tent
participant "unidad_equipo" as uent

user -> view : Modifica campos del tipo\nde equipo y confirma
activate view

view -> guard : PATCH /catalogo/:id\n{ nombre?, categoria?,\nrequiereSerialNumber? }
activate guard

guard -> guard : Verifica roles:\nADMIN / SUPERUSUARIO
activate guard
deactivate guard

guard -> ctrl : Solicitud autorizada
deactivate guard
activate ctrl

ctrl -> svc : editarTipo(id, { nombre?,\ncategoria?, requiereSerialNumber?,\nid_empresa })
activate svc

svc -> orm : findOne(tipo_equipo\npor id y id_empresa)
activate orm

orm -> tent : SELECT tipo_equipo\nWHERE id_tipo_equipo = id\nAND id_empresa = id_empresa
activate tent
tent --> orm : Registro tipo_equipo
deactivate tent

orm --> svc : tipo (existe)
deactivate orm

svc -> orm : count(unidad_equipo\npor id_tipo_equipo)
activate orm

orm -> uent : SELECT COUNT(*)\nFROM unidad_equipo\nWHERE id_tipo_equipo = id
activate uent
uent --> orm : 0 unidades
deactivate uent

orm --> svc : 0
deactivate orm

svc -> orm : findOne(tipo_equipo por\nnombre, id_empresa, activo=true)
activate orm

orm -> tent : SELECT tipo_equipo\nWHERE nombre = dto.nombre\nAND id_empresa = id_empresa\nAND activo = true
activate tent
tent --> orm : null (no hay duplicado)
deactivate tent

orm --> svc : null
deactivate orm

svc -> orm : update(id_tipo_equipo,\n{ nombre?, categoria?,\nrequiereSerialNumber? })
activate orm

orm -> tent : UPDATE tipo_equipo\nSET nombre, categoria,\nrequiereSerialNumber\nWHERE id_tipo_equipo = id
activate tent
tent --> orm : Actualizado
deactivate tent

orm --> svc : OK
deactivate orm

svc -> orm : findOne(tipo_equipo\npor id_tipo_equipo)
activate orm

orm -> tent : SELECT tipo_equipo\nWHERE id_tipo_equipo = id
activate tent
tent --> orm : Registro actualizado
deactivate tent

orm --> svc : TipoEquipo actualizado
deactivate orm

svc --> ctrl : TipoEquipo actualizado
deactivate svc

ctrl --> view : 200 OK\n{ id_tipo_equipo, nombre,\ncategoria, requiereSerialNumber }
deactivate ctrl

view --> user : Muestra confirmación\n"Tipo de equipo actualizado"
deactivate view

@enduml
