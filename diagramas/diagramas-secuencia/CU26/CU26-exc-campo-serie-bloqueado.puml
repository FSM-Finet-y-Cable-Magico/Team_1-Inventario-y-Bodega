@startuml CU26-exc-campo-serie-bloqueado
title CU-26 — Editando tipo de equipo existente\n(excepción: cambio de requiereSerialNumber bloqueado por unidades existentes)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    Margin 35
  }
  actor {
    Margin 15
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_EditarTipoEquipo" as view
participant "C_RolesGuard" as guard
participant "C_CatalogController" as ctrl
participant "C_CatalogService" as svc
participant "C_TypeORM" as orm
participant "tipo_equipo" as tent
participant "unidad_equipo" as uent

user -> view : Modifica requiereSerialNumber\n(valor distinto al actual)
activate view

view -> guard : PATCH /catalogo/:id\n{ requiereSerialNumber: <nuevo valor> }
activate guard

guard -> guard : Verifica roles:\nADMIN / SUPERUSUARIO
activate guard
deactivate guard

guard -> ctrl : Solicitud autorizada
deactivate guard
activate ctrl

ctrl -> svc : editarTipo(id, { requiereSerialNumber,\nid_empresa })
activate svc

svc -> orm : findOne(tipo_equipo\npor id y id_empresa)
activate orm

orm -> tent : SELECT tipo_equipo\nWHERE id_tipo_equipo = id\nAND id_empresa = id_empresa
activate tent
tent --> orm : Registro tipo_equipo
deactivate tent

orm --> svc : tipo (existe, con\nrequiereSerialNumber actual)
deactivate orm

svc -> orm : count(unidad_equipo\npor id_tipo_equipo)
activate orm

orm -> uent : SELECT COUNT(*)\nFROM unidad_equipo\nWHERE id_tipo_equipo = id
activate uent
uent --> orm : N unidades (N > 0)
deactivate uent

orm --> svc : N (N > 0)
deactivate orm

svc --> ctrl : throw BadRequestException\n('Regla de Negocio: No es posible cambiar la\nconfiguración de Serie Individual porque\nexisten N unidades físicas registradas\nen el inventario para este tipo de equipo.')
deactivate svc

ctrl --> view : 400 Bad Request
deactivate ctrl

view --> user : Muestra error\n"No es posible cambiar este campo\nporque existen N unidades registradas"
deactivate view

@enduml
