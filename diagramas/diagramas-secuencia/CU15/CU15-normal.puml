@startuml CU15-normal
title CU-15 — Consultando dashboard consolidado de ambas empresas (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 25
skinparam ActorPadding 20
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Dashboard" as view
participant "C_RolesGuard" as guard
participant "C_CompaniesController" as ctrl
participant "C_CompaniesService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as uent
participant "bodega" as bent
participant "stock_consumible" as sent

user -> view : Solicita dashboard\nconsolidado
activate view

view -> guard : GET /empresas/dashboard\n(JWT token)
activate guard

guard -> guard : Verifica rol:\nROL === SUPERUSUARIO
activate guard
deactivate guard

guard -> ctrl : Acceso permitido
deactivate guard

activate ctrl

ctrl -> svc : getDashboard()
activate svc

svc -> orm : find(unidad_equipo\nWHERE id_empresa = 1)
activate orm

orm -> uent : SELECT unidad_equipo\nWHERE id_empresa = 1
activate uent
uent --> orm : Lista unidades Finet
deactivate uent

orm --> svc : unidades[]
deactivate orm

svc -> svc : Agrupa unidades por estado\n(estadisticasEstado)
activate svc
deactivate svc

svc -> orm : count(bodega\nWHERE id_empresa = 1\nAND activa = true)
activate orm

orm -> bent : SELECT COUNT(*) bodega\nWHERE id_empresa = 1\nAND activa = true
activate bent
bent --> orm : N bodegas activas
deactivate bent

orm --> svc : bodegasActivas (Finet)
deactivate orm

svc -> orm : SUM(stock_consumible.cantidad_disponible)\nINNER JOIN bodega\nWHERE b.id_empresa = 1
activate orm

orm -> sent : SELECT SUM(s.cantidad_disponible)\nFROM stock_consumible s\nINNER JOIN bodega b\nON b.id_empresa = 1
activate sent
sent --> orm : { total }
deactivate sent

orm --> svc : stockConsumible (Finet)
deactivate orm

svc -> orm : find(unidad_equipo\nWHERE id_empresa = 2)
activate orm

orm -> uent : SELECT unidad_equipo\nWHERE id_empresa = 2
activate uent
uent --> orm : Lista unidades Cable Mágico
deactivate uent

orm --> svc : unidades[]
deactivate orm

svc -> svc : Agrupa unidades por estado\n(estadisticasEstado)
activate svc
deactivate svc

svc -> orm : count(bodega\nWHERE id_empresa = 2\nAND activa = true)
activate orm

orm -> bent : SELECT COUNT(*) bodega\nWHERE id_empresa = 2\nAND activa = true
activate bent
bent --> orm : N bodegas activas
deactivate bent

orm --> svc : bodegasActivas (Cable Mágico)
deactivate orm

svc -> orm : SUM(stock_consumible.cantidad_disponible)\nINNER JOIN bodega\nWHERE b.id_empresa = 2
activate orm

orm -> sent : SELECT SUM(s.cantidad_disponible)\nFROM stock_consumible s\nINNER JOIN bodega b\nON b.id_empresa = 2
activate sent
sent --> orm : { total }
deactivate sent

orm --> svc : stockConsumible (Cable Mágico)
deactivate orm

svc --> ctrl : { dashboard_consolidado:\n[datos Finet, datos Cable Mágico] }
deactivate svc

ctrl --> view : 200 OK\n{ dashboard_consolidado }
deactivate ctrl

view --> user : Muestra dashboard consolidado\nde ambas empresas
deactivate view

@enduml
