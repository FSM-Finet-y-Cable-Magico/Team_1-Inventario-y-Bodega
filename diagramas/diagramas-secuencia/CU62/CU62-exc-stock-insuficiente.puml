@startuml CU62-exc-stock-insuficiente
title CU-62 — excepción: stock insuficiente (no permite continuar)
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 30
  }
  actor {
    margin 12
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

participant "Sistema" as sys #lightgrey
participant "C_SalidasService" as svc
participant "C_TypeORM (transacción)" as orm
participant "Vista" as view
participant "stock_consumible" as stock

sys -> svc : salida con consumible x100
activate svc
svc -> orm : SELECT stock_consumible FOR UPDATE\nWHERE (id_bodega, id_tipo_equipo)
stock --> orm : cantidad_disponible = 74.5 | sin filas → disponible = 0
svc -> svc : disponible < solicitado → BLOQUEA la operación
svc --> view : 400 BadRequestException\n'Stock insuficiente de [Fibra drop QA] en [Bodega Central QA].\nDisponible: 74.5 Metro.'
svc -> orm : ROLLBACK (nada queda aplicado)
deactivate svc
view --> user : Banner con los valores reales interpolados;\nel stock resultante nunca queda negativo
@enduml
