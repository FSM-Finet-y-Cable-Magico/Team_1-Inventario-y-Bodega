@startuml CU62-normal
title CU-62 — Validando stock disponible en bodega para consumibles (flujo normal)
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 30
  }
  actor {
    margin 12
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

participant "Sistema" as sys #lightgrey
participant "C_SalidasService" as svc
participant "C_TypeORM (transacción)" as orm
participant "stock_consumible" as stock

note over sys : Automático en toda salida de consumibles (CU-57/60 y CU-81 futuro).
sys -> svc : registrarSalida → ítem CONSUMIBLE cantidad 25.5
activate svc
svc -> orm : SELECT stock_consumible FOR UPDATE (fila bloqueada)\nWHERE id_bodega = :bodega AND id_tipo_equipo = :tipo
stock --> orm : cantidad_disponible = 100
svc -> svc : 100 ≥ 25.5 → suficiente ✓
svc -> orm : UPDATE stock SET cantidad_disponible = 74.5
svc -> orm : (continúa: inventario personal, detalle, movimiento)
svc -> orm : commitTransaction()
deactivate svc
note right : El bloqueo FOR UPDATE evita carreras: dos salidas\nsimultáneas se serializan; una de ellas ve el stock ya descontado
@enduml
