@startuml CU85-excepciones
title CU-85 — Generando reporte de stock actual (excepción: sin datos)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam ParticipantPadding 25
skinparam ActorPadding 20
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega / Administrador / Superusuario" as user
participant "V_ReportesStock" as view
participant "C_ReportesController" as ctrl
participant "C_ReportesService" as svc
participant "C_TypeORM" as orm
participant "log_auditoria" as aent

user -> view : Selecciona filtros opcionales y Generar
activate view
view -> ctrl : GET /api/reportes/stock\n?id_empresa=&id_bodega=&id_tipo_equipo=
activate ctrl
ctrl -> svc : getStockReport(filtros, req.user)
activate svc
svc -> orm : SELECT bodegas y tipos filtrados
activate orm
orm --> svc : Resultado vacío
deactivate orm
svc -> svc : Construye reporte vacío
svc -> aent : INSERT log_auditoria\n(GENERAR_REPORTE, filtros)
activate aent
aent --> svc : Auditoría registrada
deactivate aent
svc --> ctrl : Sin datos
deactivate svc
ctrl --> view : 200 OK: Sin resultados
deactivate ctrl
view --> user : Reporte vacío\nNo se encontraron datos para los filtros seleccionados.
deactivate view

@enduml
