@startuml CU85-ReporteStockActual-Excepciones
title CU-85 — Generando reporte de stock actual (excepción: sin datos)
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
	participant { Margin 35 }
	actor { Margin 15 }
}
</style>
skinparam sequence {
	MessageAlign center
	LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega / Administrador / Superusuario" as Usuario
participant "Vista /reportes/stock" as V
participant "ReportesController" as C
participant "ReportesService" as SVC
database "postgres" as DB

Usuario -> V : Selecciona filtros opcionales y Generar
activate V
V -> C : GET /api/reportes/stock?id_empresa=&id_bodega=&id_tipo_equipo=
activate C
C -> SVC : getStockReport(filtros, req.user)
activate SVC
SVC -> DB : SELECT bodegas y tipos filtrados
DB --> SVC : resultado vacío
SVC -> SVC : No hay bodegas/tipos para los filtros\nConstituye reporte vacío
SVC -> DB : INSERT log_auditoria(GENERAR_REPORTE, filtros)
DB --> SVC : auditoría registrada
SVC --> C : [ ] (array vacío)
C --> V : 200 OK + JSON vacío + isEmpty=true
V --> Usuario : Reporte vacío\n"No se encontraron datos\npara los filtros seleccionados."

deactivate SVC
deactivate C
deactivate V
@enduml
