@startuml CU85-normal
title CU-85 — Generando reporte de stock actual (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
<style>
sequenceDiagram {
  participant {
    padding 25
  }
  actor {
    padding 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega / Administrador / Superusuario" as user
participant "V_ReportesStock" as view
participant "C_ReportesController" as ctrl
participant "C_ReportesService" as svc
participant "C_TypeORM" as orm
participant "bodega" as bent
participant "tipo_equipo" as tent
participant "unidad_equipo" as uent
participant "stock_consumible" as sent
participant "log_auditoria" as aent

user -> view : Selecciona filtros opcionales y Generar
activate view
view -> ctrl : GET /api/reportes/stock\n?id_empresa=&id_bodega=&id_tipo_equipo=
activate ctrl
ctrl -> svc : getStockReport(filtros, req.user)
activate svc
svc -> svc : Valida rol y aislamiento por empresa
svc -> orm : find bodegas y tipos filtrados
activate orm
orm -> bent : SELECT bodegas por filtros
activate bent
bent --> orm : Bodegas
deactivate bent
orm -> tent : SELECT tipos por filtros
activate tent
tent --> orm : Tipos de equipo
deactivate tent
orm --> svc : Catálogos filtrados
deactivate orm

svc -> orm : Consulta stock serializado y consumible
activate orm
orm -> uent : SELECT unidades agrupadas por estado
activate uent
uent --> orm : Cantidades por estado
deactivate uent
orm -> sent : SELECT cantidad_disponible, umbral_minimo
activate sent
sent --> orm : Stock consumible y umbral
deactivate sent
orm --> svc : Datos de stock
deactivate orm

svc -> svc : Construye filas y calcula total_activo\ny bajo_umbral
svc -> aent : INSERT log_auditoria\n(GENERAR_REPORTE, filtros)
activate aent
aent --> svc : Auditoría registrada
deactivate aent
svc --> ctrl : Filas del reporte
deactivate svc
ctrl --> view : 200 OK: Datos del reporte
deactivate ctrl
view --> user : Tabla con estados, total, umbral y alerta
deactivate view

@enduml
