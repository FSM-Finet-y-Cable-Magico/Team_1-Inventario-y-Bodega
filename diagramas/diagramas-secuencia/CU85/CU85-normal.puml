@startuml CU85-normal
title CU-85 — Generando reporte de stock actual (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
hide footbox

actor "Usuario" as user
participant "V_Reportes" as view
participant "C_RolesGuard" as guard
participant "C_ReportesController" as ctrl
participant "C_ReportesService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo / stock_consumible" as stock
participant "C_AuditoriaService" as aud
participant "log_auditoria" as log

user -> view : Selecciona filtros y genera reporte
view -> guard : GET /api/reportes/stock?id_empresa=&id_bodega=&id_tipo_equipo=
guard --> view : Acceso permitido
view -> ctrl : Solicitud autenticada
ctrl -> svc : generarReporteStock(filtros, actorId)
svc -> orm : Consultar bodegas, tipos, unidades y stock
orm -> stock : SELECT agrupaciones por tipo y bodega
stock --> orm : Existencias y umbrales
orm --> svc : Datos filtrados
svc -> svc : Calcular estados, total_activo y bajo_umbral
svc -> aud : create(GENERAR_REPORTE, filtros)
aud -> orm : INSERT log_auditoria
orm -> log : Registro de auditoría
log --> orm : OK
orm --> aud : OK
aud --> svc : Auditoría registrada
svc --> ctrl : Filas del reporte
ctrl --> view : 200 OK
view --> user : Tabla de stock visible

@enduml
