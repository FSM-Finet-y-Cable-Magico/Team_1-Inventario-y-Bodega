@startuml CU85-exc-sin-datos
title CU-85 — Generando reporte de stock actual (excepción: sin datos)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
hide footbox

actor "Usuario" as user
participant "V_Reportes" as view
participant "C_ReportesController" as ctrl
participant "C_ReportesService" as svc
database "BD" as db
participant "C_AuditoriaService" as aud

user -> view : Aplica filtros sin coincidencias
view -> ctrl : GET /api/reportes/stock?filtros
ctrl -> svc : generarReporteStock(filtros, actorId)
svc -> db : Consultar stock por filtros
db --> svc : []
svc -> aud : Registrar GENERAR_REPORTE con filtros
aud --> svc : Auditoría registrada
svc --> ctrl : []
ctrl --> view : 200 OK
view --> user : "No se encontraron datos para los filtros seleccionados."

@enduml
