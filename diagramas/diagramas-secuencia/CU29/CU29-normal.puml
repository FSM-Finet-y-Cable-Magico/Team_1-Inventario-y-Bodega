@startuml CU29-normal
title CU-29 — Adjuntando ficha técnica PDF a tipo de equipo (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    Margin 35
  }
  actor {
    Margin 15
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_FichaTecnica" as view
participant "C_CatalogController" as ctrl
participant "C_CatalogService" as svc
participant "C_TypeORM" as orm
participant "tipo_equipo" as tent

user -> view : Selecciona tipo de equipo\ny adjunta archivo PDF
activate view

view -> ctrl : POST /catalogo/:id/ficha-tecnica\n{ file: archivo.pdf }
activate ctrl

ctrl -> ctrl : FileInterceptor valida:\nmimetype = application/pdf\ny fileSize <= 5 MB
activate ctrl
deactivate ctrl

ctrl -> svc : adjuntarPdfPath(id, file.path)
activate svc

svc -> orm : findOne(id_tipo_equipo = id)
activate orm

orm -> tent : SELECT tipo_equipo\nWHERE id_tipo_equipo = id
activate tent
tent --> orm : Registro tipo_equipo
deactivate tent

orm --> svc : TipoEquipo (existe)
deactivate orm

svc -> svc : tipo.fichaTecnicaPdfUrl = file.path
activate svc
deactivate svc

svc -> orm : save(tipo)
activate orm

orm -> tent : UPDATE tipo_equipo\nSET ficha_tecnica_pdf_url = path\nWHERE id_tipo_equipo = id
activate tent
tent --> orm : Actualizado
deactivate tent

orm --> svc : TipoEquipo actualizado
deactivate orm

svc --> ctrl : { success: true,\nid_tipo_equipo,\nficha_tecnica_pdf_url,\nmessage }
deactivate svc

ctrl --> view : 201 Created\n{ success: true, ficha_tecnica_pdf_url }
deactivate ctrl

view --> user : Muestra "La ficha técnica PDF\nha sido adjuntada exitosamente"
deactivate view

@enduml
