@startuml CU69-normal
title CU-69 — Registrando cierre de trabajo de reparación (flujo normal: con retiro)
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 30
  }
  actor {
    margin 12
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "G3 (FSM) — cierre de OT" as g3
participant "C_ApiKeyGuard" as guard
participant "C_IntegracionesController" as ctrl
participant "C_IntegracionesService" as svc
participant "C_TypeORM (transacción)" as orm
participant "integracion_cierre" as icier
participant "unidad_equipo" as uent
participant "historial_estado_equipo" as hent
participant "inventario_personal_tecnico" as invp
participant "cierre_reparacion" as crep
participant "log_auditoria" as aent

note over g3 : El cierre de la OT lo ejecuta G3; T1 registra la parte de inventario\n(estados, consumibles y auditoría) — doc-12 §1.3

g3 -> guard : POST /api/integraciones/ordenes/123/cierre\nX-API-KEY · { tipo_ot: 'REPARACION', id_tecnico,\nreparacion { falla_reportada, solucion_aplicada, resultado: 'RESUELTO' },\nequipos_retirados: ['NS-RET-001'], materiales: [{ id_tipo_equipo: 7, cantidad: 10.5 }] }
activate guard
guard --> ctrl : Key válida · scope con acceso a la empresa
deactivate guard

activate ctrl
ctrl -> svc : recibirCierreOt(123, payload, integracion)
activate svc

svc -> svc : Valida clave_idempotencia, id_empresa del scope\ny que el id_ot del payload calce con la ruta

svc -> orm : startTransaction()
activate orm
orm -> icier : INSERT integracion_cierre\n(clave_idempotencia UNIQUE reclama el cierre)
activate icier
icier --> orm : id_cierre
deactivate icier

svc -> svc : accion del ítem = RETIRADO_PARA_DIAGNOSTICO\n(la envía G3; si faltara, la define el arreglo de origen)

svc -> orm : SELECT unidad_equipo\nWHERE numero_serie = 'NS-RET-001' AND id_empresa
orm -> uent : consulta
activate uent
uent --> orm : unidad (estado 'Instalado en cliente')
deactivate uent

svc -> orm : UPDATE unidad_equipo\nSET estado = 'En revisión',\ndiagnostico_tecnico = categoria_falla del cierre
orm -> uent : unidad actualizada
orm -> hent : INSERT historial_estado_equipo\n('Instalado en cliente' → 'En revisión',\nmotivo: 'Cierre OT #123 (integración G3)')
activate hent
hent --> orm : registro insertado
deactivate hent

svc -> svc : Valida falla reportada y solución aplicada (5 a 300)\ny mapea el resultado de G3: RESUELTO → 'Resuelto'

svc -> orm : procesarMateriales (CU-64/CU-68):\nSELECT tipo_equipo (consumible + unidad de medida)\nSELECT inventario_personal_tecnico FOR UPDATE
orm -> invp : consulta con bloqueo de fila
activate invp
invp --> orm : saldo 50.5 Metro ≥ 10.5 declarado (CU-68)
deactivate invp

svc -> orm : UPDATE inventario_personal_tecnico\nSET cantidad = 40 (CU-58)\nel detalle descontado se guarda en el cierre
orm -> invp : saldo descontado

svc -> orm : INSERT cierre_reparacion\n(falla, solución, resultado, rut cliente, dirección,\nequipos retirados e instalados, consumibles descontados)
orm -> crep : registro insertado
activate crep
crep --> orm : id_cierre_reparacion
deactivate crep

svc -> orm : commitTransaction()
orm --> svc : transacción confirmada
deactivate orm

svc -> aent : auditoriaService.create({ accion: 'CIERRE_REPARACION',\nentidad: 'cierre_reparacion', valor_nuevo: { resultado, equipos, consumibles } })
activate aent
aent --> svc : auditoría registrada
deactivate aent

svc --> ctrl : 200 { estado_proceso: 'PROCESADO',\nid_cierre_reparacion, discrepancias: [],\nmateriales { descontados, ajustes } }
deactivate svc
ctrl --> g3 : 200 OK
deactivate ctrl

@enduml
