@startuml CU69-normal
skinparam sequenceDividerBorderThickness 0.6
skinparam sequenceDividerBorderColor 888888
skinparam sequenceDividerBackgroundColor white
skinparam sequenceDividerFontStyle italic
skinparam sequenceDividerFontColor 444444
skinparam sequenceDividerShadowing false
title CU-69 — Registrando cierre de trabajo de reparación (flujo normal: con retiro)
skinparam style strictuml
skinparam ParticipantBackgroundColor white
skinparam ParticipantBorderColor black
skinparam ActorBackgroundColor white
skinparam ActorBorderColor black
skinparam ArrowColor black
skinparam SequenceLifeLineBackgroundColor white
skinparam SequenceGroupBorderColor black
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupHeaderFontColor black
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam TitleFontColor black
hide stereotype
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 30
  }
  actor {
    margin 12
  }
  .vista { BackGroundColor #BDD7EF ; FontColor #223C67 }
  .controlador { BackGroundColor #C7E1B5 ; FontColor #37571F }
  .persistencia { BackGroundColor #F9CBAD ; FontColor #894212 }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Técnico de terreno" as tec
participant "V_CierreOT (sistema G3)" as g3 <<vista>>
participant "C_ApiKeyGuard" as guard <<controlador>>
participant "C_IntegracionesController" as ctrl <<controlador>>
participant "C_IntegracionesService" as svc <<controlador>>
participant "C_TypeORM (transacción)" as orm <<controlador>>
participant "integracion_cierre" as icier <<persistencia>>
participant "unidad_equipo" as uent <<persistencia>>
participant "historial_estado_equipo" as hent <<persistencia>>
participant "inventario_personal_tecnico" as invp <<persistencia>>
participant "cierre_reparacion" as crep <<persistencia>>
participant "log_auditoria" as aent <<persistencia>>
note over tec, g3 : El cierre de la OT lo ejecuta G3; T1 registra la parte de inventario\n(estados, consumibles y auditoría) — doc-12 §1.3

tec -> g3 : Confirma el cierre de la OT 123 de reparación\n(equipo retirado, materiales y resultado)
activate g3
g3 -> guard : POST /api/integraciones/ordenes/123/cierre\nX-API-KEY · { tipo_ot: 'REPARACION', id_tecnico,\nreparacion { falla_reportada, solucion_aplicada, resultado: 'RESUELTO' },\nequipos_retirados: ['NS-RET-001'], materiales: [{ id_tipo_equipo: 7, cantidad: 10.5 }] }
activate guard
guard -> guard : Valida X-API-KEY\ny scope de la empresa
guard -> ctrl : recibirCierre(123, payload)
activate ctrl
ctrl -> svc : recibirCierreOt(123, payload, integracion)
activate svc

svc -> svc : Valida clave_idempotencia, id_empresa del scope\ny que el id_ot del payload calce con la ruta

svc -> orm : startTransaction()
activate orm
orm --> svc : transacción iniciada

svc -> orm : INSERT integracion_cierre\n(clave_idempotencia UNIQUE reclama el cierre)
orm -> icier : INSERT
activate icier
icier --> orm : id_cierre
deactivate icier
orm --> svc : id_cierre

svc -> svc : accion del ítem = RETIRADO_PARA_DIAGNOSTICO\n(la envía G3; si faltara, la define el arreglo de origen)

svc -> orm : SELECT unidad_equipo\nWHERE numero_serie = 'NS-RET-001' AND id_empresa
orm -> uent : SELECT
activate uent
uent --> orm : unidad (estado 'Instalado en cliente')
deactivate uent
orm --> svc : unidad

svc -> orm : UPDATE unidad_equipo\nSET estado = 'En revisión',\ndiagnostico_tecnico = categoria_falla del cierre
orm -> uent : UPDATE
activate uent
uent --> orm : unidad actualizada
deactivate uent
orm --> svc : unidad actualizada

svc -> orm : INSERT historial_estado_equipo\n('Instalado en cliente' → 'En revisión',\nmotivo: 'Cierre OT #123 (integración G3)')
orm -> hent : INSERT
activate hent
hent --> orm : registro insertado
deactivate hent
orm --> svc : historial guardado

svc -> svc : Valida falla reportada y solución aplicada (5 a 300)\ny mapea el resultado de G3: RESUELTO → 'Resuelto'

svc -> orm : procesarMateriales (CU-64/CU-68):\nSELECT inventario_personal_tecnico FOR UPDATE
orm -> invp : SELECT con bloqueo de fila
activate invp
invp --> orm : saldo 50.5 Metro
deactivate invp
orm --> svc : saldo ≥ 10.5 declarado (CU-68)

svc -> orm : UPDATE inventario_personal_tecnico\nSET cantidad = 40 (CU-58)
orm -> invp : UPDATE
activate invp
invp --> orm : saldo descontado
deactivate invp
orm --> svc : saldo actualizado

svc -> orm : INSERT cierre_reparacion\n(falla, solución, resultado, rut cliente, dirección,\nequipos retirados e instalados, consumibles descontados)
orm -> crep : INSERT
activate crep
crep --> orm : id_cierre_reparacion
deactivate crep
orm --> svc : id_cierre_reparacion

svc -> orm : commitTransaction()
orm --> svc : transacción confirmada
deactivate orm

svc -> orm : auditoriaService.create({ accion: 'CIERRE_REPARACION',\nentidad: 'cierre_reparacion', valor_nuevo })
activate orm
orm -> aent : INSERT log_auditoria
activate aent
aent --> orm : registrado
deactivate aent
orm --> svc : auditoría registrada
deactivate orm

svc --> ctrl : { estado_proceso: 'PROCESADO',\nid_cierre_reparacion, discrepancias: [],\nmateriales { descontados, ajustes } }
deactivate svc
ctrl --> guard : 200 OK
deactivate ctrl
guard --> g3 : 200 OK { estado_proceso: 'PROCESADO', id_cierre_reparacion }
deactivate guard
g3 --> tec : OT de reparación cerrada
deactivate g3

@enduml
