@startuml CU56-FechaAdquisicionReal-Normal
title CU-56 — Registrando fecha de adquisición real en recepción (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 35
  }
  actor {
    margin 15
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Admin/AdminBodega/\nSuperusuario" as user
participant "V_OrdenIngresoDetalle" as view
participant "C_OrdenesIngresoController" as ctrl
participant "C_OrdenesIngresoService" as svc
participant "C_AuditoriaService" as aud
participant "C_QueryRunner" as qr
participant "orden_ingreso" as oing
participant "orden_ingreso_detalle" as odet
participant "log_auditoria" as aent
participant "unidad_equipo" as uent
participant "log_auditoria" as aent

user -> view : Abre "Registrar recepción"
activate view

view -> view : Precarga la fecha de hoy\ny fija max = hoy en el date picker

user -> view : Indica la fecha de recepción\nefectiva (25/08) y las cantidades

view -> view : Valida que exista y no sea futura

note right of view
  La orden tiene fecha_documento = 20/08.
  Al diferir, la vista avisa que ambas
  fechas quedarán registradas
end note

view -> ctrl : POST /api/ordenes-ingreso/{id}/recepcion\n{ fecha_recepcion: "2026-08-25",\nitems: [...] }
activate ctrl

ctrl -> svc : registrarRecepcion(id, dto, actor)
activate svc

svc -> svc : Excepción 2: compara la fecha\ncontra el reloj del SERVIDOR

svc -> qr : startTransaction()
activate qr

qr -> odet : UPDATE orden_ingreso_detalle\nSET cantidad_recibida = cantidad_recibida + ?

loop por cada unidad recibida
  qr -> uent : INSERT INTO unidad_equipo\n(fecha_adquisicion = '2026-08-25',\nfecha_venc_garantia = '2026-08-25'\n+ garantia_dias del ítem,\nestado = 'En bodega')
  uent --> qr : unidad creada
end

note right of qr
  orden_ingreso.fecha_documento NO se toca:
  la del proveedor vive en la orden y la de
  recepción real en cada unidad
end note

qr -> oing : UPDATE orden_ingreso SET estado = ?
qr -> oing :COMMIT (sobre la orden_ingreso)
qr --> svc : Transacción exitosa
deactivate qr

svc -> aud : create({ accion: 'RECEPCION',\nvalor_nuevo: { fecha_recepcion,\nfecha_documento_orden } })
activate aud
aud -> aent : INSERT INTO log_auditoria
aent --> aud : ok
aud --> svc : Auditoría registrada
deactivate aud

svc --> ctrl : Orden actualizada
deactivate svc

ctrl --> view : 201 Created
deactivate ctrl

view --> user : Recepción registrada. La ficha de\ncada unidad muestra adquisición 25/08\ny la garantía calculada sobre esa fecha\n(CU-38/CU-39)
deactivate view

@enduml
