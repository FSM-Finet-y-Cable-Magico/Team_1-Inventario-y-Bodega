@startuml CU30-normal
title CU-30 — Descargando ficha técnica de tipo de equipo (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_FichaTecnica" as view
participant "C_AuthGuard" as guard
participant "C_CatalogController" as ctrl
participant "C_CatalogService" as svc
participant "C_TypeORM" as orm
participant "tipo_equipo" as ent

user -> view : Solicita ficha técnica\ndel tipo de equipo
activate view

view -> guard : GET /catalogo/:id/ficha-tecnica\n+ JWT token
activate guard

guard -> guard : Valida JWT y rol\n(ADMIN, SUPERUSUARIO,\nADMIN_BODEGA, TECNICO_TERRENO)
activate guard
deactivate guard

guard --> ctrl : Solicitud autorizada
deactivate guard
activate ctrl

ctrl -> svc : obtenerFichaPdf(id, id_empresa)
activate svc

svc -> svc : parseInt(id)\nvalida número
activate svc
deactivate svc

svc -> orm : findOne({ id_tipo_equipo: idNum,\nid_empresa: idEmpresaContexto })
activate orm

orm -> ent : SELECT tipo_equipo\nWHERE id_tipo_equipo AND id_empresa
activate ent
ent --> orm : Registro tipo_equipo
deactivate ent

orm --> svc : tipo (con fichaTecnicaPdfUrl)
deactivate orm

svc -> svc : Verifica fichaTecnicaPdfUrl\nes no nulo y no vacío
activate svc
deactivate svc

svc --> ctrl : { tieneFicha: true,\nid_tipo_equipo,\nnombre_equipo,\nficha_tecnica_pdf_url }
deactivate svc

ctrl --> view : 200 OK\n{ tieneFicha: true,\nficha_tecnica_pdf_url }
deactivate ctrl

view --> user : Muestra enlace/botón\nde descarga del PDF
deactivate view

@enduml
