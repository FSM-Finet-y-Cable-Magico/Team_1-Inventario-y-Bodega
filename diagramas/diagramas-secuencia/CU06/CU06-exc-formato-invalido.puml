@startuml CU06-exc-formato-invalido
title CU-06 — Editando cuenta de usuario (excepción: formato inválido)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    Margin 35
  }
  actor {
    Margin 15
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador" as user
participant "V_EditarUsuario" as view
participant "C_RolesGuard" as guard
participant "C_UsuariosController" as ctrl
participant "C_UsuariosService" as svc
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "usuario" as uent
participant "log_auditoria" as aent

user -> view : Ingresa datos con\nformato incorrecto
activate view

view -> guard : PATCH /usuario/:id\n{ campos con formato inválido }
activate guard

guard -> guard : Verifica JWT y rol\n(ADMIN o SUPERUSUARIO)
activate guard
deactivate guard

guard -> ctrl : Solicitud autorizada
deactivate guard
activate ctrl

ctrl --> view : 400 Bad Request\nValidationPipe: errores de formato
deactivate ctrl

view --> user : Muestra errores\nde validación en el formulario
deactivate view

@enduml
