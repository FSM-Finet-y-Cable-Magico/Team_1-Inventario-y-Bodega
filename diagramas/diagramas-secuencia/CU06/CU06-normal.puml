@startuml CU06-normal
title CU-06 — Editando cuenta de usuario (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    Margin 35
  }
  actor {
    Margin 15
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador" as user
participant "V_EditarUsuario" as view
participant "C_RolesGuard" as guard
participant "C_UsuariosController" as ctrl
participant "C_UsuariosService" as svc
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "usuario" as uent
participant "log_auditoria" as aent

user -> view : Modifica campos del usuario\ny confirma
activate view

view -> guard : PATCH /usuario/:id\n{ campos a modificar }
activate guard

guard -> guard : Verifica JWT y rol\n(ADMIN o SUPERUSUARIO)
activate guard
deactivate guard

guard -> ctrl : Solicitud autorizada
deactivate guard
activate ctrl

ctrl -> svc : update(id, updateUsuarioDto,\nreq.user.sub, req.user.roles)
activate svc

svc -> orm : findOneBy({ id_usuario: id })
activate orm

orm -> uent : SELECT usuario\nWHERE id_usuario = :id
activate uent
uent --> orm : Datos del usuario
deactivate uent

orm --> svc : Usuario encontrado
deactivate orm

svc -> orm : save({ ...usuario, ...updateUsuarioDto })
activate orm

orm -> uent : UPDATE usuario\nSET campos modificados\nWHERE id_usuario = :id
activate uent
uent --> orm : Usuario actualizado
deactivate uent

orm --> svc : usuarioActualizado
deactivate orm

svc -> aud : create({ id_usuario: actorId,\naccion: 'ACTUALIZAR',\nentidad_afectada: 'usuario',\nvalor_anterior, valor_nuevo })
activate aud

aud -> orm : save(log)
activate orm

orm -> aent : INSERT log_auditoria
activate aent
aent --> orm : Registrado
deactivate aent

orm --> aud : Log guardado
deactivate orm

aud --> svc : Auditoría registrada
deactivate aud

svc --> ctrl : usuarioActualizado
deactivate svc

ctrl --> view : 200 OK\n{ usuario actualizado }
deactivate ctrl

view --> user : Muestra datos\nactualizados del usuario
deactivate view

@enduml
