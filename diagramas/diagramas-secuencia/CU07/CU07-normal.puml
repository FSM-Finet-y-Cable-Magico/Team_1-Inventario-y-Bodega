@startuml CU07-normal
title CU-07 — Desactivando cuenta de usuario (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    Margin 35
  }
  actor {
    Margin 15
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_GestionUsuarios" as view
participant "C_RolesGuard" as guard
participant "C_UsuariosController" as ctrl
participant "C_UsuariosService" as svc
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "usuario" as uent
participant "log_auditoria" as aent

user -> view : Solicita desactivar\nusuario (id)
activate view

view -> guard : DELETE /usuario/:id\n[JWT token]
activate guard

guard --> view : Acceso autorizado\n(ADMIN o SUPERUSUARIO)
deactivate guard

view -> ctrl : DELETE /usuario/:id\n[req.user.sub]
activate ctrl

ctrl -> svc : remove(id, req.user.sub)
activate svc

svc -> orm : findOneBy({ id_usuario: id })
activate orm

orm -> uent : SELECT usuario\nWHERE id_usuario
activate uent
uent --> orm : Datos usuario
deactivate uent

orm --> svc : Usuario (encontrado)
deactivate orm

svc -> orm : update(id, { activo: false })
activate orm

orm -> uent : UPDATE usuario\nSET activo = false\nWHERE id_usuario
activate uent
uent --> orm : Actualizado
deactivate uent

orm --> svc : Resultado update
deactivate orm

svc -> aud : create({ id_usuario: actorId,\naccion: 'DESACTIVAR',\nentidad_afectada: 'usuario',\nvalor_anterior: { activo: true },\nvalor_nuevo: { activo: false } })
activate aud

aud -> orm : save(log)
activate orm

orm -> aent : INSERT log_auditoria
activate aent
aent --> orm : Registrado
deactivate aent

orm --> aud : Log guardado
deactivate orm

aud --> svc : Auditoría registrada
deactivate aud

svc --> ctrl : void
deactivate svc

ctrl --> view : 200 OK
deactivate ctrl

view --> user : Cuenta desactivada\nexitosamente
deactivate view

@enduml
