@startuml CU03-normal
title CU-03 — Bloqueando acceso a recursos no autorizados (flujo normal: acceso permitido)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 25
skinparam ActorPadding 20
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Recurso" as view
participant "C_RolesGuard" as guard
participant "C_RecursoController" as ctrl
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "log_auditoria" as aent

user -> view : Solicita acceso\nal recurso protegido
activate view

view -> guard : HTTP Request\n(JWT token + ruta)
activate guard

guard -> guard : canActivate():\nreflector.get('roles', handler)\nroles.some(role => user.roles.includes(role))
activate guard
deactivate guard

guard --> ctrl : true (rol autorizado)
deactivate guard

activate ctrl

ctrl -> aud : create({ accion: 'ACCESO',\nentidad_afectada: recurso,\nmetodo_http, id_usuario,\nid_empresa })
activate aud

aud -> orm : save(log)
activate orm

orm -> aent : INSERT log_auditoria
activate aent
aent --> orm : Registrado
deactivate aent

orm --> aud : Log guardado
deactivate orm

aud --> ctrl : Auditoría registrada
deactivate aud

ctrl --> view : 200 OK\n{ datos del recurso }
deactivate ctrl

view --> user : Muestra el recurso solicitado
deactivate view

@enduml
