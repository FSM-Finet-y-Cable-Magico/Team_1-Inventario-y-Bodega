@startuml CU03-exc-recurso-no-autorizado
title CU-03 — Bloqueando acceso a recursos no autorizados (excepción: recurso no autorizado)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Recurso" as view
participant "C_RolesGuard" as guard
participant "C_RecursoController" as ctrl
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "log_auditoria" as aent

user -> view : Solicita acceso a recurso\nno autorizado (manipulación\nde URL / parámetros / HTTP)
activate view

view -> guard : HTTP Request\n(JWT token + ruta)
activate guard

guard -> guard : canActivate():\nreflector.get('roles', handler)\nroles.some(role => user.roles.includes(role)) → false
activate guard
deactivate guard

guard -> aud : create({ accion: 'ACCESO_DENEGADO',\nentidad_afectada: recurso,\nmetodo_http, id_usuario,\nid_empresa, fecha_hora })
activate aud

aud -> orm : save(log)
activate orm

orm -> aent : INSERT log_auditoria
activate aent
aent --> orm : Registrado
deactivate aent

orm --> aud : Log guardado
deactivate orm

aud --> guard : Auditoría registrada
deactivate aud

guard --> view : throw ForbiddenException\n('No tiene permisos para\nacceder a esta sección.')
deactivate guard

view --> user : 403 Forbidden\n'No tiene permisos para\nacceder a esta sección.'
deactivate view

@enduml
