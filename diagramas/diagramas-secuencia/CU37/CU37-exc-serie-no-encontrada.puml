@startuml CU37-exc-serie-no-encontrada
title CU-37 — Consultar historial completo de estados de equipo (excepción: serie no encontrada)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_HistorialEquipo" as view
participant "C_RolesGuard" as guard
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_TypeORM" as orm
participant "historial_estado_equipo" as hist
participant "unidad_equipo" as uent

user -> view : Ingresa número de serie\nno registrado en el sistema
activate view

view -> guard : GET /unidades/:serialNumber/historial\n(JWT válido)
activate guard
guard --> view : Acceso autorizado
deactivate guard

view -> ctrl : verHistorialCompleto(serialNumber)
activate ctrl

ctrl -> svc : verHistorialEstados(serialNumber, id_empresa)
activate svc

svc -> orm : createQueryBuilder — SELECT historial\nINNER JOIN unidad_equipo\nWHERE numero_serie = :serial\nAND id_empresa = :idEmpresa
activate orm

orm -> hist : SELECT historial_estado_equipo\nJOIN unidad_equipo
activate hist
hist --> orm : (sin resultados)
deactivate hist

orm --> svc : historial[ ] vacío
deactivate orm

svc -> orm : findOne(unidad_equipo WHERE\nnumero_serie AND id_empresa)
activate orm

orm -> uent : SELECT unidad_equipo\nWHERE numero_serie AND id_empresa
activate uent
uent --> orm : (sin resultados)
deactivate uent

orm --> svc : null
deactivate orm

svc --> ctrl : throw NotFoundException\n('El número de serie [X] no corresponde\na ningún dispositivo registrado en su empresa.')
deactivate svc

ctrl --> view : 404 Not Found
deactivate ctrl

view --> user : Muestra "Número de serie no\nencontrado en el sistema"
deactivate view

@enduml
