@startuml CU37-normal
title CU-37 — Consultando historial completo de estados de equipo (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    Margin 35
  }
  actor {
    Margin 15
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_HistorialEquipo" as view
participant "C_RolesGuard" as guard
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_TypeORM" as orm
participant "historial_estado_equipo" as hist
participant "unidad_equipo" as uent

user -> view : Ingresa número de serie\ny solicita historial
activate view

view -> guard : GET /unidades/:serialNumber/historial\n(JWT válido)
activate guard
guard --> view : Acceso autorizado\n(ADMIN / SUPERUSUARIO / ADMIN_BODEGA)
deactivate guard

view -> ctrl : verHistorialCompleto(serialNumber)
activate ctrl

ctrl -> svc : verHistorialEstados(serialNumber, id_empresa)
activate svc

svc -> orm : createQueryBuilder — SELECT historial\nINNER JOIN unidad_equipo\nWHERE numero_serie = :serial\nAND id_empresa = :idEmpresa\nORDER BY fecha_hora DESC
activate orm

orm -> hist : SELECT historial_estado_equipo\nJOIN unidad_equipo
activate hist
hist --> orm : Lista de registros de historial
deactivate hist

orm --> svc : historial[ ]
deactivate orm

svc -> orm : findOne(unidad_equipo WHERE\nnumero_serie AND id_empresa)
activate orm

orm -> uent : SELECT unidad_equipo\nWHERE numero_serie AND id_empresa
activate uent
uent --> orm : Registro unidad (existe)
deactivate uent

orm --> svc : UnidadEquipo encontrada
deactivate orm

svc --> ctrl : { success, numero_serie,\ntotal_movimientos, historial_transiciones[ ] }
deactivate svc

ctrl --> view : 200 OK\n{ historial completo }
deactivate ctrl

view --> user : Muestra historial de\ntransiciones de estado
deactivate view

@enduml
