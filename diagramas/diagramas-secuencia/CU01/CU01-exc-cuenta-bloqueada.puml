@startuml CU01-exc-cuenta-bloqueada
title CU-01 — Iniciando sesión en el sistema (excepción: cuenta bloqueada)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    Margin 35
  }
  actor {
    Margin 15
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Login" as view
participant "C_AuthController" as ctrl
participant "C_AuthService" as svc
participant "C_AuditoriaService" as aud
participant "C_TypeORM" as orm
participant "usuario" as uent
participant "log_auditoria" as aent

user -> view : Ingresa credenciales\n(5.° intento fallido)
activate view

view -> ctrl : POST /auth/login\n{ nombre_usuario, password }
activate ctrl

ctrl -> svc : login(loginDto)
activate svc

svc -> orm : findOne(usuario por\nnombre_usuario, con roles)
activate orm

orm -> uent : SELECT usuario\nJOIN usuario_rol JOIN rol\nWHERE nombre_usuario
activate uent
uent --> orm : Datos usuario
deactivate uent

orm --> svc : Usuario (intentos_fallidos = 4)
deactivate orm

svc -> svc : Verifica password:\nbcrypt.compare(password,\npassword_hash)
activate svc
deactivate svc

svc -> orm : update(id_usuario,\n{ bloqueado_hasta: now+15min,\nintentos_fallidos: 0 })
activate orm

orm -> uent : UPDATE usuario SET\nbloqueado_hasta = now+15min,\nintentos_fallidos = 0
activate uent
uent --> orm : Actualizado
deactivate uent

orm --> svc : OK
deactivate orm

svc --> ctrl : throw UnauthorizedException\n('Cuenta bloqueada temporalmente.\nIntente nuevamente en 15 minutos.')
deactivate svc

ctrl --> view : 401 Unauthorized\n'Cuenta bloqueada temporalmente.\nIntente nuevamente en 15 minutos.'
deactivate ctrl

view --> user : Muestra "Cuenta bloqueada temporalmente.\nIntente nuevamente en 15 minutos."
deactivate view

@enduml
