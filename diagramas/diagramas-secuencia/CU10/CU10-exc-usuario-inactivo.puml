@startuml CU10-exc-usuario-inactivo
title CU-10 — Restableciendo contraseña de usuario (excepción: usuario inactivo o inexistente)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador" as user
participant "V_RestablecerPassword" as view
participant "C_AuthController" as ctrl
participant "C_AuthService" as svc
participant "C_TypeORM" as orm
participant "usuario" as uent

user -> view : Solicita restablecer\ncontraseña del usuario (id)
activate view

view -> ctrl : POST /auth/restablecer-password/:id\n(JWT + rol ADMIN o SUPERUSUARIO)
activate ctrl

ctrl -> svc : restablecerPassword(targetId, actorId)
activate svc

svc -> orm : findOne(usuario\npor id_usuario)
activate orm

orm -> uent : SELECT usuario\nWHERE id_usuario = :id
activate uent
uent --> orm : null o usuario inactivo
deactivate uent

orm --> svc : null / usuario con activo = false
deactivate orm

svc --> ctrl : throw NotFoundException\n('No es posible restablecer la contraseña\nde un usuario inactivo o inexistente.')
deactivate svc

ctrl --> view : 404 Not Found
deactivate ctrl

view --> user : Muestra "No es posible restablecer la contraseña\nde un usuario inactivo o inexistente."
deactivate view

@enduml