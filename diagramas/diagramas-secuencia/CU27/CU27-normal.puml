@startuml CU27-normal
title CU-27 — Desactivando tipo de equipo del catálogo (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    margin 25
  }
  actor {
    margin 20
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Catalogo" as view
participant "C_CatalogController" as ctrl
participant "C_CatalogService" as svc
participant "C_TypeORM" as orm
participant "tipo_equipo" as tent
participant "unidad_equipo" as uent

user -> view : Selecciona tipo de equipo\ny solicita desactivar
activate view

view -> ctrl : DELETE /catalogo/:id
activate ctrl

ctrl -> svc : desactivarTipo(id, id_empresa)
activate svc

svc -> svc : parseInt(id)
activate svc
deactivate svc

svc -> orm : findOne(id_tipo_equipo, id_empresa)
activate orm

orm -> tent : SELECT tipo_equipo\nWHERE id_tipo_equipo AND id_empresa
activate tent
tent --> orm : Registro tipo_equipo
deactivate tent

orm --> svc : tipo (encontrado)
deactivate orm

svc -> orm : count(unidad_equipo\nWHERE id_tipo_equipo)
activate orm

orm -> uent : SELECT COUNT(*) unidad_equipo\nWHERE id_tipo_equipo
activate uent
uent --> orm : totalUnidades = 0
deactivate uent

orm --> svc : 0
deactivate orm

svc -> svc : tipo.activo = false
activate svc
deactivate svc

svc -> orm : save(tipo)
activate orm

orm -> tent : UPDATE tipo_equipo\nSET activo = false
activate tent
tent --> orm : Actualizado
deactivate tent

orm --> svc : tipo actualizado
deactivate orm

svc --> ctrl : { success: true,\ntipoDesactivacion: 'ORDINARIA',\nmessage: '...' }
deactivate svc

ctrl --> view : 200 OK\n{ success: true,\ntipoDesactivacion: 'ORDINARIA' }
deactivate ctrl

view --> user : Tipo de equipo desactivado\ndel catálogo correctamente
deactivate view

@enduml
