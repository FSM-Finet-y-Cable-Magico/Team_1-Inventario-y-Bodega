@startuml CU27-exc-tiene-unidades
title CU-27 — Desactivando tipo de equipo del catálogo (excepción: tipo no encontrado)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Catalogo" as view
participant "C_CatalogController" as ctrl
participant "C_CatalogService" as svc
participant "C_TypeORM" as orm
participant "tipo_equipo" as tent
participant "unidad_equipo" as uent

user -> view : Selecciona tipo de equipo\ny solicita desactivar
activate view

view -> ctrl : DELETE /catalogo/:id
activate ctrl

ctrl -> svc : desactivarTipo(id, id_empresa)
activate svc

svc -> svc : parseInt(id)
activate svc
deactivate svc

svc -> orm : findOne(id_tipo_equipo, id_empresa)
activate orm

orm -> tent : SELECT tipo_equipo\nWHERE id_tipo_equipo AND id_empresa
activate tent
tent --> orm : (sin resultados)
deactivate tent

orm --> svc : null
deactivate orm

svc --> ctrl : throw NotFoundException\n('El tipo de equipo que intenta desactivar\nno existe o no pertenece a su empresa.')
deactivate svc

ctrl --> view : 404 Not Found
deactivate ctrl

view --> user : Muestra error:\n'El tipo de equipo que intenta desactivar\nno existe o no pertenece a su empresa.'
deactivate view

@enduml
