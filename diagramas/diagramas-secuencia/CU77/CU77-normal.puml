@startuml CU77-normal
title CU-77 — Consultando listado de equipos en revisión (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
<style>
sequenceDiagram {
  participant {
    padding 35
  }
  actor {
    padding 15
  }
}
</style>
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Administrador de bodega" as user
participant "V_EnRevision" as view
participant "C_RolesGuard" as guard
participant "C_UnitsController" as ctrl
participant "C_UnitsService" as svc
participant "C_TypeORM" as orm
participant "unidad_equipo" as uent
participant "historial_estado_equipo" as hent
participant "bodega" as bent

user -> view : Desde /unidades, elige\n"Equipos en revisión"
activate view

view -> guard : GET /unidades/en-revision
activate guard
guard --> view : Autorizado\n(ADMIN_BODEGA / ADMIN / SUPERUSUARIO)
deactivate guard

view -> ctrl : listarEnRevision(actor)
activate ctrl

ctrl -> svc : listarEnRevision(actor)
activate svc

svc -> svc : esSuperusuario =\nactor.roles.includes('SUPERUSUARIO')
activate svc
deactivate svc

svc -> orm : createQueryBuilder('unidad')\nWHERE estado = 'En revisión'\n[AND id_empresa = :idEmpresa si no es Superusuario]
activate orm
orm -> uent : SELECT unidad_equipo\nWHERE estado = 'En revisión' [AND id_empresa = :idEmpresa]
activate uent
uent --> orm : filas (unidades en revisión)
deactivate uent
orm --> svc : unidades
deactivate orm

svc -> orm : historyRepository.createQueryBuilder('historial')\n.distinctOn(['historial.id_unidad'])\nWHERE id_unidad IN (:...ids)\nAND estado_nuevo = 'En revisión'\nORDER BY id_unidad, fecha_hora DESC
activate orm
orm -> hent : SELECT DISTINCT ON (id_unidad) ...\nFROM historial_estado_equipo
activate hent
hent --> orm : última fecha de ingreso\na revisión por unidad
deactivate hent
orm --> svc : mapaIngreso
deactivate orm

svc -> orm : getRepository(Bodega).findBy\n(id_bodega IN idsBodegas)
activate orm
orm -> bent : SELECT bodega WHERE id_bodega IN (...)
activate bent
bent --> orm : nombres de bodega
deactivate bent
orm --> svc : mapaBodegas
deactivate orm

svc -> svc : por unidad: dias_en_revision =\nfloor((ahora - fecha_ingreso) / 1 día)\ndiagnostico_tecnico = unidad.diagnosticoTecnico
activate svc
deactivate svc

svc --> ctrl : 200 OK [ { id_unidad, numero_serie,\ntipo_equipo, empresa, bodega,\nfecha_ingreso_revision, dias_en_revision,\ndiagnostico_tecnico }, ... ]
deactivate svc

ctrl --> view : 200 OK
deactivate ctrl

view --> user : Tabla con las 7 columnas,\nordenable por cualquier cabecera;\nfilas con más de 30 días resaltadas en amarillo
deactivate view

@enduml
