@startuml CU23-normal
title CU-23 — Consultando transferencias inter-empresa (flujo normal)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 70
skinparam ActorPadding 30
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Transferencias" as view
participant "C_RolesGuard" as guard
participant "C_TransferenciasController" as ctrl
participant "C_TransferenciasService" as svc
participant "C_TypeORM" as orm
participant "transferencia_equipo" as tent
participant "movimiento_inventario" as ment

user -> view : Solicita lista de transferencias\n(con filtro de estado opcional)
activate view

view -> guard : GET /transferencias?estado=...
activate guard

guard --> view : Token JWT válido\n(rol ADMIN o SUPERUSUARIO)
deactivate guard

view -> ctrl : GET /transferencias?estado=...
activate ctrl

ctrl -> svc : consultarTransferencias({ estado }, user)
activate svc

svc -> orm : createQueryBuilder('t')\n.orderBy fecha_transferencia DESC\n— si ADMIN: WHERE empresa_origen = X\nOR empresa_destino = X
activate orm

orm -> tent : SELECT transferencia_equipo\nORDER BY fecha_transferencia DESC\n[con filtro de empresa si ADMIN]
activate tent
tent --> orm : Lista de transferencias
deactivate tent

orm --> svc : transferencias[]
deactivate orm

svc -> orm : find({ referencia_id: t.id_transferencia })\npor cada transferencia
activate orm

orm -> ment : SELECT movimiento_inventario\nWHERE referencia_id = id_transferencia
activate ment
ment --> orm : movimientos[]
deactivate ment

orm --> svc : movimientos[]
deactivate orm

svc -> svc : Aplica filtro estado en memoria\ny construye resultado[]
activate svc
deactivate svc

svc --> ctrl : resultado[] (lista de transferencias\ncon estado, unidades y observaciones)
deactivate svc

ctrl --> view : 200 OK\n[{ id_transferencia, empresa_origen,\nempresa_destino, fecha, estado,\nunidades, observaciones }, ...]
deactivate ctrl

view --> user : Muestra lista de transferencias
deactivate view

@enduml
