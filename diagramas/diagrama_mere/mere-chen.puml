@startchen
skinparam nodesep 8
skinparam ranksep 18
skinparam defaultFontSize 12
skinparam shadowing false

title Modelo Entidad-Relación Extendido (Chen) — Inventario y Bodega

' ---------------------------------------------------------------------------
' ENTIDADES
' ---------------------------------------------------------------------------
entity EMPRESA {
  id_empresa <<key>>
  nombre
  rut_empresa
  esquema_db
}

entity USUARIO {
  id_usuario <<key>>
  nombre_completo
  nombre_usuario
  email
  password_hash
  activo
  intentos_fallidos
  bloqueado_hasta
  debe_cambiar_password
  fecha_creacion
}

entity ROL {
  id_rol <<key>>
  nombre_rol
  descripcion
}

entity BODEGA {
  id_bodega <<key>>
  nombre
  direccion
  activa
}

entity TIPO_EQUIPO {
  id_tipo_equipo <<key>>
  nombre
  categoria
  marca
  modelo
  descripcion_tecnica
  unidad_medida
  garantia_dias
  requiere_serie_individual
  ficha_tecnica_pdf_url
  ficha_tecnica_nombre
  activo
}

entity UNIDAD_EQUIPO {
  id_unidad <<key>>
  numero_serie
  modelo
  estado
  fecha_adquisicion
  fecha_venc_garantia
  diagnostico_tecnico
  id_cliente_instalado
  id_tecnico_asignado
  numero_poste
  id_caja_nap
  mac_address
  proveedor
  observaciones
  ubicacion_fisica
}

entity HISTORIAL_ESTADO <<weak>> {
  id_historial <<key>>
  estado_anterior
  estado_nuevo
  motivo
  fecha_hora
}

entity TRANSFERENCIA {
  id_transferencia <<key>>
  fecha_transferencia
  observaciones
}

entity MOVIMIENTO_INV {
  id_movimiento <<key>>
  tipo_movimiento
  cantidad
  fecha
  referencia_id
}

entity LOG_AUDITORIA {
  id_log <<key>>
  accion
  entidad_afectada
  id_entidad_afectada
  valor_anterior
  valor_nuevo
  ip_origen
  fecha_hora
}

entity PROVEEDOR {
  id_proveedor <<key>>
  nombre_comercial
  rut
  nombre_contacto
  telefono
  email
  activa
  fecha_creacion
}

entity ORDEN_INGRESO {
  id_orden <<key>>
  correlativo
  numero_documento
  fecha_documento
  estado
  fecha_creacion
}

entity ORDEN_DETALLE <<weak>> {
  id_detalle <<key>>
  cantidad_esperada
  garantia_dias
  cantidad_recibida
}

entity SALIDA_BODEGA {
  id_salida <<key>>
  fecha_hora
}

entity SALIDA_DETALLE <<weak>> {
  id_detalle <<key>>
  cantidad
}

entity INV_TECNICO {
  id_inventario <<key>>
  cantidad
  fecha_actualizacion
}

' ---------------------------------------------------------------------------
' RELACIONES
' ---------------------------------------------------------------------------
relationship Emplea {
}
relationship Posee {
}
relationship Es_responsable {
}
relationship Cataloga {
}
relationship Registra {
}
relationship Tiene_rol {
  fecha_asignacion
}
relationship Clasifica {
}
relationship Almacena {
}
relationship Stock {
  cantidad_disponible
  umbral_minimo
}
relationship Tiene_historial <<identifying>> {
}
relationship Modifica {
}
relationship Transf_origen {
}
relationship Transf_destino {
}
relationship Transf_registra {
}
relationship Mov_ejecuta {
}
relationship Mov_tipo {
}
relationship Mov_unidad {
}
relationship Mov_bod_origen {
}
relationship Mov_bod_destino {
}
relationship Mov_emp_origen {
}
relationship Mov_emp_destino {
}
relationship Genera {
}

relationship Suministra {
}
relationship Emite {
}
relationship Recibe_OI {
}
relationship Registra_OI {
}
relationship Tiene_detalle_OI <<identifying>> {
}
relationship Detalla_tipo {
}
relationship Despacha {
}
relationship Recibe_salida {
}
relationship Tiene_detalle_salida <<identifying>> {
}
relationship Asigna_unidad {
}
relationship Asigna_consumible {
}
relationship Custodia {
}
relationship Saldo_tipo {
}

' ---------------------------------------------------------------------------
' CONEXIONES
' ---------------------------------------------------------------------------
EMPRESA -1- Emplea
Emplea -N- USUARIO

USUARIO -N- Tiene_rol
Tiene_rol -M- ROL

EMPRESA -1- Posee
Posee -N- BODEGA

USUARIO -1- Es_responsable
Es_responsable -N- BODEGA

EMPRESA -1- Cataloga
Cataloga -N- TIPO_EQUIPO

TIPO_EQUIPO -1- Clasifica
Clasifica -N- UNIDAD_EQUIPO

EMPRESA -1- Registra
Registra -N- UNIDAD_EQUIPO

BODEGA -1- Almacena
Almacena -N- UNIDAD_EQUIPO

TIPO_EQUIPO -N- Stock
Stock -M- BODEGA

UNIDAD_EQUIPO =1= Tiene_historial
Tiene_historial -N- HISTORIAL_ESTADO

USUARIO -1- Modifica
Modifica -N- HISTORIAL_ESTADO

EMPRESA -1- Transf_origen
Transf_origen -N- TRANSFERENCIA
EMPRESA -1- Transf_destino
Transf_destino -N- TRANSFERENCIA
USUARIO -1- Transf_registra
Transf_registra -N- TRANSFERENCIA

USUARIO -1- Mov_ejecuta
Mov_ejecuta -N- MOVIMIENTO_INV
TIPO_EQUIPO -1- Mov_tipo
Mov_tipo -N- MOVIMIENTO_INV
UNIDAD_EQUIPO -1- Mov_unidad
Mov_unidad -N- MOVIMIENTO_INV
BODEGA -1- Mov_bod_origen
Mov_bod_origen -N- MOVIMIENTO_INV
BODEGA -1- Mov_bod_destino
Mov_bod_destino -N- MOVIMIENTO_INV
EMPRESA -1- Mov_emp_origen
Mov_emp_origen -N- MOVIMIENTO_INV
EMPRESA -1- Mov_emp_destino
Mov_emp_destino -N- MOVIMIENTO_INV

USUARIO -1- Genera
Genera -N- LOG_AUDITORIA

PROVEEDOR -N- Suministra
Suministra -M- TIPO_EQUIPO

PROVEEDOR -1- Emite
Emite -N- ORDEN_INGRESO

BODEGA -1- Recibe_OI
Recibe_OI -N- ORDEN_INGRESO

USUARIO -1- Registra_OI
Registra_OI -N- ORDEN_INGRESO

ORDEN_INGRESO =1= Tiene_detalle_OI
Tiene_detalle_OI -N- ORDEN_DETALLE

TIPO_EQUIPO -1- Detalla_tipo
Detalla_tipo -N- ORDEN_DETALLE

BODEGA -1- Despacha
Despacha -N- SALIDA_BODEGA

USUARIO -1- Recibe_salida
Recibe_salida -N- SALIDA_BODEGA

SALIDA_BODEGA =1= Tiene_detalle_salida
Tiene_detalle_salida -N- SALIDA_DETALLE

UNIDAD_EQUIPO -1- Asigna_unidad
Asigna_unidad -N- SALIDA_DETALLE

TIPO_EQUIPO -1- Asigna_consumible
Asigna_consumible -N- SALIDA_DETALLE

USUARIO -1- Custodia
Custodia -N- INV_TECNICO

TIPO_EQUIPO -1- Saldo_tipo
Saldo_tipo -N- INV_TECNICO
@endchen
