@startuml diagrama-componentes
title Diagrama de componentes — Sistema de Gestión Integral de Inventario\nFinet & Cable Mágico Litoral — I1 / I2 / I3 — CU-01 a CU-96
skinparam monochrome true
skinparam shadowing false
skinparam componentStyle uml2
skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam linetype ortho
top to bottom direction
actor Usuario as user
package "Capa de presentación — SvelteKit" as pres {
 component "Vistas del sistema\nJornada, unidades, cierres, devolución\nReportes, alertas y campana [ampliaciones I3]" as vistas
 component "Cliente API /api\nSesión JWT" as client
 vistas --> client
}
package "Controladores — NestJS" {
 component "AlertasController\n/alertas" as AlertasController
 component "AppController" as AppController
 component "AuditoriaController\n/auditoria" as AuditoriaController
 component "AuthController\n/auth" as AuthController
 component "BajasController\n/bajas" as BajasController
 component "BodegasController\n/bodegas" as BodegasController
 component "CatalogController\n/catalogo" as CatalogController
 component "CierresReparacionController\n/cierres-reparacion" as CierresReparacionController
 component "CierresTrabajoController" as CierresTrabajoController
 component "CompaniesController\n/empresas" as CompaniesController
 component "DonacionesController\n/donaciones" as DonacionesController
 component "HealthController\n/health" as HealthController
 component "IntegracionesController\n/integraciones" as IntegracionesController
 component "NotificacionesController\n/notificaciones" as NotificacionesController
 component "OrdenesIngresoController\n/ordenes-ingreso" as OrdenesIngresoController
 component "PrestamosController\n/prestamos" as PrestamosController
 component "ProveedoresController\n/proveedores" as ProveedoresController
 component "ReportesController\n/reportes" as ReportesController
 component "RolesController\n/roles" as RolesController
 component "SalidasController\n/salidas" as SalidasController
 component "TecnicosController\n/salidas" as TecnicosController
 component "TransferenciasController\n/transferencias" as TransferenciasController
 component "UnitsController\n/unidades" as UnitsController
 component "UsuariosController\n/usuario" as UsuariosController
}
package "Servicios — NestJS" {
 component "AlertasService" as AlertasService
 component "AppService" as AppService
 component "AuditoriaService" as AuditoriaService
 component "AuthService" as AuthService
 component "BajasService" as BajasService
 component "BodegasService" as BodegasService
