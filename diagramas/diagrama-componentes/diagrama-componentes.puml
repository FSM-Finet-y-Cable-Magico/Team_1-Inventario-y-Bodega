 component "SalidasService" as SalidasService
 component "TransferenciasService" as TransferenciasService
 component "UnitsService" as UnitsService
 component "UsuariosService" as UsuariosService
}
package "Persistencia" {
 component "TypeORM\nRepository / DataSource" as orm
 database "PostgreSQL\n32 tablas: 12 I1 / 14 I2 / 6 I3" as db
 orm --> db
}
