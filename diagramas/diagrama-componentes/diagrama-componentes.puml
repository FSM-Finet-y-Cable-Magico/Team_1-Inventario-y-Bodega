@startuml diagrama-componentes
title Diagrama de componentes — Sistema de Gestión Integral de Inventario\nFinet & Cable Mágico Litoral — Incremento: CU-01 a CU-46

skinparam monochrome true
skinparam shadowing false
skinparam componentStyle uml2
skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam ArrowColor black
skinparam linetype ortho
top to bottom direction

actor "Usuario\n(Técnico de terreno / Admin. de bodega /\nAdministrador / Superusuario)" as user

package "Capa de Presentación — SPA SvelteKit" as pres {
  component "V_Login" as vlogin
  component "V_Dashboard" as vdash
  component "V_Usuarios" as vusers
  component "V_Auditoria" as vaudit
  component "V_Catalogo" as vcat
  component "V_Unidades" as vunits
  component "V_Transferencias" as vtransf
  component "V_Bodegas" as vbod
  component "Store de sesión\n(auth.ts)" as store
  component "C_ClienteAPI\n(client.ts)" as client

  vlogin --> client
  vdash --> client
  vusers --> client
  vaudit --> client
  vcat --> client
  vunits --> client
  vtransf --> client
  vbod --> client
  client -left-> store : token JWT
}

interface "API REST\nHTTP / JSON" as api

user --> pres
client --> api

package "Capa de Controladores — NestJS" as ctrls {
  component "Seguridad transversal\nValidationPipe · JwtAuthGuard\nC_RolesGuard (CU-02, CU-03)\nC_CompanyIsolationGuard (CU-17 a CU-19)" as sec

  component "C_AuthController\n/auth\nCU-01, 10, 11, 12" as cauth
  component "C_UsuariosController\n/usuario\nCU-04 a 07" as cusers
  component "C_RolesController\n/roles\n(soporte RBAC)" as croles
  component "C_AuditoriaController\n/auditoria\nCU-09" as caudit
  component "C_CompaniesController\n/empresas\nCU-13 a 16" as ccomp
  component "C_CatalogController\n/catalogo\nCU-24 a 31" as ccat
  component "C_UnitsController\n/unidades\nCU-32 a 40" as cunits
  component "C_TransferenciasController\n/transferencias\nCU-20 a 23" as ctransf
  component "C_BodegasController\n/bodegas\nCU-41 a 46" as cbod
}

api --> sec
sec --> cauth
sec --> cusers
sec --> croles
sec --> caudit
sec --> ccomp
sec --> ccat
sec --> cunits
sec --> ctransf
sec --> cbod

package "Capa de Servicios (lógica de negocio) — NestJS" as svcs {
  component "C_AuthService\nbcrypt · JwtService" as sauth
  component "C_UsuariosService" as susers
  component "C_RolesService" as sroles
  component "C_AuditoriaService\nCU-08 (registro de eventos)" as saudit
  component "C_CompaniesService" as scomp
  component "C_CatalogService" as scat
  component "C_UnitsService" as sunits
  component "C_TransferenciasService" as stransf
  component "C_BodegasService" as sbod
}

cauth --> sauth
cusers --> susers
croles --> sroles
caudit --> saudit
ccomp --> scomp
ccat --> scat
cunits --> sunits
ctransf --> stransf
cbod --> sbod

sauth ..> saudit : registra evento\nen auditoría
susers ..> saudit
sroles ..> saudit
scat ..> saudit
sunits ..> saudit
stransf ..> saudit
sbod ..> saudit

package "Capa de Persistencia" as pers {
  component "C_TypeORM\nRepository<T> · DataSource" as orm
}

sauth --> orm
susers --> orm
sroles --> orm
saudit --> orm
scomp --> orm
scat --> orm
sunits --> orm
stransf --> orm
sbod --> orm

database "PostgreSQL" as db {
  component "Entidades (tablas)\nusuario · usuario_rol · rol\nlog_auditoria · bodega · stock_consumible\ntipo_equipo · unidad_equipo · historial_estado_equipo\ntransferencia_equipo · movimiento_inventario" as tablas
}

orm --> tablas : SQL

@enduml
