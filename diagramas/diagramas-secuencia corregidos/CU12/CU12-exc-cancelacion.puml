@startuml CU12-exc-cancelacion
title CU-12 — Cerrando sesión del sistema (excepción: usuario cancela confirmación)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 25
skinparam ActorPadding 20
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Usuario" as user
participant "V_Dashboard" as view

user -> view : Solicita cerrar sesión
activate view

view --> user : Muestra confirmación\nde cierre de sesión
deactivate view

user -> view : Cancela la confirmación
activate view

view --> user : Permanece en el dashboard\ncon sesión activa
deactivate view

@enduml