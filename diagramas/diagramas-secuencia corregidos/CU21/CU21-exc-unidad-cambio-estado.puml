@startuml CU21-exc-unidad-cambio-estado
title CU-21 — Aprobando transferencia inter-empresa (excepción: unidad cambió de estado)

skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 25
skinparam ActorPadding 20
skinparam sequence {
  MessageAlign center
  LifeLineBorderColor black
}
hide footbox

actor "Superusuario" as user
participant "V_Transferencias" as view
participant "C_RolesGuard" as guard
participant "C_TransferenciasController" as ctrl
participant "C_TransferenciasService" as svc
participant "C_TypeORM" as orm
participant "movimiento_inventario" as mvent
participant "unidad_equipo" as uent

user -> view : Selecciona transferencia\npendiente y aprueba
activate view

view -> ctrl : PATCH /transferencias/:id/aprobar
activate ctrl

ctrl -> guard : Verifica rol SUPERUSUARIO
activate guard
guard --> ctrl : Acceso permitido
deactivate guard

ctrl -> svc : aprobarTransferencia(id, actor)
activate svc

svc -> orm : find(movimiento_inventario\ndonde referencia_id = id\ny tipo_movimiento = PENDIENTE)
activate orm
orm -> mvent : SELECT movimiento_inventario\nWHERE referencia_id = id\nAND tipo_movimiento = 'TRANSFERENCIA_PENDIENTE'
activate mvent
mvent --> orm : Lista de movimientos
deactivate mvent
orm --> svc : movimientos[]
deactivate orm

svc -> orm : findBy(unidad_equipo\ndonde id_unidad IN ids)
activate orm
orm -> uent : SELECT unidad_equipo\nWHERE id_unidad IN (ids)
activate uent
uent --> orm : Lista de unidades\n(una o más con estado ≠ 'En bodega')
deactivate uent
orm --> svc : unidades[]
deactivate orm

svc -> svc : Filtra unidades donde\nestado ≠ 'En bodega'\n→ unidadesInvalidas[]
activate svc
deactivate svc

svc --> ctrl : throw BadRequestException\n('Las siguientes unidades cambiaron de estado\ndesde que se registró la solicitud:\n<serial> (<estado>). Corríjalas antes de aprobar.')
deactivate svc

ctrl --> view : 400 Bad Request\n{ message: 'Las siguientes unidades cambiaron...' }
deactivate ctrl

view --> user : Muestra error:\n"Unidades no disponibles para transferir"
deactivate view

@enduml