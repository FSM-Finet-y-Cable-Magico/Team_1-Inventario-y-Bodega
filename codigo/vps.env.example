# ============================================================
#  Variables para la VPS. En la VPS:  cp vps.env.example .env
#  y reemplazar cada CAMBIAR. El archivo .env NO se sube al repo
#  (está en .gitignore). Nunca pongas valores reales aquí.
# ============================================================

# --- PostgreSQL (lo crea el contenedor "db" en el primer arranque)
POSTGRES_USER=inventario
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=inventario

# --- Firma de los tokens de sesión (cadena larga y aleatoria)
#     Generar con:  openssl rand -hex 32
JWT_SECRET=CAMBIAR

# --- Puerto publicado en la VPS (rango del grupo 1: 8100-8199)
APP_PORT=8100

# --- Integraciones con otros grupos (opcionales)
# Keys que otros grupos usan para llamarnos (X-API-KEY), en JSON:
# INTEGRACION_API_KEYS='[{"key":"CAMBIAR","grupo":"G3","empresas":[1,2]}]'
INTEGRACION_API_KEYS=[]
# CU-48: API de G3 para enriquecer la ficha del cliente por RUT
G3_INTEGRACION_URL=
G3_INTEGRACION_API_KEY=
G3_TIMEOUT_MS=

# --- CU-93: límite de la exportación a PDF en ms (vacío = 15000)
EXPORT_PDF_TIMEOUT_MS=
